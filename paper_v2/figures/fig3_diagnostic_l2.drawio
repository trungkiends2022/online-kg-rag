    <mxCell id="t_ret" value="&lt;b&gt;Targeted Evidence Retrieval (Controller)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#5b2c6f;" vertex="1" parent="1">
