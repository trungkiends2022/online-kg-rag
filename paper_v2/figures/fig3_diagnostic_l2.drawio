    <!-- Titlebar L2 -->
    <mxCell id="t_l2" value="&lt;b&gt;Tier 2: L2 Grounded Resolution&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#008080;fontSize=13;fontColor=#0e6655;" vertex="1" parent="1">
      <mxGeometry x="925" y="45" width="360" height="35" as="geometry" />
    </mxCell>
    <!-- Box L2 Capsule -->
    <mxCell id="b_l2_capsule" value="&lt;b&gt;Minimal Sufficient State Capsule (K_L2)&lt;/b&gt;&lt;br&gt;&lt;hr style='border-top: 1px solid #008080;'&gt;&lt;div style='text-align: left; font-size: 9.5px;'&gt;&lt;pre style='background:#f4fbf7; padding:4px; font-family:Courier New; margin:2px 0;'&gt;{ &quot;question&quot;: &quot;city with club formed in 1989&quot;,&#xa;  &quot;unresolved&quot;: &quot;needed_check: town name&quot;,&#xa;  &quot;focus_bindings&quot;: [&#xa;    {&quot;rec&quot;: &quot;ρ0&quot;, &quot;club&quot;: &quot;Eagles&quot;, &quot;yr&quot;: 1989},&#xa;    {&quot;rec&quot;: &quot;ρ1&quot;, &quot;club&quot;: &quot;Tigers&quot;, &quot;yr&quot;: 1991}&#xa;  ],&#xa;  &quot;delta_evidence&quot;: [&#xa;    {&quot;target&quot;: &quot;ρ0&quot;, &quot;doc&quot;: &quot;town of York (1793)&quot;},&#xa;    {&quot;target&quot;: &quot;ρ1&quot;, &quot;doc&quot;: &quot;founded in 1816&quot;}&#xa;  ] }&lt;/pre&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#008080;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="925" y="95" width="360" height="135" as="geometry" />
    </mxCell>
    <!-- Box L2 Resolution -->
    <mxCell id="b_l2_res" value="&lt;b&gt;Factual Grounded Resolution (T=0)&lt;/b&gt;&lt;br&gt;&lt;hr style='border-top: 1px solid #27ae60;'&gt;&lt;div style='text-align: left; font-size: 11px; line-height: 1.4;'&gt;• Evaluates grounded delta facts in state capsule K_L2&lt;br&gt;• Resolves candidate ties purely factually (no heuristics)&lt;br&gt;• &lt;b&gt;Verified Output Answer:&lt;/b&gt; &lt;span style='background:#d5e8d4; color:#274e13; padding:2px 6px; font-weight:bold; border-radius:3px;'&gt;&quot;York&quot;&lt;/span&gt;&lt;br&gt;• Verifiable provenance chain from cell to passage&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="925" y="275" width="360" height="115" as="geometry" />
    </mxCell>

    <!-- Intra-L2 Arrow -->
    <mxCell id="e_l2_1" value="&lt;span style='background-color:#fff; padding:2px;'&gt;L2 reader call&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#0e6655;strokeWidth=1.5;fontColor=#0e6655;fontSize=10;" edge="1" source="b_l2_capsule" target="b_l2_res" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ==================== INTER-COLUMN CONNECTIONS ==================== -->
    <!-- Connection 1: L1 Diag to Retrieval Sym -->
    <mxCell id="e_cross_1" value="&lt;b&gt;Diagnostic Handoff&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b45f06;strokeWidth=2;fontColor=#b45f06;fontSize=11;" edge="1" source="b_l1_diag" target="b_ret_sym" parent="1">
