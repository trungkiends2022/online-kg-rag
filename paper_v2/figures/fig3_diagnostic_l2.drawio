<mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="710" background="#ffffff">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="in" value="&lt;b&gt;Input to L1&lt;/b&gt;&lt;br&gt;X*(G&lt;sub&gt;q&lt;/sub&gt;): compact multigraph, nothing pruned&lt;br&gt;+ guide path p&lt;sub&gt;1&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf5fb;strokeColor=#2980b9;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="200" height="120" as="geometry" /></mxCell>
    <mxCell id="l1" value="&lt;b&gt;Tier 1 · L1 Reader&lt;/b&gt;&lt;br&gt;&lt;b&gt;LLM call 1&lt;/b&gt;&lt;br&gt;self-audit: answer only if determined, never guess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d35400;strokeWidth=3;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="210" height="120" as="geometry" /></mxCell>
    <mxCell id="dc" value="&lt;b&gt;|C&lt;sub&gt;q&lt;/sub&gt;| = 1&lt;br&gt;and p&lt;sub&gt;1&lt;/sub&gt; unbroken?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="235" width="190" height="150" as="geometry" /></mxCell>
    <mxCell id="fast" value="&lt;b&gt;Fast exit&lt;/b&gt;&lt;br&gt;FINAL_ANSWER: a*&lt;br&gt;1 LLM call in total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="250" height="110" as="geometry" /></mxCell>
    <mxCell id="note" value="Escalation, only when L1 finds |C&lt;sub&gt;q&lt;/sub&gt;| &amp;gt; 1 or a missing bridge link. Illustration: anchoring leaves ρ0 and ρ1 tied." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=2;fontColor=#b45f06;" vertex="1" parent="1"><mxGeometry x="760" y="402" width="715" height="40" as="geometry" /></mxCell>
    <mxCell id="diag" value="&lt;b&gt;Diagnostic handoff&lt;/b&gt;&lt;br&gt;H&lt;sub&gt;diag&lt;/sub&gt; = (C&lt;sub&gt;focus&lt;/sub&gt;, β, ψ&lt;sub&gt;check&lt;/sub&gt;)&lt;br&gt;C&lt;sub&gt;focus&lt;/sub&gt; = {ρ0, ρ1}&lt;br&gt;β = collision&lt;br&gt;ψ&lt;sub&gt;check&lt;/sub&gt; = original city name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="450" width="220" height="170" as="geometry" /></mxCell>
    <mxCell id="ret" value="&lt;b&gt;Targeted retrieval R&lt;sub&gt;target&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;controller, no LLM&lt;br&gt;ΔD = ∪ ℓ(c) \ D&lt;sub&gt;current&lt;/sub&gt;, c ∈ C&lt;sub&gt;focus&lt;/sub&gt;&lt;br&gt;≤ k&lt;sub&gt;focus&lt;/sub&gt; passages per candidate (symmetric)&lt;br&gt;&lt;i&gt;ρ0: Doc:Toronto “town of York”&lt;br&gt;ρ1: Doc:Hamilton “founded in 1816”&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="450" width="230" height="170" as="geometry" /></mxCell>
    <mxCell id="cap" value="&lt;b&gt;State capsule K&lt;sub&gt;L2&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;(q, ψ&lt;sub&gt;check&lt;/sub&gt;, {G*(ρ&lt;sub&gt;c&lt;/sub&gt;)}, ΔD)&lt;br&gt;built by the controller, no LLM&lt;br&gt;minimal and sufficient (Prop. 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#008080;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1035" y="450" width="200" height="170" as="geometry" /></mxCell>
    <mxCell id="l2" value="&lt;b&gt;Tier 2 · L2 Reader&lt;/b&gt;&lt;br&gt;&lt;b&gt;LLM call 2&lt;/b&gt;&lt;br&gt;a* = argmax P(a | K&lt;sub&gt;L2&lt;/sub&gt;)&lt;br&gt;decides from grounded evidence, no tie-break guessing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d35400;strokeWidth=3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="450" width="200" height="170" as="geometry" /></mxCell>
    <mxCell id="out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;span style='background:#d4efdf;color:#145a32;font-weight:bold;font-size:16px;padding:2px 12px'&gt;York&lt;/span&gt;&lt;br&gt;provenance π(a*):&lt;br&gt;row 0 → Toronto → Doc:Toronto → York" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#27ae60;strokeWidth=3;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1265" y="235" width="210" height="150" as="geometry" /></mxCell>
