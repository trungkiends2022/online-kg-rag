{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/pipeline.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
