# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Env / secrets
.env
*.key

# Data (thường nặng, không commit; dùng README hướng dẫn tải lại)
data/*
!data/.gitkeep
# Keep completed, reproducible HybridQA benchmark artifacts under version
# control. Large JSONL predictions are managed by Git LFS (see .gitattributes).
!data/results/
data/results/*
!data/results/hybridqa_oueg_vs_direct_shard*_gpt_oss_*_reasoning_full/
!data/results/hybridqa_oueg_vs_direct_shard*_gpt_oss_*_reasoning_full/**

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/

# OS
.DS_Store

# Scratch / temporary run outputs
scratch/

# Notebook checkpoints
.ipynb_checkpoints/
logs/
