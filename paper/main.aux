\citation{chen2024tablerag,yu2025tablerag}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architectural comparison across four knowledge graph construction and reasoning paradigms for hybrid table-text retrieval. In contrast to offline STI cascades\nobreakspace  {}(a), hallucination-prone zero-shot LLM extraction\nobreakspace  {}(b), and destructive top-$k$ path pruning in persistent GraphRAG systems\nobreakspace  {}(c), the proposed OUEG-RAG framework\nobreakspace  {}(d) dynamically instantiates a schema-preserving multigraph on-the-fly without LLM calls, achieves lossless subgraph prompt encoding preserving all retrieved context, and guides single-turn reasoning via candidate path routing.}}{4}\protected@file@percent }
\newlabel{fig:paradigms}{{1}{4}}
\@writefile{toc}{\contentsline {paragraph}{Table Reasoning with Large Language Models.}{4}\protected@file@percent }
