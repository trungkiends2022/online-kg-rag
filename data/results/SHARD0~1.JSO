_answer_path_selection": false, "verification_by_path": {"grounded_945": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7273, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 29.9274}, "grounded_844": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5455, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 29.4568}, "row_0_1": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5455, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 28.4568}, "grounded_1012": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7727, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 27.5451}, "grounded_1171": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7727, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 27.5451}}}, "reasoning_paths": [{"path_id": "grounded_945", "score": 22.9274, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.2941, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Ninja_Tune", "Ninja Tune", "table:List of video game soundtracks released on vinyl:row:0", "2011"], "edges": [{"edge_id": "record:315", "head": "Ninja Tune", "relation": "linked_passage", "tail": "passage:/wiki/Ninja_Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Label", "header_path": ["Label"], "structural": true, "contexts": [{"source_id": "/wiki/Ninja_Tune", "text": "Ninja Tune is an English independent record label based in London . It has a satellite office in Los Angeles . It was founded by Matt Black and Jonathan More , better known as Coldcut and managed by Peter Quicke and others . Inspired by a visit to Japan , Black and More primarily created Ninja Tune in 1990 as a means to escape the creative control of major labels , and to act as a vehicle to release music of a more underground nature , [ full citation needed ] free from the restraints that were put on them via their brief stints with Arista and Big Life . The label has been called visionary and reliably excellent . It has signed a diverse range of artists , and has created its own publishing company , Just Is n't Music , and finds innovative uses of software . The label 's first releases - the first five volumes of DJ Food 's Jazz Brakes - were produced by Coldcut in the early 1990s , and celebrated by the music press and beat aficionados . They were composed of instrumental sample-based cuts that led the duo to help pioneer new instrumental hip hop beats genres ( alongside the Mo'Wax label and Ninja Tune artists such as Funki Porcini , The Herbaliser and DJ Vadim ) and , to this day , are recognized as being indispensable tools for DJs . The label has since released music of myriad artists ( including The Cinematic Orchestra , Amon Tobin , Bonobo , Kelis , BICEP , The Bug , Machinedrum , Lee Bannon , Wiley ) and distributes other record labels - including Big Dada , Brainfeeder ( Flying Lotus ' label ) and Technicolour Records .", "context_before": ""}], "traversal_from": "passage:/wiki/Ninja_Tune", "traversal_to": "Ninja Tune", "direction": "reverse"}, {"edge_id": "record:12", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "label", "tail": "Ninja Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Label", "header_path": ["Label"], "structural": true, "traversal_from": "Ninja Tune", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0", "direction": "reverse"}, {"edge_id": "record:0", "head": "2011", "relation": "has_record", "tail": "table:List of video game soundtracks released on vinyl:row:0", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Rel", "header_path": ["Rel"], "structural": true, "traversal_from": "table:List of video game soundtracks released on vinyl:row:0", "traversal_to": "2011", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Ninja Tune --linked_passage--> passage:/wiki/Ninja_Tune [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of video game soundtracks released on vinyl:row:0 --label--> Ninja Tune [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "2011 --has_record--> table:List of video game soundtracks released on vinyl:row:0 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7273, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 29.9274}}, {"path_id": "grounded_844", "score": 22.4568, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 0.8235, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": -1.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "Tom Clancy 's Splinter Cell 3D", "table:List of video game soundtracks released on vinyl:row:0", "2011"], "edges": [{"edge_id": "record:313", "head": "Tom Clancy 's Splinter Cell 3D", "relation": "linked_passage", "tail": "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Game Title", "header_path": ["Game Title"], "structural": true, "contexts": [{"source_id": "/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "text": "Tom Clancy 's Splinter Cell : Chaos Theory is a stealth game developed by Ubisoft Montreal and Ubisoft Milan and released in March 2005 for the Xbox , PlayStation 2 ( PS2 ) , GameCube and Microsoft Windows . Handheld versions for the Nintendo DS , mobile , and N-Gage were also released . A Game Boy Advance port was planned , but later cancelled . Chaos Theory is the third game in the Splinter Cell series endorsed by novelist Tom Clancy . As with previous entries in the franchise , Chaos Theory follows the activities of Sam Fisher , an agent working for a covert-ops branch within the NSA called Third Echelon . The game has a significantly darker tone than its predecessors , featuring more combat and the option for Fisher to kill people he interrogates as opposed to merely knocking them out . As a result , it was the first Splinter Cell game to receive an M-rating by the ESRB , an assessment which has since been applied to all subsequent releases in the series . Actor Michael Ironside reprised his role as Fisher , while Don Jordan returned from the original game to voice Third Echelon director Irving Lambert and Claudia Besso returned as hacker and analyst Anna Grímsdóttir having both been replaced by Dennis Haysbert and Adriana Anderson respectively in Tom Clancy 's Splinter Cell : Pandora Tomorrow . Chaos Theory was a commercial success , selling 2.5 million units across all platforms within a month of its release . The Xbox and PC versions of the game received critical acclaim ; the GameCube and PlayStation 2 iterations were also released to generally positive reviews . Official Xbox Magazine named it the Xbox Game of the Year ( 2005 ) for its strong gameplay and lifelike graphics . It is considered one of the greatest video games of all time .", "context_before": ""}], "traversal_from": "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "traversal_to": "Tom Clancy 's Splinter Cell 3D", "direction": "reverse"}, {"edge_id": "record:8", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "game_title", "tail": "Tom Clancy 's Splinter Cell 3D", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Game Title", "header_path": ["Game Title"], "structural": true, "traversal_from": "Tom Clancy 's Splinter Cell 3D", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0", "direction": "reverse"}, {"edge_id": "record:0", "head": "2011", "relation": "has_record", "tail": "table:List of video game soundtracks released on vinyl:row:0", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Rel", "header_path": ["Rel"], "structural": true, "traversal_from": "table:List of video game soundtracks released on vinyl:row:0", "traversal_to": "2011", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Tom Clancy 's Splinter Cell 3D --linked_passage--> passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of video game soundtracks released on vinyl:row:0 --game_title--> Tom Clancy 's Splinter Cell 3D [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "2011 --has_record--> table:List of video game soundtracks released on vinyl:row:0 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5455, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 29.4568}}, {"path_id": "row_0_1", "score": 22.4568, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 0.8235, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": -1.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["2011", "table:List of video game soundtracks released on vinyl:row:0", "Tom Clancy 's Splinter Cell 3D", "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory"], "edges": [{"edge_id": "record:0", "head": "2011", "relation": "has_record", "tail": "table:List of video game soundtracks released on vinyl:row:0", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Rel", "header_path": ["Rel"], "structural": true, "traversal_from": "2011", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0", "direction": "forward"}, {"edge_id": "record:8", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "game_title", "tail": "Tom Clancy 's Splinter Cell 3D", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Game Title", "header_path": ["Game Title"], "structural": true, "traversal_from": "table:List of video game soundtracks released on vinyl:row:0", "traversal_to": "Tom Clancy 's Splinter Cell 3D", "direction": "forward"}, {"edge_id": "record:313", "head": "Tom Clancy 's Splinter Cell 3D", "relation": "linked_passage", "tail": "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Game Title", "header_path": ["Game Title"], "structural": true, "contexts": [{"source_id": "/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "text": "Tom Clancy 's Splinter Cell : Chaos Theory is a stealth game developed by Ubisoft Montreal and Ubisoft Milan and released in March 2005 for the Xbox , PlayStation 2 ( PS2 ) , GameCube and Microsoft Windows . Handheld versions for the Nintendo DS , mobile , and N-Gage were also released . A Game Boy Advance port was planned , but later cancelled . Chaos Theory is the third game in the Splinter Cell series endorsed by novelist Tom Clancy . As with previous entries in the franchise , Chaos Theory follows the activities of Sam Fisher , an agent working for a covert-ops branch within the NSA called Third Echelon . The game has a significantly darker tone than its predecessors , featuring more combat and the option for Fisher to kill people he interrogates as opposed to merely knocking them out . As a result , it was the first Splinter Cell game to receive an M-rating by the ESRB , an assessment which has since been applied to all subsequent releases in the series . Actor Michael Ironside reprised his role as Fisher , while Don Jordan returned from the original game to voice Third Echelon director Irving Lambert and Claudia Besso returned as hacker and analyst Anna Grímsdóttir having both been replaced by Dennis Haysbert and Adriana Anderson respectively in Tom Clancy 's Splinter Cell : Pandora Tomorrow . Chaos Theory was a commercial success , selling 2.5 million units across all platforms within a month of its release . The Xbox and PC versions of the game received critical acclaim ; the GameCube and PlayStation 2 iterations were also released to generally positive reviews . Official Xbox Magazine named it the Xbox Game of the Year ( 2005 ) for its strong gameplay and lifelike graphics . It is considered one of the greatest video games of all time .", "context_before": ""}], "traversal_from": "Tom Clancy 's Splinter Cell 3D", "traversal_to": "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "direction": "forward"}], "steps": [{"step": 1, "goal": "2011 --has_record--> table:List of video game soundtracks released on vinyl:row:0", "depends_on": null}, {"step": 2, "goal": "table:List of video game soundtracks released on vinyl:row:0 --game_title--> Tom Clancy 's Splinter Cell 3D", "depends_on": 1}, {"step": 3, "goal": "Tom Clancy 's Splinter Cell 3D --linked_passage--> passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5455, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 28.4568}}, {"path_id": "grounded_1012", "score": 21.5451, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.4118, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Ninja_Tune", "Ninja Tune", "table:List of video game soundtracks released on vinyl:row:0", "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title"], "edges": [{"edge_id": "record:364", "head": "Ninja Tune", "relation": "linked_passage", "tail": "passage:/wiki/Ninja_Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 19, "column_name": "Label", "header_path": ["Label"], "structural": true, "contexts": [{"source_id": "/wiki/Ninja_Tune", "text": "Ninja Tune is an English independent record label based in London . It has a satellite office in Los Angeles . It was founded by Matt Black and Jonathan More , better known as Coldcut and managed by Peter Quicke and others . Inspired by a visit to Japan , Black and More primarily created Ninja Tune in 1990 as a means to escape the creative control of major labels , and to act as a vehicle to release music of a more underground nature , [ full citation needed ] free from the restraints that were put on them via their brief stints with Arista and Big Life . The label has been called visionary and reliably excellent . It has signed a diverse range of artists , and has created its own publishing company , Just Is n't Music , and finds innovative uses of software . The label 's first releases - the first five volumes of DJ Food 's Jazz Brakes - were produced by Coldcut in the early 1990s , and celebrated by the music press and beat aficionados . They were composed of instrumental sample-based cuts that led the duo to help pioneer new instrumental hip hop beats genres ( alongside the Mo'Wax label and Ninja Tune artists such as Funki Porcini , The Herbaliser and DJ Vadim ) and , to this day , are recognized as being indispensable tools for DJs . The label has since released music of myriad artists ( including The Cinematic Orchestra , Amon Tobin , Bonobo , Kelis , BICEP , The Bug , Machinedrum , Lee Bannon , Wiley ) and distributes other record labels - including Big Dada , Brainfeeder ( Flying Lotus ' label ) and Technicolour Records .", "context_before": ""}], "traversal_from": "passage:/wiki/Ninja_Tune", "traversal_to": "Ninja Tune", "direction": "reverse"}, {"edge_id": "record:12", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "label", "tail": "Ninja Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Label", "header_path": ["Label"], "structural": true, "traversal_from": "Ninja Tune", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0", "direction": "reverse"}, {"edge_id": "record:3", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "ost_title", "tail": "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "OST Title", "header_path": ["OST Title"], "structural": true, "cell_node": true, "cell_value": "Chaos Theory Remixed ( The Soundtrack To Splinter Cell 3D )", "traversal_from": "table:List of video game soundtracks released on vinyl:row:0", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "direction": "forward"}], "steps": [{"step": 1, "goal": "Ninja Tune --linked_passage--> passage:/wiki/Ninja_Tune [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of video game soundtracks released on vinyl:row:0 --label--> Ninja Tune [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:List of video game soundtracks released on vinyl:row:0 --ost_title--> table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7727, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 27.5451}}, {"path_id": "grounded_1171", "score": 21.5451, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.4118, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["/wiki/Ninja_Tune", "Ninja Tune", "table:List of video game soundtracks released on vinyl:row:0", "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title"], "edges": [{"edge_id": "semantic:21:0", "head": "Ninja Tune", "relation": "linked_passage", "tail": "/wiki/Ninja_Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "source_group": null, "row_index": 0, "column_name": "Label", "header_path": ["Label"], "structural": false, "contexts": [{"source_id": "/wiki/Ninja_Tune", "text": "Ninja Tune is an English independent record label based in London . It has a satellite office in Los Angeles . It was founded by Matt Black and Jonathan More , better known as Coldcut and managed by Peter Quicke and others . Inspired by a visit to Japan , Black and More primarily created Ninja Tune in 1990 as a means to escape the creative control of major labels , and to act as a vehicle to release music of a more underground nature , [ full citation needed ] free from the restraints that were put on them via their brief stints with Arista and Big Life . The label has been called visionary and reliably excellent . It has signed a diverse range of artists , and has created its own publishing company , Just Is n't Music , and finds innovative uses of software . The label 's first releases - the first five volumes of DJ Food 's Jazz Brakes - were produced by Coldcut in the early 1990s , and celebrated by the music press and beat aficionados . They were composed of instrumental sample-based cuts that led the duo to help pioneer new instrumental hip hop beats genres ( alongside the Mo'Wax label and Ninja Tune artists such as Funki Porcini , The Herbaliser and DJ Vadim ) and , to this day , are recognized as being indispensable tools for DJs . The label has since released music of myriad artists ( including The Cinematic Orchestra , Amon Tobin , Bonobo , Kelis , BICEP , The Bug , Machinedrum , Lee Bannon , Wiley ) and distributes other record labels - including Big Dada , Brainfeeder ( Flying Lotus ' label ) and Technicolour Records .", "context_before": ""}], "traversal_from": "/wiki/Ninja_Tune", "traversal_to": "Ninja Tune", "direction": "reverse"}, {"edge_id": "record:12", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "label", "tail": "Ninja Tune", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Label", "header_path": ["Label"], "structural": true, "traversal_from": "Ninja Tune", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0", "direction": "reverse"}, {"edge_id": "record:3", "head": "table:List of video game soundtracks released on vinyl:row:0", "relation": "ost_title", "tail": "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "OST Title", "header_path": ["OST Title"], "structural": true, "cell_node": true, "cell_value": "Chaos Theory Remixed ( The Soundtrack To Splinter Cell 3D )", "traversal_from": "table:List of video game soundtracks released on vinyl:row:0", "traversal_to": "table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "direction": "forward"}], "steps": [{"step": 1, "goal": "Ninja Tune --linked_passage--> /wiki/Ninja_Tune [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of video game soundtracks released on vinyl:row:0 --label--> Ninja Tune [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:List of video game soundtracks released on vinyl:row:0 --ost_title--> table:List of video game soundtracks released on vinyl:row:0:cell:OST Title", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7727, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 27.5451}}, {"path_id": "answer_evidence_record_314", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Tom Clancy's Splinter Cell: Chaos Theory", "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory"], "edges": [{"edge_id": "record:314", "head": "Tom Clancy's Splinter Cell: Chaos Theory", "relation": "linked_passage", "tail": "passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 0, "column_name": "Game Title", "header_path": ["Game Title"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "text": "Tom Clancy 's Splinter Cell : Chaos Theory is a stealth game developed by Ubisoft Montreal and Ubisoft Milan and released in March 2005 for the Xbox , PlayStation 2 ( PS2 ) , GameCube and Microsoft Windows . Handheld versions for the Nintendo DS , mobile , and N-Gage were also released . A Game Boy Advance port was planned , but later cancelled . Chaos Theory is the third game in the Splinter Cell series endorsed by novelist Tom Clancy . As with previous entries in the franchise , Chaos Theory follows the activities of Sam Fisher , an agent working for a covert-ops branch within the NSA called Third Echelon . The game has a significantly darker tone than its predecessors , featuring more combat and the option for Fisher to kill people he interrogates as opposed to merely knocking them out . As a result , it was the first Splinter Cell game to receive an M-rating by the ESRB , an assessment which has since been applied to all subsequent releases in the series . Actor Michael Ironside reprised his role as Fisher , while Don Jordan returned from the original game to voice Third Echelon director Irving Lambert and Claudia Besso returned as hacker and analyst Anna Grímsdóttir having both been replaced by Dennis Haysbert and Adriana Anderson respectively in Tom Clancy 's Splinter Cell : Pandora Tomorrow . Chaos Theory was a commercial success , selling 2.5 million units across all platforms within a month of its release . The Xbox and PC versions of the game received critical acclaim ; the GameCube and PlayStation 2 iterations were also released to generally positive reviews . Official Xbox Magazine named it the Xbox Game of the Year ( 2005 ) for its strong gameplay and lifelike graphics . It is considered one of the greatest video games of all time .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Tom Clancy's Splinter Cell: Chaos Theory --linked_passage--> passage:/wiki/Tom_Clancy's_Splinter_Cell:_Chaos_Theory", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_351", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["The Music of Grand Theft Auto V : Limited Edition LP Collection", "passage:/wiki/The_Music_of_Grand_Theft_Auto_V"], "edges": [{"edge_id": "record:351", "head": "The Music of Grand Theft Auto V : Limited Edition LP Collection", "relation": "linked_passage", "tail": "passage:/wiki/The_Music_of_Grand_Theft_Auto_V", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 16, "column_name": "OST Title", "header_path": ["OST Title"], "structural": true, "contexts": [{"source_id": "/wiki/The_Music_of_Grand_Theft_Auto_V", "text": "The music for the 2013 action-adventure video game Grand Theft Auto V , developed by Rockstar North and published by Rockstar Games , was composed by The Alchemist , Oh No and Tangerine Dream in collaboration with Woody Jackson . The game is the first entry in the Grand Theft Auto series to make use of an original score . In collaboration with each other , the musicians produced over twenty hours of music which scores the game 's missions . Some of the works produced by the musicians throughout the game 's development influenced some of the in-game missions and sparked inspiration for further score development . Grand Theft Auto V also has an in-game radio that can tune into sixteen stations playing more than 441 tracks of licensed music , as well as two talk radio stations . The composers of the score wanted it to accompany the licensed music , as opposed to detracting from it . The game 's music has been released on three official soundtracks : The Music of Grand Theft Auto V , released alongside the initial launch of the game , consists of three volumes comprising the score , and selections from the in-game radio ; The Cinematographic Score - GTA 5 , an electronic album released in March 2014 , comprises tracks composed and produced by Tangerine Dream founder Edgar Froese ; and Welcome to Los Santos , released with the Microsoft Windows version of the game , features songs from the in-game radio station The Lab , produced by The Alchemist and Oh No . Critical reception to the soundtracks was positive , as reviewers felt that the music connected appropriately with the gameplay .", "context_before": "Record Store Day is an annual event inaugurated in 2008 and held on one Saturday every April and every Black Friday in November to celebrate the culture of the independently owned record store . The day brings together fans , artists , and thousands of independent record stores across the world . A number of records are pressed specifically for Record Store Day , with a list of releases for each country , and are only distributed to shops participating in the event . The event began in the United States and remains headquartered there . Record Store Day has official international organizers in the United Kingdom , Ireland , France , Germany , The Netherlands , Denmark , Italy , Japan , Mexico , Australia , Spain , and Poland ( since 2019 ) . Watch Dogs ( stylized as WATCH_DOGS ) is a 2014 action-adventure game developed by Ubisoft Montreal and published by Ubisoft . Set in a fictionalized version of Chicago , the plot follows hacker Aiden Pearce 's search for revenge after the killing of his niece . The game is played from a third-person perspective , and the world is navigated on foot or by vehicle . An online multiplayer mode allows up to eight players to engage in cooperative and competitive gameplay . Development of the game began in 2009 , and continued for over five years . Duties were shared by many of Ubisoft 's studios worldwide , with more than a thousand people involved . The developers visited Chicago to conduct field research on the setting , and used regional language for authenticity . Hacking features were created in consultation with the cyber-security company Kaspersky Lab , and the in-game control system was based on SCADA . The score was composed by Brian Reitzell , who infused it with krautrock . Following its announcement in June 2012 , Watch Dogs was widely anticipated . It was released for Microsoft Windows , PlayStation 3 , PlayStation 4 , Xbox 360 , Xbox One , and Wii U in 2014 . The game received generally favorable reviews ; praise was directed at the gameplay , mission and open world design , combat system , hacking elements and mission variety , while criticism was expressed concerning the discrepancy in graphics quality between marketing and the real game , along with the plot and protagonist being less well-received ."}]}], "steps": [{"step": 1, "goal": "The Music of Grand Theft Auto V : Limited Edition LP Collection --linked_passage--> passage:/wiki/The_Music_of_Grand_Theft_Auto_V", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_352", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["The Music of Grand Theft Auto V", "passage:/wiki/The_Music_of_Grand_Theft_Auto_V"], "edges": [{"edge_id": "record:352", "head": "The Music of Grand Theft Auto V", "relation": "linked_passage", "tail": "passage:/wiki/The_Music_of_Grand_Theft_Auto_V", "source_type": "table", "source_id": "List of video game soundtracks released on vinyl", "row_index": 16, "column_name": "OST Title", "header_path": ["OST Title"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/The_Music_of_Grand_Theft_Auto_V", "text": "The music for the 2013 action-adventure video game Grand Theft Auto V , developed by Rockstar North and published by Rockstar Games , was composed by The Alchemist , Oh No and Tangerine Dream in collaboration with Woody Jackson . The game is the first entry in the Grand Theft Auto series to make use of an original score . In collaboration with each other , the musicians produced over twenty hours of music which scores the game 's missions . Some of the works produced by the musicians throughout the game 's development influenced some of the in-game missions and sparked inspiration for further score development . Grand Theft Auto V also has an in-game radio that can tune into sixteen stations playing more than 441 tracks of licensed music , as well as two talk radio stations . The composers of the score wanted it to accompany the licensed music , as opposed to detracting from it . The game 's music has been released on three official soundtracks : The Music of Grand Theft Auto V , released alongside the initial launch of the game , consists of three volumes comprising the score , and selections from the in-game radio ; The Cinematographic Score - GTA 5 , an electronic album released in March 2014 , comprises tracks composed and produced by Tangerine Dream founder Edgar Froese ; and Welcome to Los Santos , released with the Microsoft Windows version of the game , features songs from the in-game radio station The Lab , produced by The Alchemist and Oh No . Critical reception to the soundtracks was positive , as reviewers felt that the music connected appropriately with the gameplay .", "context_before": "Record Store Day is an annual event inaugurated in 2008 and held on one Saturday every April and every Black Friday in November to celebrate the culture of the independently owned record store . The day brings together fans , artists , and thousands of independent record stores across the world . A number of records are pressed specifically for Record Store Day , with a list of releases for each country , and are only distributed to shops participating in the event . The event began in the United States and remains headquartered there . Record Store Day has official international organizers in the United Kingdom , Ireland , France , Germany , The Netherlands , Denmark , Italy , Japan , Mexico , Australia , Spain , and Poland ( since 2019 ) . Watch Dogs ( stylized as WATCH_DOGS ) is a 2014 action-adventure game developed by Ubisoft Montreal and published by Ubisoft . Set in a fictionalized version of Chicago , the plot follows hacker Aiden Pearce 's search for revenge after the killing of his niece . The game is played from a third-person perspective , and the world is navigated on foot or by vehicle . An online multiplayer mode allows up to eight players to engage in cooperative and competitive gameplay . Development of the game began in 2009 , and continued for over five years . Duties were shared by many of Ubisoft 's studios worldwide , with more than a thousand people involved . The developers visited Chicago to conduct field research on the setting , and used regional language for authenticity . Hacking features were created in consultation with the cyber-security company Kaspersky Lab , and the in-game control system was based on SCADA . The score was composed by Brian Reitzell , who infused it with krautrock . Following its announcement in June 2012 , Watch Dogs was widely anticipated . It was released for Microsoft Windows , PlayStation 3 , PlayStation 4 , Xbox 360 , Xbox One , and Wii U in 2014 . The game received generally favorable reviews ; praise was directed at the gameplay , mission and open world design , combat system , hacking elements and mission variety , while criticism was expressed concerning the discrepancy in graphics quality between marketing and the real game , along with the plot and protagonist being less well-received ."}]}], "steps": [{"step": 1, "goal": "The Music of Grand Theft Auto V --linked_passage--> passage:/wiki/The_Music_of_Grand_Theft_Auto_V", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_945", "best_path_score": 22.9274, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12501, "llm_response_chars": 16, "llm_latency_ms": 50402.98, "wall_time_ms": 69767.6, "non_llm_time_ms": 19364.62, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.6666666666666666, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
