ue, "traversal_from": "N/A", "traversal_to": "table:List of SEPTA Regional Rail stations:row:7", "direction": "reverse"}, {"edge_id": "record:162", "head": "Allegheny", "relation": "has_record", "tail": "table:List of SEPTA Regional Rail stations:row:7", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 7, "column_name": "Station", "header_path": ["Station"], "structural": true, "traversal_from": "table:List of SEPTA Regional Rail stations:row:7", "traversal_to": "Allegheny", "direction": "reverse"}, {"edge_id": "record:588", "head": "Allegheny", "relation": "linked_passage", "tail": "passage:/wiki/Allegheny_station_(SEPTA_Regional_Rail)", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 7, "column_name": "Station", "header_path": ["Station"], "structural": true, "contexts": [{"source_id": "/wiki/Allegheny_station_(SEPTA_Regional_Rail)", "text": "Allegheny station is a SEPTA Regional Rail station located along the Manayunk/Norristown Line located at 22nd Street and Allegheny Avenue in the Swampoodle neighborhood of North Philadelphia . It has also been known in Reading and early SEPTA timetables as 22nd Street or Twenty-Second Street , a name also shared by a former Pennsylvania Railroad station on the Trenton and Chestnut Hill lines . Allegheny station is the first station along SEPTA 's Manayunk/Norristown Line not to be shared with any other line . In FY 2013 , Allegheny station had a weekday average of 76 boardings and 102 alightings .", "context_before": ""}], "traversal_from": "Allegheny", "traversal_to": "passage:/wiki/Allegheny_station_(SEPTA_Regional_Rail)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of SEPTA Regional Rail stations:row:7 --rail_connections--> N/A [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Allegheny --has_record--> table:List of SEPTA Regional Rail stations:row:7 [traverse reverse]", "depends_on": 1}, {"step": 3, "goa