ontainer": true, "selection_score": 20.55}}}, "reasoning_paths": [{"path_id": "row_10_80", "score": 17.3833, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.25, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1958-59", "table:List of Norwegian football champions:row:10", "Reidar Sundby ( Larvik Turn )", "passage:/wiki/Reidar_Sundby"], "edges": [{"edge_id": "record:209", "head": "1958-59", "relation": "has_record", "tail": "table:List of Norwegian football champions:row:10", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 10, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1958-59", "traversal_to": "table:List of Norwegian football champions:row:10", "direction": "forward"}, {"edge_id": "record:225", "head": "table:List of Norwegian football champions:row:10", "relation": "leading_goalscorer", "tail": "Reidar Sundby ( Larvik Turn )", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 10, "column_name": "Leading goalscorer", "header_path": ["Leading goalscorer"], "structural": true, "traversal_from": "table:List of Norwegian football champions:row:10", "traversal_to": "Reidar Sundby ( Larvik Turn )", "direction": "forward"}, {"edge_id": "record:378", "head": "Reidar Sundby ( Larvik Turn )", "relation": "linked_passage", "tail": "passage:/wiki/Reidar_Sundby", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 10, "column_name": "Leading goalscorer", "header_path": ["Leading goalscorer"], "structural": true, "contexts": [{"source_id": "/wiki/Reidar_Sundby", "text": "Reidar Sundby ( 17 October 1926 - 27 October 2014 ) was a Norwegian footballer . He started his career in Stag , and joined Larvik Turn in 1952 . With his team he won the Norwegian Main League 1952-53 , the Norwegian Main League 1954-55 and the Norwegian Main League 1955-56 - and became top goalscorer in the Norwegian Main League 1958-59 . He scored 71 goals in 110 first-tier games for Larvik Turn . He was capped once for Norway , in 1954 , and even scored in the game against Sweden . He later coached Stag . He died in October 2014 . He was the father of Tom Sundby .", "context_before": ""}], "traversal_from": "Reidar Sundby ( Larvik Turn )", "traversal_to": "passage:/wiki/Reidar_Sundby", "direction": "forward"}], "steps": [{"step": 1, "goal": "1958-59 --has_record--> table:List of Norwegian football champions:row:10", "depends_on": null}, {"step": 2, "goal": "table:List of Norwegian football champions:row:10 --leading_goalscorer--> Reidar Sundby ( Larvik Turn )", "depends_on": 1}, {"step": 3, "goal": "Reidar Sundby ( Larvik Turn ) --linked_passage--> passage:/wiki/Reidar_Sundby", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 21.3833}}, {"path_id": "row_bridge_12_97", "score": 15.6333, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Eik-Tønsberg", "Eik-Tønsberg", "table:List of Norwegian football champions:row:12", "Per Kristoffersen ( Fredrikstad )"], "edges": [{"edge_id": "record:386", "head": "Eik-Tønsberg", "relation": "linked_passage", "tail": "passage:/wiki/Eik-Tønsberg", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 11, "column_name": "Third place", "header_path": ["Third place"], "structural": true, "contexts": [{"source_id": "/wiki/Eik-Tønsberg", "text": "Fotballklubben Eik Tønsberg Allianseidrettslag ( formerly known as Eik-Tønsberg ) , is a Norwegian association football club from Eik , Vestfold . The club got its present name on 1 January 2020 after a merger with FK Tønsberg . The football team competes with the name FK Eik Tønsberg 871 where the number represents the founding year of the town of Tønsberg .", "context_before": "Reidar Sundby ( 17 October 1926 - 27 October 2014 ) was a Norwegian footballer . He started his career in Stag , and joined Larvik Turn in 1952 . With his team he won the Norwegian Main League 1952-53 , the Norwegian Main League 1954-55 and the Norwegian Main League 1955-56 - and became top goalscorer in the Norwegian Main League 1958-59 . He scored 71 goals in 110 first-tier games for Larvik Turn . He was capped once for Norway , in 1954 , and even scored in the game against Sweden . He later coached Stag . He died in October 2014 . He was the father of Tom Sundby . The 1959-1960 Hovedserien was the 15th completed season of top division football in Norway ."}], "traversal_from": "passage:/wiki/Eik-Tønsberg", "traversal_to": "Eik-Tønsberg", "direction": "reverse"}, {"edge_id": "record:260", "head": "table:List of Norwegian football champions:row:12", "relation": "runners_up", "tail": "Eik-Tønsberg", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 12, "column_name": "Runners-up", "header_path": ["Runners-up"], "structural": true, "traversal_from": "Eik-Tønsberg", "traversal_to": "tab