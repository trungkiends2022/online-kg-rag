f Obwalden:row:11:cell:Mountain"], "edges": [{"edge_id": "record:340", "head": "Brienzer Rothorn", "relation": "linked_passage", "tail": "passage:/wiki/Brienzer_Rothorn", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Mountain", "header_path": ["Mountain"], "structural": true, "contexts": [{"source_id": "/wiki/Brienzer_Rothorn", "text": "The Brienzer Rothorn is a mountain of the Emmental Alps , in Switzerland . With an elevation of 2,350 metres above sea level , the Brienzer Rothorn is the highest summit of the range . To its west lies the Tannhorn , whilst to its east are Arnihaaggen , Höch Gumme and the Brünig Pass ( 1,008 m ) . On its south side it overlooks Lake Brienz , whilst to the north it looks out over the Waldemme valley . Administratively , the summit is shared by the municipalities of Brienz , to the south-west , Schwanden bei Brienz , to the south-east , Giswil to the north-east , and Flühli , to the north-west . Brienz and Schwanden bei Brienz are in the canton of Bern , Giswil is in the canton of Obwalden , and Flühli is in the canton of Lucerne . The Brienzer Rothorn is the highest point in the canton of Lucerne . The summit can be reached from Brienz by the Brienz Rothorn Bahn ( steam train ) , the summit station being located at 2,244 metres on the Bernese side . It can also be reached from Sörenberg , in Flühli , by a cable car .", "context_before": ""}], "traversal_from": "passage:/wiki/Brienzer_Rothorn", "traversal_to": "Brienzer Rothorn", "direction": "reverse"}, {"edge_id": "record:167", "head": "Brienzer Rothorn", "relation": "has_record", "tail": "table:List of mountains of Obwalden:row:11", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Mountain", "header_path": ["Mountain"], "structural": true, "traversal_from": "Brienzer Rothorn", "traversal_to": "table:List of mountains of Obwalden:row:11", "direction": "forward"}, {"edge_id": "record:168", "head": "table:List of mountains of Obwalden:row:11", "relation": "mountain", "tail": "table:List of mountains of Obwalden:row:11:cell:Mountain", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Mountain", "header_path": ["Mountain"], "structural": true, "cell_node": true, "cell_value": "Brienzer Rothorn", "traversal_from": "table:List of mountains of Obwalden:row:11", "traversal_to": "table:List of mountains of Obwalden:row:11:cell:Mountain", "direction": "forward"}], "steps": [{"step": 1, "goal": "Brienzer Rothorn --linked_passage--> passage:/wiki/Brienzer_Rothorn [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Brienzer Rothorn --has_record--> table:List of mountains of Obwalden:row:11", "depends_on": 1}, {"step": 3, "goal": "table:List of mountains of Obwalden:row:11 --mountain--> table:List of mountains of Obwalden:row:11:cell:Mountain", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 25.2167}}, {"path_id": "grounded_1124", "score": 18.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.25, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Giswil", "Giswil", "table:List of mountains of Obwalden:row:11", "Brienzer Rothorn"], "edges": [{"edge_id": "record:342", "head": "Giswil", "relation": "linked_passage", "tail": "passage:/wiki/Giswil", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Municipality ( ies )", "header_path": ["Municipality ( ies )"], "structural": true, "contexts": [{"source_id": "/wiki/Giswil", "text": "Giswil is a municipality in the canton of Obwalden in Switzerland .", "context_before": "The Brienzer Rothorn is a mountain of the Emmental Alps , in Switzerland . With an elevation of 2,350 metres above sea level , the Brienzer Rothorn is the highest summit of the range . To its west lies the Tannhorn , whilst to its east are Arnihaaggen , Höch Gumme and the Brünig Pass ( 1,008 m ) . On its south side it overlooks Lake Brienz , whilst to the north it looks out over the Waldemme valley . Administratively , the summit is shared by the municipalities of Brienz , to the south-west , Schwanden bei Brienz , to the south-east , Giswil to the north-east , and Flühli , to the north-west . Brienz and Schwanden bei Brienz are in the canton of Bern , Giswil is in the canton of Obwalden , and Flühli is in the canton of Lucerne . The Brienzer Rothorn is the highest point in the canton of Lucerne . The summit can be reached from Brienz by the Brienz Rothorn Bahn ( steam train ) , the summit station being located at 2,244 metres on the Bernese side . It can also be reached from Sörenberg , in Flühli , by a cable car . The Emmental Alps ( German : Emmentaler Alpen ) are a mountain range in the western part of the Alps , in Switzerland . They are located north-west of the Brünig Pass , mainly in the cantons of Lucerne , Bern , and Obwalden , with a small portion in the canton of Nidwalden . The highest summit of the range is the Brienzer Rothorn , which is also the highest point in the canton of Lucerne . The range is named after the Emme valley ( German : Emmental ) . In the north-west corner one finds the relatively low , but widespread , and very furrowed Napf . The Emmental Alps are separated from the Bernese Alps by the Aare valley to the south and connected to the Uri Alps by the four lakes Lungerersee , Sarnersee , Wichelsee , and Vierwaldstättersee to the east ."}], "traversal_from": "passage:/wiki/Giswil", "traversal_to": "Giswil", "direction": "reverse"}, {"edge_id": "record:181", "head": "table:List of mountains of Obwalden:row:11", "relation": "municipality_ies", "tail": "Giswil", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Municipality ( ies )", "header_path": ["Municipality ( ies )"], "structural": true, "traversal_from": "Giswil", "traversal_to": "table:List of mountains of Obwalden:row:11", "direction": "reverse"}, {"edge_id": "record:167", "head": "Brienzer Rothorn", "relation": "has_record", "tail": "table:List of mountains of Obwalden:row:11", "source_type": "table", "source_id": "List of mountains of Obwalden", "row_index": 11, "column_name": "Mountain", "header_path": ["Mountain"], "structural": true, "traversal_from": "table:List of mountains of Obwalden:row:11", "traversal_to": "Brienzer Rothorn", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Giswil --linked_passage--> passage:/wiki/Giswil [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of mountains of Obwalden:row:11 --municipality_ies--> Giswil [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Brienzer Rothorn --has_record--> table:List of mountains of Obwalden:row:11 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 25.05}}, {"path_id": "grounded_142", "score": 18.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.25, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0,