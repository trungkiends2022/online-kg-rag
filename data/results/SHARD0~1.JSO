ained_for_missing_grounding": false, "pre_answer_path_selection": false, "verification_by_path": {"grounded_388": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 24.9429}, "grounded_139": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 23.6429}, "grounded_367": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 23.6429}, "grounded_507": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 23.6429}, "grounded_103": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 22.6429}}}, "reasoning_paths": [{"path_id": "grounded_388", "score": 17.9429, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.1429, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Danny_Harris", "Danny Harris ( USA )", "table:400 metres hurdles:row:19", "1990"], "edges": [{"edge_id": "record:319", "head": "Danny Harris ( USA )", "relation": "linked_passage", "tail": "passage:/wiki/Danny_Harris", "source_type": "table", "source_id": "400 metres hurdles", "row_index": 19, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "contexts": [{"source_id": "/wiki/Danny_Harris", "text": "Danny Lee Harris ( born September 7 , 1965 ) is an American former track and field athlete who specialized in the 400-meter hurdles . He won silver medals at the 1984 Summer Olympics in Los Angeles and the 1987 World Championships in Rome , both behind Edwin Moses . His time of 48.02 in 1984 at age 18 is still the current world junior record . Harris 's greatest moment came at a meeting in Madrid in 1987 where he defeated Edwin Moses - who had been undefeated since 1977 . Later in the same year , Harris came very close to defeating Moses again in a dramatic final at the World Championships , but Moses defended his title by 2/100 of a second . Harris could not take part in the 1988 Olympics , just finishing fifth at the 1988 United States Olympic trials in Indianapolis . Danny Harris is an alumnus of Perris High School in Perris , California , where he grew up . In 1983 , he won the CIF California State Championship in the 300 hurdles , and ran a thrilling anchor leg vs Hawthorne High School 's Henry Thomas in the team 's second place 4×400 metres relay team , leading Perris to its most impressive showing at the event . He returned to coach the boys ' track team in 2001 , and he led them to their first League Championship since he ran for the school almost 20 years earlier . Harris competed collegiately at Iowa State University . He collected three national championships and four Drake Relay titles while at Iowa State . He was never beaten by a collegiate athlete in the 400-meter hurdles during his time at Iowa State .", "context_before": ""}], "traversal_from": "passage:/wiki/Danny_Harris", "traversal_to": "Danny Harris ( USA )", "direction": "reverse"}, {"edge_id": "record:256", "head": "table:400 metres hurdles:row:19", "relation": "athlete", "tail": "Danny Harris ( USA )", "source_type": "table", "source_id": "400 metres hurdles", "row_index": 19, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "traversal_from": "Danny Harris ( USA )", "traversal_to": "table:400 metres hurdles:row:19", "direction": "reverse"}, {"edge_id": "record:248", "head": "1990", "relation": "has_record", "tail": "table:400 metres hurdles:row:19", "source_type": "table", "source_id": "400 metres hurdles", "row_index": 19, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "table:400 metres hurdles:row:19", "traversal_to": "1990", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Danny Harris ( USA ) --linked_passage--> passage:/wiki/Danny_Harris [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:400 metres hurdles:row:19 --athlete--> Danny Harris ( USA ) [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "1990 --has_record--> table:400 metres hurdles:row:19 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.625, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 24.9429}}, {"path_id": "grounded_139", "score": 16.6429, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.1429, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.0}, "nodes": ["Danny Harris ( USA )", "/wiki/Danny_Harris"], "edges": [{"edge_id": "semantic:79:1", "head":