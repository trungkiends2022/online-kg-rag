}, "grounded_79": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8}, "row_1_2": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.9667}}}, "reasoning_paths": [{"path_id": "grounded_122", "score": 8.8833, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Australia", "table:List of University of Oxford people in public life overseas:row:7", "Geoff Gallop", "passage:/wiki/Geoff_Gallop"], "edges": [{"edge_id": "record:71", "head": "table:List of University of Oxford people in public life overseas:row:7", "relation": "country", "tail": "Australia", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 7, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "Australia", "traversal_to": "table:List of University of Oxford people in public life overseas:row:7", "direction": "reverse"}, {"edge_id": "record:66", "head": "Geoff Gallop", "relation": "has_record", "tail": "table:List of University of Oxford people in public life overseas:row:7", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 7, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of University of Oxford people in public life overseas:row:7", "traversal_to": "Geoff Gallop", "direction": "reverse"}, {"edge_id": "record:197", "head": "Geoff Gallop", "relation": "linked_passage", "tail": "passage:/wiki/Geoff_Gallop", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 7, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Geoff_Gallop", "text": "Geoffrey Ian Gallop AC ( born 27 September 1951 ) is Professor and Director of the Graduate School of Government at the University of Sydney and former chairman of the Australian Republican Movement . He was the 27th Premier of Western Australia ( 2001 - 2006 ) . Born in Geraldton , Western Australia , Gallop studied at the University of Western Australia , and later progressed to St John 's College at the University of Oxford after winning a Rhodes Scholarship . Having joined the Labor Party in 1971 , he served as a councillor for the City of Fremantle between 1983 and 1986 , and was elected to the seat of Victoria Park in the Western Australian Legislative Assembly at the 1986 state election . Having held several portfolios in the preceding Lawrence Ministry ( including Minister for Education ) , Gallop replaced Jim McGinty as Leader of the Opposition in 1996 following McGinty 's resignation . At the 1996 election , Labor was defeated by the incumbent Liberal Party led by Richard Court despite a rise in Labor 's share of the vote , but he remained as the party 's leader , and at the 2001 election Labor was elected to government , with Gallop becoming premier . Having successfully contested the 2005 election , Gallop resigned as Premier , Labor leader and from parliament in early 2006 to aid his recovery from depression , and was replaced by Alan Carpenter .", "context_before": ""}], "traversal_from": "Geoff Gallop", "traversal_to": "passage:/wiki/Geoff_Gallop", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of University of Oxford people in public life overseas:row:7 --country--> Australia [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Geoff Gallop --has_record--> table:List of University of Oxford people in public life overseas:row:7 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Geoff Gallop --linked_passage--> passage:/wiki/Geoff_Gallop", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.3833}}, {"path_id": "grounded_99", "score": 8.8833, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Australia", "table:List of University of Oxford people in public life overseas:row:6", "Gareth Evans", "passage:/wiki/Gareth_Evans_(politician)"], "edges": [{"edge_id": "record:62", "head": "table:List of University of Oxford people in public life overseas:row:6", "relation": "country", "tail": "Australia", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 6, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "Australia", "traversal_to": "table:List of University of Oxford people in public life overseas:row:6", "direction": "reverse"}, {"edge_id": "record:57", "head": "Gareth Evans", "relation": "has_record", "tail": "table:List of University of Oxford people in public life overseas:row:6", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 6, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of University of Oxford people in public life overseas:row:6", "traversal_to": "Gareth Evans", "direction": "reverse"}, {"edge_id": "record:196", "head": "Gareth Evans", "relation": "linked_passage", "tail": "passage:/wiki/Gareth_Evans_(politician)", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 6, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Gareth_Evans_(politician)", "text": "Gareth John Evans AC , QC ( born 5 September 1944 ) , is an Australian politician , international policymaker , academic and barrister . He represented the Australian Labor Party in the Senate and House of Representatives from 1978 to 1999 , serving as a Cabinet Minister in the Hawke and Keating governments from 1983 to 1996 as Attorney-General , Minister for Resources and Energy , Minister for Transport and Communications and most prominently , from 1988 to 1996 , as Minister for Foreign Affairs . He was Leader of the Government in the Senate from 1993 to 1996 , Deputy Leader of the Opposition from 1996 to 1998 , and remains one of the two longest-serving federal Cabinet Ministers in Labor Party history . After leaving politics , he was President and Chief Executive Officer of the Brussels-based International Crisis Group from 2000 to 2009 . On returning to Australia he was appointed in 2009 honorary professorial fellow at the University of Melbourne . He has served on a number of major international commissions and panels , including as co-chair of the International Commission on Intervention and State Sovereignty ( 2000-01 ) and International Commission on Nuclear Non-proliferation and Disarmament ( 2008-10 ) . Evans has written extensively on international relations and legal , constitutional and political affairs , and has been internationally recognised for his contributions to the theory and practice of mass atrocity and conflict prevention , arms control and disarmament . From 2010 to 2019 , Evans was the Chancellor of the Australian National University ( ANU ) . He was appointed an Honorary Professorial Fellow at the ANU in 2012 . He currently is a member of the Board of Sponsors for the Bulletin of the Atomic Scientists .", "context_before": "James Hayes Shofner Cooper ( born June 19 , 1954 ) is an American politician serving as the U.S. Representative for Tennessee 's 5th congressional district ( based in Nashville ) , serving since 2003 . He is a member of the Democratic Party and the Blue Dog Coalition , and previously represented Tennessee 's 4th congressional district from 1983 to 1995 . Sir Zelman Cowen , AK , GCMG , GCVO , PC , QC ( 7 October 1919 - 8 December 2011 ) was an Australian legal scholar and university administrator who served as the 19th Governor-General of Australia , in office from 1977 to 1982 . Cowen was born in Melbourne , and attended Scotch College before going on to the University of Melbourne . His studies were interrupted by World War II , during which he served in the Royal Australian Navy . After the war 's end , Cowen attended New College , Oxford , on a Rhodes Scholarship . He subsequently won the prestigious Vinerian Scholarship as the best student in the Bachelor of Civil Law degree . He remained at Oxford after graduating , serving as a fellow of Oriel College from 1947 to 1950 . In 1951 , Cowen returned to Australia to become dean of the law faculty at the University of Melbourne . In 1953 , still while at The University of Melbourne , he was awarded a Fulbright Senior Scholarship in Law to Harvard University . He became known as an expert on constitutional law , and was a visiting professor at a number of overseas institutions . He later served as vice-chancellor of the University of New England ( 1966-1970 ) and the University of Queensland ( 1970-1977 ) . In 1977 , Malcolm Fraser appointed Cowen to succeed John Kerr as governor-general . He was an uncontroversial choice , and became the second Jewish holder of the position , after Sir Isaac Isaacs ."}], "traversal_from": "Gareth Evans", "traversal_to": "passage:/wiki/Gareth_Evans_(politician)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of University of Oxford people in public life overseas:row:6 --country--> Australia [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Gareth Evans --has_record--> table:List of University of Oxford people in public life overseas:row:6 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Gareth Evans --linked_passage--> passage:/wiki/Gareth_Evans_(politician)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.3833}}, {"path_id": "grounded_39", "score": 8.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Australia", "table:List of University of Oxford people in public life overseas:row:0", "Kim Beazley", "passage:/wiki/Kim_Beazley"], "edges": [{"edge_id": "record:5", "head": "table:List of University of Oxford people in public life overseas:row:0", "relation": "country", "tail": "Australia", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 0, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "Australia", "traversal_to": "table:List of University of Oxford people in public life overseas:row:0", "direction": "reverse"}, {"edge_id": "record:0", "head": "Kim Beazley", "relation": "has_record", "tail": "table:List of University of Oxford people in public life overseas:row:0", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 0, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of University of Oxford people in public life overseas:row:0", "traversal_to": "Kim Beazley", "direction": "reverse"}, {"edge_id": "record:183", "head": "Kim Beazley", "relation": "linked_passage", "tail": "passage:/wiki/Kim_Beazley", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 0, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Kim_Beazley", "text": "Kim Christian Beazley , AC ( born 14 December 1948 ) is a former Australian politician serving as the 33rd and current Governor of Western Australia . He was previously Deputy Prime Minister ( 1995-1996 ) , Leader of the Australian Labor Party ( ALP ) and Leader of the Opposition ( 1996-2001 , 2005-2006 ) and Ambassador to the United States ( 2010-2016 ) . Beazley was born in Subiaco , Western Australia , the son of politician Kim Beazley senior . He studied at the University of Western Australia and Balliol College , Oxford , attending the latter as a Rhodes Scholar . After a period as a lecturer at Murdoch University , Beazley was elected to parliament at the 1980 federal election , winning the Division of Swan for the Labor Party . He was added to the ministry when the party won the 1983 election , and served continuously through to the party 's defeat in 1996 . His longest-held portfolio during that time was Minister for Defence ( 1984-1990 ) . In 1995 , Beazley was elected deputy leader of the Labor Party in place of Brian Howe , thus becoming deputy prime minister . After Labor lost power in 1996 , Beazley was elected unopposed as party leader in place of Paul Keating . He led Labor to the 1998 election , recording a positive swing but falling well short of victory . After a second defeat in 2001 , he resigned the leadership in favour of his deputy Simon Crean . However , in 2003 Beazley made two attempts to regain his old position .", "context_before": ""}], "traversal_from": "Kim Beazley", "traversal_to": "passage:/wiki/Kim_Beazley", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of University of Oxford people in public life overseas:row:0 --country--> Australia [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Kim Beazley --has_record--> table:List of University of Oxford people in public life overseas:row:0 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Kim Beazley --linked_passage--> passage:/wiki/Kim_Beazley", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8}}, {"path_id": "grounded_79", "score": 8.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Australia", "table:List of University of Oxford people in public life overseas:row:5", "Zelman Cowen", "passage:/wiki/Zelman_Cowen"], "edges": [{"edge_id": "record:53", "head": "table:List of University of Oxford people in public life overseas:row:5", "relation": "country", "tail": "Australia", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 5, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "Australia", "traversal_to": "table:List of University of Oxford people in public life overseas:row:5", "direction": "reverse"}, {"edge_id": "record:48", "head": "Zelman Cowen", "relation": "has_record", "tail": "table:List of University of Oxford people in public life overseas:row:5", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 5, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of University of Oxford people in public life overseas:row:5", "traversal_to": "Zelman Cowen", "direction": "reverse"}, {"edge_id": "record:195", "head": "Zelman Cowen", "relation": "linked_passage", "tail": "passage:/wiki/Zelman_Cowen", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 5, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Zelman_Cowen", "text": "Sir Zelman Cowen , AK , GCMG , GCVO , PC , QC ( 7 October 1919 - 8 December 2011 ) was an Australian legal scholar and university administrator who served as the 19th Governor-General of Australia , in office from 1977 to 1982 . Cowen was born in Melbourne , and attended Scotch College before going on to the University of Melbourne . His studies were interrupted by World War II , during which he served in the Royal Australian Navy . After the war 's end , Cowen attended New College , Oxford , on a Rhodes Scholarship . He subsequently won the prestigious Vinerian Scholarship as the best student in the Bachelor of Civil Law degree . He remained at Oxford after graduating , serving as a fellow of Oriel College from 1947 to 1950 . In 1951 , Cowen returned to Australia to become dean of the law faculty at the University of Melbourne . In 1953 , still while at The University of Melbourne , he was awarded a Fulbright Senior Scholarship in Law to Harvard University . He became known as an expert on constitutional law , and was a visiting professor at a number of overseas institutions . He later served as vice-chancellor of the University of New England ( 1966-1970 ) and the University of Queensland ( 1970-1977 ) . In 1977 , Malcolm Fraser appointed Cowen to succeed John Kerr as governor-general . He was an uncontroversial choice , and became the second Jewish holder of the position , after Sir Isaac Isaacs .", "context_before": ""}], "traversal_from": "Zelman Cowen", "traversal_to": "passage:/wiki/Zelman_Cowen", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of University of Oxford people in public life overseas:row:5 --country--> Australia [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Zelman Cowen --has_record--> table:List of University of Oxford people in public life overseas:row:5 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Zelman Cowen --linked_passage--> passage:/wiki/Zelman_Cowen", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8}}, {"path_id": "row_1_2", "score": 7.4667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 0.6667, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Rubén Berríos", "table:List of University of Oxford people in public life overseas:row:1", "Puerto Rico", "passage:/wiki/Puerto_Rico"], "edges": [{"edge_id": "record:9", "head": "Rubén Berríos", "relation": "has_record", "tail": "table:List of University of Oxford people in public life overseas:row:1", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Rubén Berríos", "traversal_to": "table:List of University of Oxford people in public life overseas:row:1", "direction": "forward"}, {"edge_id": "record:14", "head": "table:List of University of Oxford people in public life overseas:row:1", "relation": "country", "tail": "Puerto Rico", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 1, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "table:List of University of Oxford people in public life overseas:row:1", "traversal_to": "Puerto Rico", "direction": "forward"}, {"edge_id": "record:185", "head": "Puerto Rico", "relation": "linked_passage", "tail": "passage:/wiki/Puerto_Rico", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 1, "column_name": "Country", "header_path": ["Country"], "structural": true, "contexts": [{"source_id": "/wiki/Puerto_Rico", "text": "Puerto Rico [ a ] ( Spanish for Rich Port ; abbreviated PR ) , officially the Commonwealth of Puerto Rico ( Spanish : Estado Libre Asociado de Puerto Rico , lit . Free Associated State of Puerto Rico ) [ b ] and briefly called Porto Rico , [ c ] is an unincorporated territory of the United States located in the northeast Caribbean Sea , approximately 1,000 miles ( 1,600 km ) southeast of Miami , Florida . An archipelago among the Greater Antilles , located between the Dominican Republic and the US Virgin Islands , Puerto Rico includes the eponymous main island and several smaller islands , such as Mona , Culebra , and Vieques . The capital and most populous city is San Juan . The territory 's total population is approximately 3.4 million , more than 21 U.S. states . Spanish and English are the official languages of the executive branch of government , though Spanish predominates . Originally populated by the indigenous Taíno people , Puerto Rico was colonized by Spain following the arrival of Christopher Columbus in 1493 . It was contested by the French , Dutch , and British , but remained a Spanish possession for the next four centuries . The island 's cultural and demographic landscapes were shaped by the displacement and assimilation of the native population , the forced migration of African slaves , and settlement from the Canary Islands and Andalusia . In the Spanish Empire , Puerto Rico played a secondary but strategic role compared to wealthier colonies like Peru and New Spain . Spain 's distant administrative control continued up to the end of the 19th century , producing a distinctive creole Hispanic culture and language that combined indigenous , African , and European elements . On September 23 , 1868 , Ramón Emeterio Betances unleashed a revolt against Spanish rule , declaring for the first time the idea of Puerto Ricans as a distinct people , with right to sovereignty .", "context_before": ""}], "traversal_from": "Puerto Rico", "traversal_to": "passage:/wiki/Puerto_Rico", "direction": "forward"}], "steps": [{"step": 1, "goal": "Rubén Berríos --has_record--> table:List of University of Oxford people in public life overseas:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of University of Oxford people in public life overseas:row:1 --country--> Puerto Rico", "depends_on": 1}, {"step": 3, "goal": "Puerto Rico --linked_passage--> passage:/wiki/Puerto_Rico", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.9667}}, {"path_id": "answer_evidence_record_10", "score": 201.5, "score_components": {"reverse_answer_match": 201.5}, "nodes": ["table:List of University of Oxford people in public life overseas:row:1", "table:List of University of Oxford people in public life overseas:row:1:cell:Name"], "edges": [{"edge_id": "record:10", "head": "table:List of University of Oxford people in public life overseas:row:1", "relation": "name", "tail": "table:List of University of Oxford people in public life overseas:row:1:cell:Name", "source_type": "table", "source_id": "List of University of Oxford people in public life overseas", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "cell_node": true, "cell_value": "Rubén Berríos"}], "steps": [{"step": 1, "goal": "table:List of University of Oxford people in public life overseas:row:1 --name--> table:List of University of Oxford people in public life overseas:row:1:cell:Name", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 201.5, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_11", "score": 201.5, "score_components": {"reverse_answer_match": 201.5}, "nodes": ["table:List of University of Oxford people in public life overseas:row:1:cell:Name", "Rubén Berríos"], "edges": [{"edge_id": "record:11", "head": "table:List of University of Oxford people in public life overseas:row:1:cell:Name", "relation": "cell_value", "tail": "Rubén Berríos", "source_type": "table", "source_id": "List of University of Oxford people i