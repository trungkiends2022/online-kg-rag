r Olympics:row:15", "direction": "forward"}, {"edge_id": "record:281", "head": "table:Germany at the 2006 Winter Olympics:row:15", "relation": "name", "tail": "Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel", "source_type": "table", "source_id": "Germany at the 2006 Winter Olympics", "row_index": 15, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:Germany at the 2006 Winter Olympics:row:15", "traversal_to": "Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel", "direction": "forward"}, {"edge_id": "record:482", "head": "Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel", "relation": "linked_passage", "tail": "passage:/wiki/Stefanie_Böhler", "source_type": "table", "source_id": "Germany at the 2006 Winter Olympics", "row_index": 15, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Stefanie_Böhler", "text": "Stefanie Böhler ( born 27 February 1981 ) is a German cross-country skier who competed between 1999 and 2018 . She won a silver medal in the 4 × 5 km relay at the 2006 Winter Olympics in Turin . Her best individual finish was 20th in both the individual sprint and the 30 km events at those same games . Böhler also won a silver medal in the 4 × 5 km relay at the 2007 FIS Nordic World Ski Championships . Her best individual result at the FIS Nordic World Ski Championships was sixth in the 30 km classical mass start event at Falun in 2015 . She won the German national championship in the sprint in 2004 and the 5 km in 2006 , and also won a 2002 Continental Cup event in Italy . She won a World Cup team sprint with Denise Herrmann in 2010 . With 343 individual World Cup starts , Böhler ranks second all-time , for both men and women , after Aino-Kaisa Saarinen with 354 . She announced her retirement from cross-country skiing in March 2019 , together with teammates Elisabeth Schicho and Sandra Ringwald .", "context_before": ""}], "traversal_from": "Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel", "traversal_to": "passage:/wiki/Stefanie_Böhler", "direction": "forward"}], "steps": [{"step": 1, "goal": "Silver --has_record--> table:Germany at the 2006 Winter Olympics:row:15", "depends_on": null}, {"step": 2, "goal": "table:Germany at the 2006 Winter Olympics:row:15 --name--> Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel", "depends_on": 1}, {"step": 3, "goal": "Stefanie Böhler Viola Bauer Evi Sachenbacher-Stehle Claudia Künzel --linked_passage--> passage:/wiki/Stefanie_Böhler", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 17.7667}}], "best_path_id": "grounded_996", "best_path_score": 14.6667, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 13664, "llm_response_chars": 15, "llm_latency_ms": 1593.74, "wall_time_ms": 29244.11, "non_llm_time_ms": 27650.37, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "judge_contract", "is_ambiguous": null, "ambiguity_status": null}
