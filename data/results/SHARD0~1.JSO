": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Martha_McSally", "text": "Martha Elizabeth McSally ( born March 22 , 1966 ) is a United States Air Force ( USAF ) combat veteran and politician serving as the junior United States Senator for Arizona . A Republican , she previously served as the U.S. Representative for Arizona 's 2nd congressional district . McSally served in the USAF from 1988 to 2010 and rose to the rank of colonel before retiring . One of the highest-ranking female pilots in the history of the Air Force , McSally was the first American woman to fly in combat following the 1991 lifting of the prohibition on female combat pilots . She was also the first female commander of a USAF fighter squadron ( the 354th Fighter Squadron ( 354 FS ) , based at Davis-Monthan Air Force Base ) . In 2001 , she sued the United States Department of Defense in McSally v. Rumsfeld , challenging the military policy that required United States and United Kingdom servicewomen stationed in Saudi Arabia to wear the body-covering abaya when traveling off base in the country . Following an unsuccessful congressional bid in 2012 , McSally was first elected to the U.S. House of Representatives in 2014 . She served two terms as the U.S. Representative for Arizona 's 2nd congressional district . McSally was the Republican nominee in Arizona 's 2018 U.S. Senate election , losing 50-48% to Democratic Congresswoman Kyrsten Sinema , while Democrat Ann Kirkpatrick won McSally 's seat in the House elections . Following that election , interim U.S . Senator Jon Kyl announced his resignation from the state 's other Senate seat , and Republican Governor Doug Ducey appointed McSally to succeed Kyl . There will be a special election coinciding with the 2020 general election to determine whether McSally will serve the remainder of the Class 3 senate term , likely pitting her against astronaut and political activist Mark Kelly .", "context_before": ""}], "traversal_from": "Martha McSally", "traversal_to": "passage:/wiki/Martha_McSally", "direction": "forward"}], "steps": [{"step": 1, "goal": "Martha McSally --notability--> Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Martha McSally --linked_passage--> passage:/wiki/Martha_McSally", "depends_on": 1}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.4833}}, {"path_id": "answer_evidence_record_180", "score": 103.0, "score_components": {"reverse_answer_match": 103.0}, "nodes": ["table:List of United States Air Force Academy alumni:row:12:cell:Notability", "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot"], "edges": [{"edge_id": "record:180", "head": "table:List of United States Air Force Academy alumni:row:12:cell:Notability", "relation": "cell_value", "tail": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "cell_node": true}], "steps": [{"step": 1, "goal": "table:List of United States Air Force Academy alumni:row:12:cell:Notability --cell_value--> Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 103.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_380", "score": 103.0, "score_components": {"reverse_answer_match": 103.0}, "nodes": ["Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "passage:/wiki/John_McCain"], "edges": [{"edge_id": "record:380", "head": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "relation": "linked_passage", "tail": "passage:/wiki/John_McCain", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "contexts": [{"source_id": "/wiki/John_McCain", "text": "John Sidney McCain III ( August 29 , 1936 - August 25 , 2018 ) was an American politician and military officer , who served as a United States senator for Arizona from January 1987 until his death in 2018 . He previously served two terms in the United States House of Representatives and was the Republican nominee for president of the United States in the 2008 election , which he lost to Barack Obama . McCain graduated from the United States Naval Academy in 1958 and received a commission in the United States Navy . He became a naval aviator and flew ground-attack aircraft from aircraft carriers . During the Vietnam War , he almost died in the 1967 USS Forrestal fire . While on a bombing mission during Operation Rolling Thunder over Hanoi in October 1967 , he was shot down , seriously injured , and captured by the North Vietnamese . He was a prisoner of war until 1973 . He experienced episodes of torture and refused an out-of-sequence early release . During the war , he sustained wounds that left him with lifelong physical disabilities . He retired from the Navy as a captain in 1981 and moved to Arizona , where he entered politics . In 1982 , McCain was elected to the United States House of Representatives , where he served two terms . He entered the U.S. Senate in 1987 and easily won reelection five times .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot --linked_passage--> passage:/wiki/John_McCain", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 103.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_381", "score": 103.0, "score_components": {"reverse_answer_match": 103.0}, "nodes": ["Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate", "passage:/wiki/John_McCain"], "edges": [{"edge_id": "record:381", "head": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate", "relation": "linked_passage", "tail": "passage:/wiki/John_McCain", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/John_McCain", "text": "John Sidney McCain III ( August 29 , 1936 - August 25 , 2018 ) was an American politician and military officer , who served as a United States senator for Arizona from January 1987 until his death in 2018 . He previously served two terms in the United States House of Representatives and was the Republican nominee for president of the United States in the 2008 election , which he lost to Barack Obama . McCain graduated from the United States Naval Academy in 1958 and received a commission in the United States Navy . He became a naval aviator and flew ground-attack aircraft from aircraft carriers . During the Vietnam War , he almost died in the 1967 USS Forrestal fire . While on a bombing mission during Operation Rolling Thunder over Hanoi in October 1967 , he was shot down , seriously injured , and captured by the North Vietnamese . He was a prisoner of war until 1973 . He experienced episodes of torture and refused an out-of-sequence early release . During the war , he sustained wounds that left him with lifelong physical disabilities . He retired from the Navy as a captain in 1981 and moved to Arizona , where he entered politics . In 1982 , McCain was elected to the United States House of Representatives , where he served two terms . He entered the U.S. Senate in 1987 and easily won reelection five times .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate --linked_passage--> passage:/wiki/John_McCain", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 103.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_253", "best_path_score": 16.1333, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 13560, "llm_response_chars": 14, "llm_latency_ms": 17470.63, "wall_time_ms": 64689.89, "non_llm_time_ms": 47219.26, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
