": false, "pre_answer_path_selection": false, "verification_by_path": {"grounded_608": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.5778}, "grounded_641": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.5778}, "grounded_1121": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8571, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.1333}, "row_11_43": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.5778}, "row_12_48": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.5778}}}, "reasoning_paths": [{"path_id": "grounded_608", "score": 9.5778, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.7778, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Darna_(2009_TV_series)", "Darna", "table:Alyssa Alano:row:11", "2009"], "edges": [{"edge_id": "record:257", "head": "Darna", "relation": "linked_passage", "tail": "passage:/wiki/Darna_(2009_TV_series)", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 11, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Darna_(2009_TV_series)", "text": "Darna is a Philippine television drama action fantasy series broadcast by GMA Network . The series is based from Mars Ravelo 's fictional superheroine of the same title . Directed by Dominic Zapata and Don Michael Perez , it stars Marian Rivera in the title role . It premiered on August 10 , 2009 on the network 's Telebabad line up replacing Zorro and worldwide on GMA Pinoy TV . The series concluded on February 19 , 2010 with a total of 140 episodes . It was replaced by Panday Kids in its timeslot .", "context_before": ""}], "traversal_from": "passage:/wiki/Darna_(2009_TV_series)", "traversal_to": "Darna", "direction": "reverse"}, {"edge_id": "record:146", "head": "table:Alyssa Alano:row:11", "relation": "title", "tail": "Darna", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 11, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "Darna", "traversal_to": "table:Alyssa Alano:row:11", "direction": "reverse"}, {"edge_id": "record:141", "head": "2009", "relation": "has_record", "tail": "table:Alyssa Alano:row:11", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 11, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "table:Alyssa Alano:row:11", "traversal_to": "2009", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Darna --linked_passage--> passage:/wiki/Darna_(2009_TV_series) [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:Alyssa Alano:row:11 --title--> Darna [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "2009 --has_record--> table:Alyssa Alano:row:11 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.5778}}, {"path_id": "grounded_641", "score": 9.5778, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.7778, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Full_House_(2009_TV_series)", "Full House", "table:Alyssa Alano:row:12", "2009"], "edges": [{"edge_id": "record:259", "head": "Full House", "relation": "linked_passage", "tail": "passage:/wiki/Full_House_(2009_TV_series)", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 12, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Full_House_(2009_TV_series)", "text": "Full House is a Philippine television drama romance comedy series broadcast by GMA Network . The series is adaptation of a 2004 Korean television series of the same title . Directed by Mark A. Reyes , it stars Richard Gutierrez and Heart Evangelista . It premiered on November 30 , 2009 on the network 's Telebabad line up replacing Rosalinda and worldwide on GMA Pinoy TV . The series concluded on February 26 , 2010 with a total of 65 episodes . It was replaced by Diva in its timeslot .", "context_before": "Rosalinda is a 2009 Philippine television drama romance series broadcast by GMA Network . The series is based on the 1999 television series of the same title . Directed by Maryo J. de los Reyes and Gil Tejada Jr. , it stars Carla Abellana in the title role and Geoff Eigenmann . It premiered on July 6 , 2009 on the network 's Telebabad line up replacing Totoy Bato . The series concluded on November 27 , 2009 with a total of 105 episodes . It was replaced by Full House in its timeslot . Darna is a Philippine television drama action fantasy series broadcast by GMA Network . The series is based from Mars Ravelo 's fictional superheroine of the same title . Directed by Dominic Zapata and Don Michael Perez , it stars Marian Rivera in the title role . It premiered on August 10 , 2009 on the network 's Telebabad line up replacing Zorro and worldwide on GMA Pinoy TV . The series concluded on February 19 , 2010 with a total of 140 episodes . It was replaced by Panday Kids in its timeslot ."}], "traversal_from": "passage:/wiki/Full_House_(2009_TV_series)", "traversal_to": "Full House", "direction": "reverse"}, {"edge_id": "record:160", "head": "table:Alyssa Alano:row:12", "relation": "title", "tail": "Full House", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 12, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "Full House", "traversal_to": "table:Alyssa Alano:row:12", "direction": "reverse"}, {"edge_id": "record:155", "head": "2009", "relation": "has_record", "tail": "table:Alyssa Alano:row:12", "source_type": "table", "source_id": "Alyssa Alano", "row_index": 12, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "table:Alyssa Alano:row:12", "traversal_to": "2009", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Full House --linked_passage--> passage:/wiki/Full_House_(2009_TV_series) [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:Alyssa Alano:row:12 --title--> Full House [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "2009 --has_record--> table:Alyssa Alano:row:12 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": nul