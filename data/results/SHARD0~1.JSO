contexts": [{"source_id": "/wiki/Hubei", "text": "Hubei ( 湖北 ; formerly Hupeh ) is a landlocked province in Central China . The name of the province means north of the lake , referring to its position north of Dongting Lake . The provincial capital , Wuhan , serves as a major transportation hub and the political , cultural , and economic hub of Central China . Hubeis name is officially abbreviated to 鄂 ( È ) , an ancient name associated with the eastern part of the province since the State of E of the Western Zhou dynasty of c. 1045 - 771 BCE ; a popular name for Hubei is 楚 ( Chǔ ) ( suggested by that of the powerful State of Chu , which existed in the area during the Eastern Zhou dynasty of 770 - 256 BCE ) . The province borders Henan to the north , Anhui to the east , Jiangxi to the southeast , Hunan to the south , Chongqing to the west , and Shaanxi to the northwest . The high-profile Three Gorges Dam is located at Yichang , in the west of the province .", "context_before": ""}], "traversal_from": "passage:/wiki/Hubei", "traversal_to": "Hubei", "direction": "reverse"}, {"edge_id": "semantic:79:0", "head": "Hubei", "relation": "of_china_s_tujia_population", "tail": "2.17%", "source_type": "table", "source_id": "Tujia people", "source_group": null, "row_index": 18, "column_name": "% of China 's Tujia Population", "header_path": ["% of China 's Tujia Population"], "structural": false, "contexts": [], "traversal_from": "Hubei", "traversal_to": "2.17%", "direction": "forward"}, {"edge_id": "record:318", "head": "table:Tujia people:row:19:cell:% of China 's Tujia Population", "relation": "cell_value", "tail": "2.17%", "source_type": "table", "source_id": "Tujia people", "row_index": 19, "column_name": "% of China 's Tujia Population", "header_path": ["% of China 's Tujia Population"], "structural": true, "cell_node": true, "traversal_from": "2.17%", "traversal_to": "table:Tujia people:row:19:cell:% of China 's Tujia Population", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Hubei --linked_passage--> passage:/wiki/Hubei [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Hubei --of_china_s_tujia_population--> 2.17%", "depends_on": 1}, {"step": 3, "goal": "table:Tujia people:row:19:cell:% of China 's Tujia Population --cell_value--> 2.17% [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.85, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 25.8714}}, {"path_id": "answer_evidence_record_389", "score": 183.0, "score_components": {"reverse_answer_match": 183.0}, "nodes": ["Wufeng", "passage:/wiki/Wufeng_Tujia_Autonomous_County"], "edges": [{"edge_id": "record:389", "head": "Wufeng", "relation": "linked_passage", "tail": "passage:/wiki/Wufeng_Tujia_Autonomous_County", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "County", "header_path": ["County"], "structural": true, "contexts": [{"source_id": "/wiki/Wufeng_Tujia_Autonomous_County", "text": "Wufeng Tujia Autonomous County ( simplified Chinese : 五峰土家族自治县 ; traditional Chinese : 五峰土家族自治縣 ; pinyin : Wǔfēng Tǔjiāzú Zìzhìxiàn ) , formerly Changle County ( Changlo County 長樂縣 ) , is a county in the west of Hubei province , People 's Republic of China , bordering Hunan province to the south . It is under the administration of the prefecture-level city of Yichang . It is twinned with Westfield , Massachusetts , United States . [ citation needed ]", "context_before": "Changyang Tujia Autonomous County ( simplified Chinese : 长阳土家族自治县 ; traditional Chinese : 長陽土家族自治縣 ; pinyin : Chángyáng Tǔjiāzú Zìzhìxiàn ) or in Tujia language known as Changryangf Bifzivkar Zivzirxianf is an autonomous county in western Hubei province , People 's Republic of China . It is under the administration of the prefecture-level city of Yichang . The county is located in the basin of the Qing River , a right tributary of the Yangtze . The river is flanked by mountains on both sides , the tallest of which - the Tianzhu Mountain - is 2,542 metres ( 8,340 ft ) tall . The river is dammed by the Geheyan Dam ( located within the county ) and the Gaoba Dam ( located in the neighboring Yidu County-level City , but flooding some of the Qingjiang River valley within Changyang County as well ) . The resulting reservoirs provide the main water transportation route throughout much of the county . Established in 1984 with a surface area of 3,412 square kilometres ( 1,317 sq mi ) and a population in 1984 of 399,000 inhabitants , of which 295,000 were Tujia . Xiushan Tujia and Miao Autonomous County ( Chinese : 秀山土家族苗族自治县 ; pinyin : Xiùshān Tǔjiāzú Miáozú Zìzhìxiàn ) , or Xiushan County for short , is located in the southeast of Chongqing Municipality , China . It is the municipality 's southernmost county-level division ."}]}], "steps": [{"step": 1, "goal": "Wufeng --linked_passage--> passage:/wiki/Wufeng_Tujia_Autonomous_County", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 183.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_390", "score": 183.0, "score_components": {"reverse_answer_match": 183.0}, "nodes": ["Wufeng Tujia Autonomous County", "passage:/wiki/Wufeng_Tujia_Autonomous_County"], "edges": [{"edge_id": "record:390", "head": "Wufeng Tujia Autonomous County", "relation": "linked_passage", "tail": "passage:/wiki/Wufeng_Tujia_Autonomous_County", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "County", "header_path": ["County"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Wufeng_Tujia_Autonomous_County", "text": "Wufeng Tujia Autonomous County ( simplified Chinese : 五峰土家族自治县 ; traditional Chinese : 五峰土家族自治縣 ; pinyin : Wǔfēng Tǔjiāzú Zìzhìxiàn ) , formerly Changle County ( Changlo County 長樂縣 ) , is a 