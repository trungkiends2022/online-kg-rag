on the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "1984 Summer Olympics --linked_passage--> /wiki/1984_Summer_Olympics", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_56", "best_path_score": 8.8513, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12233, "llm_response_chars": 7, "llm_latency_ms": 67973.46, "wall_time_ms": 69171.6, "non_llm_time_ms": 1198.14, "input_tokens": null, "output_tokens": null, "exact_match": 1.0, "semantic_exact_match": 1.0, "f1": 1.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": null, "is_ambiguous": null, "ambiguity_status": null}
