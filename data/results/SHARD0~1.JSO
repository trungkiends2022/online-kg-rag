l_from": "table:Germany at the 2006 Winter Olympics:row:10", "traversal_to": "Daniela Anschütz-Thoms Lucille Opitz Claudia Pechstein Sabine Völker Anni Friesinger", "direction": "forward"}, {"edge_id": "record:447", "head": "Daniela Anschütz-Thoms Lucille Opitz Claudia Pechstein Sabine Völker Anni Friesinger", "relation": "linked_passage", "tail": "passage:/wiki/Sabine_Völker", "source_type": "table", "source_id": "Germany at the 2006 Winter Olympics", "row_index": 10, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Sabine_Völker", "text": "Sabine Völker ( born 11 May 1973 ) is a German former speed skater who won a gold medal in the women 's team pursuit at the 2006 Winter Olympics , after winning three individual medals at the 2002 Winter Olympics in Salt Lake City .", "context_before": "Lucille Opitz ( born 24 November 1977 ) is a German speed skater who won a gold medal in the women 's team pursuit at the 2006 Winter Olympics . Claudia Pechstein ( born 22 February 1972 ) is a German speed skater . She has won five Olympic gold medals . With a total of nine Olympic medals , five gold , two silver and two bronze , she was the most successful Olympic speed skater , male or female , of all-time , until the gold medal of Ireen Wüst in the 2018 Winter Olympics of PyeongChang , and also the most successful German Winter Olympian of all-time . After the World Championships in Norway in February 2009 , Pechstein was accused of blood doping and banned from all competitions for two years ."}], "traversal_from": "Daniela Anschütz-Thoms Lucille Opitz Claudia Pechstein Sabine Völker Anni Friesinger", "traversal_to": "passage:/wiki/Sabine_Völker", "direction": "forward"}], "steps": [{"step": 1, "goal": "Gold --has_record--> table:Germany at the 2006 Winter Olympics:row:10", "depends_on": null}, {"step": 2, "goal": "table:Germany at the 2006 Winter Olympics:row:10 --name--> Daniela Anschütz-Thoms Lucille Opitz Claudia Pechst