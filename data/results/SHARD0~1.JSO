na:row:9", "relation": "city_or_town", "tail": "table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9:cell:City or town", "source_type": "table", "source_id": "National Register of Historic Places listings in Georgetown County, South Carolina", "row_index": 9, "column_name": "City or town", "header_path": ["City or town"], "structural": true, "cell_node": true, "cell_value": "Pawleys Island", "traversal_from": "table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9", "traversal_to": "table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9:cell:City or town", "direction": "forward"}], "steps": [{"step": 1, "goal": "Cedar Grove Plantation Chapel --linked_passage--> /wiki/Cedar_Grove_Plantation_Chapel [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9 --name_on_the_register--> Cedar Grove Plantation Chapel [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9 --city_or_town--> table:National Register of Historic Places listings in Georgetown County, South Carolina:row:9:cell:City or town", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.2167}}, {"path_id": "answer_evidence_record_403", "score": 182.0, "score_components": {"reverse_answer_match": 182.0}, "nodes": ["Pawleys Island", "passage:/wiki/Pawleys_Island,_South_Carolina"], "edges": [{"edge_id": "record:403", "head": "Pawleys Island", "relation": "linked_passage", "tail": "passage:/wiki/Pawleys_Island,_South_Carolina", "source_type": "table", "source_id": "National Register of Historic Places listings in Georgetown County, South Carolina", "row_index": 0, "column_name": "City or town", "header_path": ["City or town"], "structural": true, "contexts": [{"source_id": "/wiki/Pawleys_Island,_South_Carolina", "text": "Pawleys Island is a town in Georgetown County , South Carolina , United States , and the Atlantic coast barrier island on which the town is located . Pawleys Island 's population was 103 at the 2010 census , down from 138 in 2000 . The post office address also includes an unincorporated area on the mainland adjacent to the island , which includes a commercial district along the Ocean Highway ( US Route 17 ) and a residential area between the highway and the Waccamaw River . The island is on the southern end of The Grand Strand and is one of the oldest resort areas of the US East Coast . The town of Pawleys Island , though , is only on the island . The island lies off the Waccamaw Neck , a long , narrow peninsula between the ocean and the river , and is connected to the mainland by two bridges , the North Causeway and the South Causeway .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Pawleys Island --linked_passage--> passage:/wiki/Pawleys_Island,_South_Carolina", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 182.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_404", "score": 182.0, "score_components": {"reverse_answer_match": 182.0}, "nodes": ["Pawleys Island, South Carolina", "passage:/wiki/Pawleys_Island,_South_Carolina"], "edges": [{"edge_id": "record:404", "head": "Pawleys Island, South Carolina", "relation": "linked_passage", "tail": "passage:/wiki/Pawleys_Island,_South_Carolina", "source_type": "table", "source_id": "National Register of Historic Places listings in Georgetown County, South Carolina", "row_index": 0, "column_name": "City or town", "header_path": ["City or town"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Pawleys_Island,_South_Carolina", "text": "Pawleys Island is a town in Georgetown County , South Carolina , United States , and the Atlantic coast barrier island on which the town is located . Pawleys Island 's population was 103 at the 2010 census , down from 138 in 2000 . The post office address also includes an unincorporated area on the mainland adjacent to the island , which includes a commercial district along the Ocean Highway ( US Route 17 ) and a residential area between the highway and the Waccamaw River . The island is on the southern end of The Grand Strand and is one of the oldest resort areas of the US East Coast . The town of Pawleys Island , though , is only on the island . The island lies off the Waccamaw Neck , a long , narrow peninsula between the ocean and the river , and is connected to the mainland by two bridges , the North Causeway and the South Causeway .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Pawleys Island, South Carolina --linked_passage--> passage:/wiki/Pawleys_Island,_South_Carolina", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 182.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_466", "score": 182.0, "score_components": {"reverse_answer_match": 182.0}, "nodes": ["Pawleys Island", "passage:/wiki/Pawleys_Island,_South_Carolina"], "edges": [{"edge_id": "record:466", "head": "Pawleys Island", "relation": "linked_passage", "tail": "passage:/wiki/Pawleys_Island,_South_Carolina", "source_type": "table", "source_id": "National Register of Historic Places listings in Georgetown County, South Carolina", "row_index": 9, "column_name": "City or town", "header_path": ["City or town"], "structural": true, "contexts": [{"source_id": "/wiki/Pawleys_Island,_South_Carolina", "text": "Pawleys Island is a town in Georgetown County , South Carolina , United States , and the Atlantic coast barrier island on which the town is located . Pawleys Island 's population was 103 at the 2010 census , down from 138 in 2000 . The post office address also includes an unincorporated area on the mainland adjacent to the island , which includes a commercial district along the Ocean Highway ( US Route 17 ) and a residential area between the highway and the Waccamaw River . The island is on the southern end of The Grand Strand and is one of the oldest resort areas of the US East Coast . The town of Pawleys Island , though , is only on the island . The island lies off the Waccamaw Neck , a long , narrow peninsula between the ocean and the river , and is connected to the mainland by two bridges , the North Causeway and the South Causeway .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Pawleys Island --linked_passage--> passage:/wiki/Pawleys_Island,_South_Carolina", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 182.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_621", "best_path_score": 17.3, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12407, "llm_response_chars": 14, "llm_latency_ms": 39030.24, "wall_time_ms": 79085.03, "non_llm_time_ms": 40054.79, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
