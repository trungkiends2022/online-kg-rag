table", "source_id": "California Historical Landmarks in Santa Cruz County, California", "row_index": 1, "column_name": "City or town", "header_path": ["City or town"], "structural": true, "traversal_from": "table:California Historical Landmarks in Santa Cruz County, California:row:1", "traversal_to": "Watsonville", "direction": "forward"}, {"edge_id": "semantic:11:0", "head": "Watsonville", "relation": "linked_passage", "tail": "/wiki/Watsonville,_California", "source_type": "table", "source_id": "California Historical Landmarks in Santa Cruz County, California", "source_group": null, "row_index": 1, "column_name": "City or town", "header_path": ["City or town"], "structural": false, "contexts": [{"source_id": "/wiki/Watsonville,_California", "text": "Watsonville is a city in Santa Cruz County , California , United States . The population was 51,199 according to the 2010 census . Located on the central coast of California , the economy centers predominantly around farming and food processing . It is known for growing strawberries , apples , lettuce and a host of other vegetables . Watsonville is home to people of varied ethnic backgrounds . There is a large Hispanic population , as well as groups of Croatians , Filipinos , Portuguese , Sikhs , and Japanese who live and work in the city . The Pajaro Valley , where Watsonville is located , has a climate that is around 60 to 70 degrees Fahrenheit throughout much of the year . This climate makes Watsonville an attractive coastal environment for the neighboring inland communities with very hot summers . The Pajaro Valley Unified School District has an attendance of about 18,000 students kindergarten through 12th grades . There are several private religious-based schools in Watsonville such as Notre Dame School , Monte Vista Christian , Salesian Sisters , and St. Francis . There are also several charter schools and the non-religious independent Pre-K through 12th grade Mount Madonna School . These schools provide a wide range of educational options for local families .", "context_before": ""}], "traversal_from": "Watsonville", "traversal_to": "/wiki/Watsonville,_California", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:California Historical Landmarks in Santa Cruz County, California:row:1 --landmark_name--> Castro Adobe [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:California Historical Landmarks in Santa Cruz County, California:row:1 --city_or_town--> Watsonville", "depends_on": 1}, {"step": 3, "goal": "Watsonville --linked_passage--> /wiki/Watsonville,_California", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 19.7697}}, {"path_id": "row_1_9", "score": 15.0576, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 1.0909, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 5.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["998", "table:California Historical Landmarks in Santa Cruz County, California:row:1", "Castro Adobe", "passage:/wiki/Castro_Adobe"], "edges": [{"edge_id": "record:17", "head": "998", "relation": "has_record", "tail": "table:California Historical Landmarks in Santa Cruz County, California:row:1", "source_type": "table", "source_id": "California Historical Landmarks in Santa Cruz County, California", "row_index": 1, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "998", "traversal_to": "table:California Historical Landmarks in Santa 