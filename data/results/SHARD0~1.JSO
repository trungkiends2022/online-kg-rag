], "question_term_coverage": 0.7222, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.0308}, "grounded_299": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7222, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.0308}}}, "reasoning_paths": [{"path_id": "grounded_196", "score": 14.4923, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.6923, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Gold", "table:Germany at the 2012 European Athletics Championships:row:1", "David Storl", "passage:/wiki/David_Storl"], "edges": [{"edge_id": "record:13", "head": "Gold", "relation": "has_record", "tail": "table:Germany at the 2012 European Athletics Championships:row:1", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 1, "column_name": "Medal", "header_path": ["Medal"], "structural": true, "traversal_from": "Gold", "traversal_to": "table:Germany at the 2012 European Athletics Championships:row:1", "direction": "forward"}, {"edge_id": "record:18", "head": "table:Germany at the 2012 European Athletics Championships:row:1", "relation": "name", "tail": "David Storl", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:Germany at the 2012 European Athletics Championships:row:1", "traversal_to": "David Storl", "direction": "forward"}, {"edge_id": "record:224", "head": "David Storl", "relation": "linked_passage", "tail": "passage:/wiki/David_Storl", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/David_Storl", "text": "David Storl ( born 27 July 1990 ) is a German track and field athlete who specialises in the shot put . He was successful on the youth and junior athletics circuit , winning gold medals at the World Youth Championships and World Junior Championships . Storl won his first senior medal , a silver , at the 2011 European Athletics Indoor Championships . He held the world junior record of 22.73 m with the 6 kg shot . His personal best with the senior implement is 22.20 m. He won the gold medal in the shot put competition at the 2011 World Championships in Athletics , and the Silver Medal at the 2012 Summer Olympics . Storl is one of only nine athletes ( along with Valerie Adams , Usain Bolt , Veronica Campbell-Brown , Jacques Freitag , Yelena Isinbayeva , Kirani James , Jana Pittman , and Dani Samuels ) to win world championships at the youth , junior , and senior level of an athletic event . Storl uses the glide technique for shot putting .", "context_before": ""}], "traversal_from": "David Storl", "traversal_to": "passage:/wiki/David_Storl", "direction": "forward"}], "steps": [{"step": 1, "goal": "Gold --has_record--> table:Germany at the 2012 European Athletics Championships:row:1", "depends_on": null}, {"step": 2, "goal": "table:Germany at the 2012 European Athletics Championships:row:1 --name--> David Storl", "depends_on": 1}, {"step": 3, "goal": "David Storl --linked_passage--> passage:/wiki/David_Storl", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8333, "table_witness_indices": [], "linked_witness": false, "num