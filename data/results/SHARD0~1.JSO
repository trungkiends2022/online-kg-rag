, "column_name": "Competition", "header_path": ["Competition"], "structural": true, "contexts": [{"source_id": "/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "text": "The 2017 USA Track and Field Outdoor Championships were held at Hornet Stadium on the campus of California State University , Sacramento in Sacramento , California . Organized by USA Track & Field , the four-day competition took place June 22-25 and served as the national championships in track and field for the United States . The event was held in conjunction with the USA Track & Field Junior Outdoor Championships . The 50 kilometers race walk was held January 28 at Santee , California . While no men were able to make the 4:06 qualifying standard , two women were able to achieve their 4:30 qualifying time , with Katie Burnett walking faster than the second place man . The other qualifier was former world record holder Erin Taylor-Talcott . 2017 is the first year the women will be allowed to race that distance at the world championships .", "context_before": ""}], "traversal_from": "passage:/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "traversal_to": "USA Outdoor Track and Field Championships", "direction": "reverse"}, {"edge_id": "record:26", "head": "table:Will Claye:row:1", "relation": "competition", "tail": "USA Outdoor Track and Field Championships", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Competition", "header_path": ["Competition"], "structural": true, "traversal_from": "USA Outdoor Track and Field Championships", "traversal_to": "table:Will Claye:row:1", "direction": "reverse"}, {"edge_id": "record:21", "head": "2017", "relation": "has_record", "tail": "table:Will Claye:row:1", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "table:Will Claye:row:1", "traversal_to": "2017", "direction": "reverse"}], "steps": [{"step": 1, "goal": 