lub based in Lisbon . Founded in 1981 by employees of the newspaper Correio da Manhã , the club was better known for its futsal team whose greater successes included two Portuguese Futsal League wins and one Portuguese Futsal Cup . The futsal team ceased playing after the 2003-04 season ceding its spot in the league to Estrela da Amadora .", "context_before": ""}], "traversal_from": "Correio da Manhã", "traversal_to": "passage:/wiki/Grupo_Desportivo_e_Cultural_do_Correio_da_Manhã", "direction": "forward"}], "steps": [{"step": 1, "goal": "1994-95 --has_record--> table:Campeonato Nacional da I Divisão de Futsal:row:4", "depends_on": null}, {"step": 2, "goal": "table:Campeonato Nacional da I Divisão de Futsal:row:4 --runners_up--> Correio da Manhã", "depends_on": 1}, {"step": 3, "goal": "Correio da Manhã --linked_passage--> passage:/wiki/Grupo_Desportivo_e_Cultural_do_Correio_da_Manhã", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 23.5083}}, {"path_id": "grounded_1040", "score": 17.175, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 2.0, "text_context_match": 1.0, "query_coverage": 1.375, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["/wiki/Grupo_Desportivo_e_Cultural_do_Correio_da_Manhã", "Correio da Manhã", "table:Campeonato Nacional da I Divisão de Futsal:row:4", "table:Campeonato Nacional da I Divisão de Futsal:row:4:cell:Season"], "edges": [{"edge_id": "semantic:39:0", "head": "Correio da Manhã", "relation": "lin