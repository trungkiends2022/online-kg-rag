p": 1, "goal": "Steven Scott & Stevan Walton --linked_passage--> passage:/wiki/Steven_Scott [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:England at the 2010 Commonwealth Games (medalists):row:4 --name--> Steven Scott & Stevan Walton [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:England at the 2010 Commonwealth Games (medalists):row:4 --sport--> Shooting", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 20.1667}}, {"path_id": "answer_evidence_record_418", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Athletics", "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games"], "edges": [{"edge_id": "record:418", "head": "Athletics", "relation": "linked_passage", "tail": "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "source_type": "table", "source_id": "England at the 2010 Commonwealth Games (medalists)", "row_index": 11, "column_name": "Sport", "header_path": ["Sport"], "structural": true, "contexts": [{"source_id": "/wiki/Athletics_at_the_2010_Commonwealth_Games", "text": "The athletics competition at the 2010 Commonwealth Games was held in New Delhi , India between 6 and 14 October . The track and field events took place between 6-12 October at the Jawaharlal Nehru Stadium while the marathon contests were held on a street course running through the city on 14 October . A total of 46 athletics events were contested , which made it the sport with the second greatest number of medals on offer after the aquatics competition . The programme was almost identical to that of the 2006 edition , with the sole exception being the men 's 50 km race walk , which was dropped . As in 2006 , three men 's and three women 's disability athletics events were contested alongside the open competition . Each of the Commonwealth Games Associations could send a maximum of three participants per event and a team of six for relay events . Kenya topped the medal table , with eleven gold medals and 29 medals in total . This was the first time that the nation achieved the feat , beating the typically dominant nations Australia ( eleven golds , but 20 overall ) and England ( seven golds , 26 medals ) . Canada and Jamaica rounded out the top five while hosts India enjoyed their greatest ever haul at the Games , taking home two golds and eleven medals altogether . Four failed doping tests have so far been announced : Nigerian Oludamola Osayomi was stripped of the women 's 100 m title , and her compatriot Samuel Okon , a 110 m hurdler , was also disqualified . Both athletes tested positive for methylhexanamine . Rani Yadav , India 's representative in the women 's 20 km walk , was the third athlete to fail a test as 19-Norandrosterone was detected in her sample .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Athletics --linked_passage--> passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_419", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Athletics at the 2010 Commonwealth Games", "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games"], "edges": [{"edge_id": "record:419", "head": "Athletics at the 2010 Commonwealth Games", "relation": "linked_passage", "tail": "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "source_type": "table", "source_id": "England at the 2010 Commonwealth Games (medalists)", "row_index": 11, "column_name": "Sport", "header_path": ["Sport"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Athletics_at_the_2010_Commonwealth_Games", "text": "The athletics competition at the 2010 Commonwealth Games was held in New Delhi , India between 6 and 14 October . The track and field events took place between 6-12 October at the Jawaharlal Nehru Stadium while the marathon contests were held on a street course running through the city on 14 October . A total of 46 athletics events were contested , which made it the sport with the second greatest number of medals on offer after the aquatics competition . The programme was almost identical to that of the 2006 edition , with the sole exception being the men 's 50 km race walk , which was dropped . As in 2006 , three men 's and three women 's disability athletics events were contested alongside the open competition . Each of the Commonwealth Games Associations could send a maximum of three participants per event and a team of six for relay events . Kenya topped the medal table , with eleven gold medals and 29 medals in total . This was the first time that the nation achieved the feat , beating the typically dominant nations Australia ( eleven golds , but 20 overall ) and England ( seven golds , 26 medals ) . Canada and Jamaica rounded out the top five while hosts India enjoyed their greatest ever haul at the Games , taking home two golds and eleven medals altogether . Four failed doping tests have so far been announced : Nigerian Oludamola Osayomi was stripped of the women 's 100 m title , and her compatriot Samuel Okon , a 110 m hurdler , was also disqualified . Both athletes tested positive for methylhexanamine . Rani Yadav , India 's representative in the women 's 20 km walk , was the third athlete to fail a test as 19-Norandrosterone was detected in her sample .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Athletics at the 2010 Commonwealth Games --linked_passage--> passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_438", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Athletics", "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games"], "edges": [{"edge_id": "record:438", "head": "Athletics", "relation": "linked_passage", "tail": "passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "source_type": "table", "source_id": "England at the 2010 Commonwealth Games (medalists)", "row_index": 15, "column_name": "Sport", "header_path": ["Sport"], "structural": true, "contexts": [{"source_id": "/wiki/Athletics_at_the_2010_Commonwealth_Games", "text": "The athletics competition at the 2010 Commonwealth Games was held in New Delhi , India between 6 and 14 October . The track and field events took place between 6-12 October at the Jawaharlal Nehru Stadium while the marathon contests were held on a street course running through the city on 14 October . A total of 46 athletics events were contested , which made it the sport with the second greatest number of medals on offer after the aquatics competition . The programme was almost identical to that of the 2006 edition , with the sole exception being the men 's 50 km race walk , which was dropped . As in 2006 , three men 's and three women 's disability athletics events were contested alongside the open competition . Each of the Commonwealth Games Associations could send a maximum of three participants per event and a team of six for relay events . Kenya topped the medal table , with eleven gold medals and 29 medals in total . This was the first time that the nation achieved the feat , beating the typically dominant nations Australia ( eleven golds , but 20 overall ) and England ( seven golds , 26 medals ) . Canada and Jamaica rounded out the top five while hosts India enjoyed their greatest ever haul at the Games , taking home two golds and eleven medals altogether . Four failed doping tests have so far been announced : Nigerian Oludamola Osayomi was stripped of the women 's 100 m title , and her compatriot Samuel Okon , a 110 m hurdler , was also disqualified . Both athletes tested positive for methylhexanamine . Rani Yadav , India 's representative in the women 's 20 km walk , was the third athlete to fail a test as 19-Norandrosterone was detected in her sample .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Athletics --linked_passage--> passage:/wiki/Athletics_at_the_2010_Commonwealth_Games", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_487", "best_path_score": 17.0, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12101, "llm_response_chars": 12, "llm_latency_ms": 3448.81, "wall_time_ms": 15497.87, "non_llm_time_ms": 12049.06, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
