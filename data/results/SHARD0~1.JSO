header_path": ["Team"], "structural": true, "contexts": [{"source_id": "/wiki/LSU_Tigers_basketball", "text": "The LSU Tigers basketball team represents Louisiana State University in NCAA Division I men 's college basketball . The Tigers are currently coached by head coach Will Wade . They play their home games in the Pete Maravich Assembly Center located on the LSU campus in Baton Rouge , Louisiana . The team participates in the Southeastern Conference .", "context_before": ""}], "traversal_from": "LSU Tiger", "traversal_to": "passage:/wiki/LSU_Tigers_basketball", "direction": "forward"}], "steps": [{"step": 1, "goal": "Brendan Suhr --has_record--> table:Fairfield Stags men's basketball:row:7", "depends_on": null}, {"step": 2, "goal": "table:Fairfield Stags men's basketball:row:7 --team--> LSU Tiger", "depends_on": 1}, {"step": 3, "goal": "LSU Tiger --linked_passage--> passage:/wiki/LSU_Tigers_basketball", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 10.5}}, {"path_id": "row_8_29", "score": 7.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 0.25, "query_coverage": 0.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Keith Urgo", "table:Fairfield Stags men's basketball:row:8", "Penn State Nittany Lions", "passage:/wiki/Penn_State_Nittany_Lions_basketball"], "edges": [{"edge_id": "record:102", "head": "Keith Urgo", "relation": "has_record", "tail": "table:Fairfield Stags men's basketball:row:8", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 8, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Keith Urgo", "traversal_to": "table:Fairfield Stags men's basketball:row:8", "direction": "forward"}, {"edge_id": "record:113", "head": "table:Fairfield Stags men's basketball:row:8", "relation": "team", "tail": "Penn State Nittany Lions", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 8, "column_name": "Team", "header_path": ["Team"], "structural": true, "traversal_from": "table:Fairfield Stags men's basketball:row:8", "traversal_to": "Penn State Nittany Lions", "direction": "forward"}, {"edge_id": "record:147", "head": "Penn State Nittany Lions", "relation": "linked_passage", "tail": "passage:/wiki/Penn_State_Nittany_Lions_basketball", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 8, "column_name": "Team", "header_path": ["Team"], "structural": true, "contexts": [{"source_id": "/wiki/Penn_State_Nittany_Lions_basketball", "text": "The Penn State Nittany Lions basketball team is a NCAA Division I college basketball team representing the Pennsylvania State University . They are a member of the Big Ten Conference and play home games at the 15,261-seat Bryce Jordan Center , moving there from Rec Hall during the 1995-96 season . Their student cheering section is known as the Legion Of Blue . The program has nine NCAA tournament appearances with its best finish coming in 1954 , reaching the Final Four . Its most recent appearance was in 2011 , when the team lost to the Temple Owls in the round of 64 . The program also has 11 appearances in the National Invitation Tournament , with the most recent being in 2018 , when they beat Utah to win the NIT championship . They also won the NIT championship in 2009 .", "context_before": ""}], "traversal_from": "Penn State Nittany Lions", "traversal_to": "passage:/wiki/Penn_State_Nittany_Lions_basketball", "direction": "forward"}], "steps": [{"step": 1, "goal": "Keith Urgo --has_record--> table:Fairfield Stags men's basketball:row:8", "depends_on": null}, {"step": 2, "goal": "table:Fairfield Stags men's basketball:row:8 --team--> Penn State Nittany Lions", "depends_on": 1}, {"step": 3, "goal": "Penn State Nittany Lions --linked_passage--> passage:/wiki/Penn_State_Nittany_Lions_basketball", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 9.85}}, {"path_id": "row_6_21", "score": 6.55, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.25, "query_coverage": 0.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Tim O'Toole", "table:Fairfield Stags men's basketball:row:6", "California Golden Bears", "passage:/wiki/California_Golden_Bears_men's_basketball"], "edges": [{"edge_id": "record:76", "head": "Tim O'Toole", "relation": "has_record", "tail": "table:Fairfield Stags men's basketball:row:6", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 6, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Tim O'Toole", "traversal_to": "table:Fairfield Stags men's basketball:row:6", "direction": "forward"}, {"edge_id": "record:87", "head": "table:Fairfield Stags men's basketball:row:6", "relation": "team", "tail": "California Golden Bears", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 6, "column_name": "Team", "header_path": ["Team"], "structural": true, "traversal_from": "table:Fairfield Stags men's basketball:row:6", "traversal_to": "California Golden Bears", "direction": "forward"}, {"edge_id": "record:142", "head": "California Golden Bears", "relation": "linked_passage", "tail": "passage:/wiki/California_Golden_Bears_men's_basketball", "source_type": "table", "source_id": "Fairfield Stags men's basketball", "row_index": 6, "column_name": "Team", "header_path": ["Team"], "structural": true, "contexts": [{"source_id": "/wiki/California_Golden_Bears_men's_basketball", "text": "The California Golden Bears basketball team is the college basketball team of the University of California , Berkeley . The program has seen success throughout the years , culminating in a national championship in 1959 under coach Pete Newell , and the team has reached the final four two other times , in 1946 and 1960 . The current head coach is Mark Fox , who began his tenure at Cal in 2019 . The team plays its home games at Haas Pavilion , which was long known as Harmon Gym before being heavily renovated with money donated in part by the owners of Levi Strauss & Co . The arena was originally known as Men 's Gymnasium and then later Harmon Gymnasium until the late 1990s when it went through renovations which displaced the team for two seasons .", "context_before": ""}], "traversal_from": "California Golden Bears", "traversal_to": "passage:/wiki/California_Golden_Bears_men's_basketball", "direction": "forward"}], "steps": [{"step": 1, "goal": "Tim O'Toole --has_record--> table:Fairfield Stags men's basketball:row:6", "depends_on": null}, {"step": 2, "goal": "table:Fairfield Stags men's basketball:row:6 --team--> California Golden Bears", "depends_on": 1}, {"step": 3, "goal": "California Golden Bears --linked_passage--> passage:/wiki/California_Golden_Bears_men's_basketball", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": []