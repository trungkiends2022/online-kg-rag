], "question_term_coverage": 0.9375, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.6031}, "grounded_102": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9375, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.4531}}}, "reasoning_paths": [{"path_id": "grounded_206", "score": 13.9212, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.4545, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Admiral Football Club", "table:2013 FKF Division One:row:1", "Mombasa", "passage:/wiki/Mombasa"], "edges": [{"edge_id": "record:9", "head": "Admiral Football Club", "relation": "has_record", "tail": "table:2013 FKF Division One:row:1", "source_type": "table", "source_id": "2013 FKF Division One", "row_index": 1, "column_name": "Club", "header_path": ["Club"], "structural": true, "traversal_from": "Admiral Football Club", "traversal_to": "table:2013 FKF Division One:row:1", "direction": "forward"}, {"edge_id": "record:17", "head": "table:2013 FKF Division One:row:1", "relation": "town_city", "tail": "Mombasa", "source_type": "table", "source_id": "2013 FKF Division One", "row_index": 1, "column_name": "Town / City", "header_path": ["Town / City"], "structural": true, "traversal_from": "table:2013 FKF Division One:row:1", "traversal_to": "Mombasa", "direction": "forward"}, {"edge_id": "record:111", "head": "Mombasa", "relation": "linked_passage", "tail": "passage:/wiki/Mombasa", "source_type": "table", "source_id": "2013 FKF Division One", "row_index": 1, "column_name": "Town / City", "header_path": ["Town / City"], "structural": true, "contexts": [{"source_id": "/wiki/Mombasa", "text": "Mombasa ( /mɒmˈbæsə/ mom-BASS-ə , also US : /-ˈbɑːs-/ -⁠BAH-sə ) is a coastal city of Kenya along the Indian Ocean . The city is known as the white and blue city in Kenya . It is the country 's oldest ( circa 900 AD ) and second-largest city ( after the capital Nairobi ) , with a population of about 1,208,333 people according to the 2019 census . Its metropolitan region is the second largest in the country and has a population of 3,528,940 people . Mombasa is a regional cultural and economic hub ; it has an extra-large port and an international airport , and is an important regional tourism center . Located on the east coast of Kenya , it also is the home of one of the State House ( Kenya ) , and is considered by some as a second capital in all but name . In 2018 the local government released an edict in which the city was painted white with blue accents and the old town was painted yellow . In Mombasa County and the former Coast Province , Mombasa 's situation on the Indian Ocean made it a historical trading center , and it has been controlled by many countries because of its strategic location .", "context_before": ""}], "traversal_from": "Mombasa", "traversal_to": "passage:/wiki/Mombasa", "direction": "forward"}], "steps": [{"step": 1, "goal": "Admiral Football Club --has_record--> table:2013 FKF Division One:row:1", "depends_on": null}, {"step": 2, "goal": "table:2013 FKF Division One:row:1 --town_city--> Mombasa", "depends_on": 1}, {"step": 3, "goal": "Mombasa --linked_passage--> passage:/wiki/Mombasa", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.875, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 17.9212}}, {"path_id": "grounded_100", "score": 12.6031, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.6364, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Admiral Football Club", "Mombasa", "passage:/wiki/Mombasa", "Its metropolitan region is the second largest in the country and"], "edges": [{"edge_id": "semantic:53:0", "head": "Admiral Football Club", "relation": "based_in", "tail": "Mombasa", "source_type": "text", "source_id": "/wiki/Admiral_F.C.", "source_group": "rule_text", "row_index": null, "column_name": null, "header_path": null, "structural": false, "contexts": [{"source_id": "/wiki/Admiral_F.C.", "text": "Admiral Football Club is an association football club based in Mombasa , Kenya . The team competes in FKF Division One and plays its home games at the Apostle Grounds .", "context_before": "The Administration Police ( abbreviated as A.P . ) is a paramilitary security organ belonging to National Police Service of the Republic of Kenya . It was formed in 1958 when it took over from the Tribal Police , which had been established through an ordinance in 1929 . The Administration Police is a department under the Ministry of Interior and Coordination of National Government . Its headquarters are in Nairobi . The PC Chapter 63 of the Laws of Kenya states that the Police Force includes the force defined in section 2 of the Police Act as well as the Administration Police Force established under the Administration Police Act ; Chapter 75 Section 2 states that the term Police officer means either/both a Police officer and/or an Administration Police officer . The Administration Police force is headed by Deputy Inspector of Police ( DIG ) Noor Gabow OGW . The Administration Police has five major units : Nairobi ( /naɪˈroʊbi/ ) is the capital and the largest city of Kenya . The name comes from the Maasai phrase Enkare Nairobi , which translates to cool water , a reference to the Nairobi River which flows through the city . The city proper had a population of 4,397,073 in the 2019 census , while the metropolitan area has a population of 9,354,580 . The city is popularly referred to as the Green City in the Sun . Nairobi was founded in 1899 by the colonial authorities in British East Africa , as a rail depot on the Uganda Railway . The town quickly grew to replace Mombasa as the capital of Kenya in 1907 . After independence in 1963 , Nairobi became the capital of the Republic of Kenya . During Kenya 's colonial period , the city became a centre for the colony 's coffee , tea and sisal industry . [ citation needed ] The city lies on the River Athi in the southern part of the country , and has an elevation of 1,795 metres ( 5,889 ft ) above sea level . According to the 2019 census , in the administrative area of Nairobi , 4,397,073 inhabitants lived within 696 km2 ( 269 sq mi ) . Home to thousands of Kenyan businesses and over 100 major international companies and organizations , including the United Nations Environment Programme ( UN Environment ) and the United Nations Office at Nairobi ( UNON ) , Nairobi is an established hub for business and culture . The Nairobi Securities Exchange ( NSE ) is one of the largest in Africa and the second-oldest exchange on the continent ."}], "traversal_from": "Admiral Football Club", "traversal_to": "Mombasa", "direction": "forward"}, {"edge_id": "record:128", "head": "Mombasa", "relation": "linked_passage", "tail": "passage:/wiki/Mombasa", "source_type": "table", "source_id": "2013 FKF Division One", "row_index": 11, "column_name": "Town / City", "header_path": ["Town / City"], "structural": true, "contexts": [{"source_id": "/wiki/Mombasa", "text": "Mombasa ( /mɒmˈbæsə/ mom-BASS-ə , also US : /-ˈbɑːs-/ -⁠BAH-sə ) is a coastal city of Kenya along the Indian Ocean . The city is known as the white and blue city in Kenya . It is the country 's oldest ( circa 900 AD ) and second-largest city ( after the capital Nairobi ) , with a population of about 1,208,333 people according to the 2019 census . Its metropolitan region is the second largest in the country and has a population of 3,528,940 people . Mombasa is a regional cultural and economic hub ; it has an extra-large port and an international airport , and is an important regional tourism center . Located on the east coast of Kenya , it also is the home of one of the State House ( Kenya ) , and is considered by some as a second capital in all but name . In 2018 the local government released an edict in which the city was painted white with blue accents and the old town was painted yellow . In Mombasa County and the former Coast Province , Mombasa 's situation on the Indian Ocean made it a historical trading center , and it has been controlled by many countries because of its strategic location .", "context_before": ""}], "traversal_from": "Mombasa", "traversal_to": "passage:/wiki/Mombasa", "direction": "forward"}, {"edge_id": "record:129", "head": "passage:/wiki/Mombasa", "relation": "mentions", "tail": "Its metropolitan region is the second largest in the country and", "source_type": "text", "source_id": "/wiki/Mombasa", "row_index": null, "column_name": null, "header_path": null, "structural": true, "contexts": [{"source_id": "/wiki/Mombasa", "text": "Mombasa ( /mɒmˈbæsə/ mom-BASS-ə , also US : /-ˈbɑːs-/ -⁠BAH-sə ) is a coastal city of Kenya along the Indian Ocean . The city is known as the white and blue city in Kenya . It is the country 's oldest ( circa 900 AD ) and second-largest city ( after the capital Nairobi ) , with a population of about 1,208,333 people according to the 2019 census . Its metropolitan region is the second largest in the country and has a population of 3,528,940 people . Mombasa is a regional cultural and economic hub ; it has an extra-large port and an international airport , and is an important regional tourism center . Located on the east coast of Kenya , it also is the home of one of the State House ( Kenya ) , and is considered by some as a second capital in all but name . In 2018 the local government released an edict in which the city was painted white with blue accents and the old town was painted yellow . In Mombasa County and the former Coast Province , Mombasa 's situation on the Indian Ocean made it a historical trading center , and it has been controlled by many countries because of its strategic location .", "context_before": ""}], "traversal_from": "passage:/wiki/Mombasa", "traversal_to": "Its metropolitan region is the second largest in the country and", "direction": "forward"}], "steps": [{"step": 1, "goal": "Admiral Football Club --based_in--> Mombasa", "depends_on": null}, {"step": 2, "goal": "Mombasa --linked_passage--> passage:/wiki/Mombasa", "depends_on": 1}, {"step": 3, "goal": "passage:/wiki/Mombasa --mentions--> Its metropolitan region is the second largest in the country and", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9375, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.6031}}, {"path_id": "grounded_94", "score": 12.6031, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.6364, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "