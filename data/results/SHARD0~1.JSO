0, "text_context_match": 1.0, "query_coverage": 1.2308, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 5.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Assassin's_Creed_(video_game)", "Assassin 's Creed", "table:Kristen Bell:row:0", "2007"], "edges": [{"edge_id": "record:72", "head": "Assassin 's Creed", "relation": "linked_passage", "tail": "passage:/wiki/Assassin's_Creed_(video_game)", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Assassin's_Creed_(video_game)", "text": "Assassin 's Creed is an action-adventure video game developed by Ubisoft Montreal and published by Ubisoft . It is the first installment in the Assassin 's Creed series . The game was released for PlayStation 3 and Xbox 360 in November 2007 and was made available on Microsoft Windows in April 2008 . Also , the game can be played on Xbox One consoles via backward compatibility . The plot is set in a fictional history of real-world events and follows the centuries-old struggle between the Assassins , who fight for peace with free will , and the Templars , who desire peace through control . The game primarily takes place during the Third Crusade in the Holy Land in 1191 , with the plot revolving around the Secret Order of Assassins , based upon the Hashshashin sect . The player is , in reality , playing as a modern-day man named Desmond Miles , who , through the use of a machine named the Animus , is allowed the viewing and controlling of the protagonist 's genetic memories of his ancestors , in this case , Altaïr Ibn-La'Ahad , a member of the Assassins . Through this plot device , details emerge of a struggle between two factions : the Knights Templar and the Assassins , over an artifact known as the Apple of Eden , an ancient artifact used to control minds . The game received generally positive reviews , with critics praising its storytelling , visuals , art design , and originality , although the game was also criticized for the repetitive nature of its gameplay . Assassin 's Creed won several awards at E3 in 2006 , as well as several end-year awards after its release . The game spawned a sequel , Assassin 's Creed II , which was released in November 2009 . Since the release and success of Assassin 's Creed II , subsequent games have been released , with various other Assassins and time periods .", "context_before": ""}], "traversal_from": "passage:/wiki/Assassin's_Creed_(video_game)", "traversal_to": "Assassin 's Creed", "direction": "reverse"}, {"edge_id": "record:5", "head": "table:Kristen Bell:row:0", "relation": "title", "tail": "Assassin 's Creed", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "Assassin 's Creed", "traversal_to": "table:Kristen Bell:row:0", "direction": "reverse"}, {"edge_id": "record:0", "head": "2007", "relation": "has_record", "tail": "table:Kristen Bell:row:0", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "table:Kristen Bell:row:0", "traversal_to": "2007", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Assassin 's Creed --linked_passage--> passage:/wiki/Assassin's_Creed_(video_game) [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:Kristen Bell:row:0 --title--> Assassin 's Creed [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "2007 --has_record--> table:Kristen Bell:row:0 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 26.0308}}, {"path_id": "grounded_32", "score": 21.0308, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.2308, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 5.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["2007", "table:Kristen Bell:row:0", "Assassin 's Creed", "passage:/wiki/Assassin's_Creed_(video_game)"], "edges": [{"edge_id": "record:0", "head": "2007", "relation": "has_record", "tail": "table:Kristen Bell:row:0", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "2007", "traversal_to": "table:Kristen Bell:row:0", "direction": "forward"}, {"edge_id": "record:5", "head": "table:Kristen Bell:row:0", "relation": "title", "tail": "Assassin 's Creed", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "table:Kristen Bell:row:0", "traversal_to": "Assassin 's Creed", "direction": "forward"}, {"edge_id": "record:72", "head": "Assassin 's Creed", "relation": "linked_passage", "tail": "passage:/wiki/Assassin's_Creed_(video_game)", "source_type": "table", "source_id": "Kristen Bell", "row_index": 0, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Assassin's_Creed_(video_game)", "text": "Assassin 's Creed is an action-adventure video game developed by Ubisoft Montreal and published by Ubisoft . It is the first installment in the Assassin 's Creed series . The game was released for PlayStation 3 and Xbox 360 in November 2007 and was made available on Microsoft Windows in April 2008 . Also , the game can be played on Xbox One consoles via backward compatibility . The plot is set in a fictional history of real-world events and follows the centuries-old struggle between the Assassins , who fight for peace with free will , and the Templars , who desire peace through control . The game primarily takes place during the Third Crusade in the Holy Land in 1191 , with the plot revolving around the Secret Order of Assassins , based upon the Hashshashin sect . The player is , in reality , playing as a modern-day man named Desmond Miles , who , through the use of a machine named the Animus , is allowed the viewing and controlling of the protagonist 's genetic memories of his ancestors , in this case , Altaïr Ibn-La'Ahad , a member of the Assassins . Through this plot device , details emerge of a struggle between two factions : the Knights Templar and the Assassins , over an artifact known as the Apple of Eden , an ancient artifact used to control minds . The game received generally positive reviews , with critics praising its storytelling , visuals , art design , and originality , although the game was also criticized for the repetitive nature of its gameplay . Assassin 's Creed won several awards at E3 in 2006 , as well as several end-year awards after its release . The game spawned a sequel , Assassin 's Creed II , which was released in November 2009 . Since the release and success of Assassin 's Creed II , subsequent games have been released , with various other Assassins and time periods .", "context_before": ""}], "traversal_from": "Assassin 's Creed", "traversal_to": "passage:/wiki/Assassin's_Creed_(video_game)", "direction": "forward"}], "steps": [{"step": 1, "goal": "2007 --has_record--> table:Kristen Bell:row:0", "depends_on": null}, {"step": 2, "goal": "t