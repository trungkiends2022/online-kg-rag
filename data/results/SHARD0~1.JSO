_238"], "rejected_path_ids": [], "abstained_for_missing_grounding": false, "pre_answer_path_selection": false, "verification_by_path": {"grounded_237": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 13.6}, "grounded_239": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 13.6}, "grounded_235": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.6}, "grounded_236": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.6}, "grounded_238": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.6}}}, "reasoning_paths": [{"path_id": "grounded_237", "score": 7.1, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 0.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Leon_Hart", "Leon Hart", "table:1946 Notre Dame Fighting Irish football team:row:3", "End"], "edges": [{"edge_id": "record:82", "head": "Leon Hart", "relation": "linked_passage", "tail": "passage:/wiki/Leon_Hart", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Leon_Hart", "text": "Leon Joseph Hart ( November 2 , 1928 - September 24 , 2002 ) was an American football end . He won the Heisman Trophy and the Maxwell Award while at the University of Notre Dame in 1949 and played in the National Football League ( NFL ) for eight seasons , from 1950 to 1957 , with the Detroit Lions . Hart is the only lineman to win three college football national championships and three NFL Championships . He is the last of only two lineman ever to win the Heisman Trophy . Also , he is one of three players , along with Angelo Bertelli and Cam Newton , to win the Heisman Trophy , a national championship , and be the first overall pick in the NFL draft all in the same one-year span .", "context_before": "Zygmont Ziggy Peter Czarobski ( September 13 , 1922 - July 1 , 1984 ) was an American football player . He played at the tackle position for the Notre Dame Fighting Irish ( 1942-1943 ; 1946-1947 ) and in the National Football League ( NFL ) for the Chicago Rockets ( 1948 ) and Chicago Hornets ( 1949 ) . He was inducted into the College Football Hall of Fame in 1977 . Czarobski was born on the South Side of Chicago in 1922 and attended Mount Carmel High School . He began his college football career playing at the tackle position for the University of Notre Dame from 1942 to 1943 , but he then missed the 1944 and 1945 seasons due to military service . He returned to Notre Dame for the 1946 to 1947 seasons . At the end of the 1947 season , Czarobski was selected as a first-team All-American by the Newspaper Enterprise Association ( NEA ) and the International News Service ( INS ) . He was selected as a second-team All-American by the Associated Press and a third-team All-American by the United Press . Czarobski also played professional football in the NFL for the Chicago Rockets in 1948 and Chicago Hornets in 1949 . He appeared in a total of 26 games in the NFL . Czaraobski was inducted into the College Football Hall of Fame in 1977 . He was also inducted into the National Polish-American Sports Hall of Fame in 1984 . William Anton Moose Fischer ( March 10 , 1927 - January 20 , 2017 ) was an American football lineman who played professionally in the National Football League ( NFL ) for the Chicago Cardinals , from 1949 to 1953 . He was a first-round pick by the Chicago Cardinals in the 1949 NFL Draft . With the Cardinals , he was invited to three Pro Bowls . He played college football at the University of Notre Dame , where he won two national championships , was twice named a consensus All-American in 1947 and 1948 , and was awarded the Outland Trophy as the nation 's top lineman in 1948 . Fischer returned to Notre Dame after his playing career , serving as an assistant coach under Terry Brennan , from 1954 to 1958 . He also served as president of the Notre Dame Monogram Club in 1982 . In 1983 , he was inducted into the National Football Foundation Hall of Fame . Fischer died on January 20 , 2017 , in Cape Coral , Florida ."}], "traversal_from": "passage:/wiki/Leon_Hart", "traversal_to": "Leon Hart", "direction": "reverse"}, {"edge_id": "record:29", "head": "Leon Hart", "relation": "has_record", "tail": "table:1946 Notre Dame Fighting Irish football team:row:3", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Leon Hart", "traversal_to": "table:1946 Notre Dame Fighting Irish football team:row:3", "direction": "forward"}, {"edge_id": "record:34", "head": "table:1946 Notre Dame Fighting Irish football team:row:3", "relation": "position", "tail": "End", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Position", "header_path": ["Position"], "structural": true, "traversal_from": "table:1946 Notre Dame Fighting Irish football team:row:3", "traversal_to": "End", "direction": "forward"}], "steps": [{"step": 1, "goal": "Leon Hart --linked_passage--> passage:/wiki/Leon_Hart [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Leon Hart --has_record--> table:1946 Notre Dame Fighting Irish football team:row:3", "depends_on": 1}, {"step": 3, "goal": "table:1946 Notre Dame Fighting Irish football team:row:3 --position--> End", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 13.6}}, {"path_id": "grounded_239", "score": 7.1, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 0.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Leon_Hart", "Leon Hart", "table:1946 Notre Dame Fighting Irish football team:row:3", "1973"], "edges": [{"edge_id": "record:82", "head": "Leon Hart", "relation": "linked_passage", "tail": "passage:/wiki/Leon_Hart", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Leon_Hart", "text": "Leon Joseph Hart ( November 2 , 1928 - September 24 , 2002 ) was an American football end . He won the Heisman Trophy and the Maxwell Award while at the University of Notre Dame in 1949 and played in the National Football League ( NFL ) for eight seasons , from 1950 to 1957 , with the Detroit Lions . Hart is the only lineman to win three college football national championships and three NFL Championships . He is the last of only two lineman ever to win the Heisman Trophy . Also , he is one of three players , along with Angelo Bertelli and Cam Newton , to win the Heisman Trophy , a national championship , and be the first overall pick in the NFL draft all in the same one-year span .", "context_before": "Zygmont Ziggy Peter Czarobski ( September 13 , 1922 - July 1 , 1984 ) was an American football player . He played at the tackle position for the Notre Dame Fighting Irish ( 1942-1943 ; 1946-1947 ) and in the National Football League ( NFL ) for the Chicago Rockets ( 1948 ) and Chicago Hornets ( 1949 ) . He was inducted into the College Football Hall of Fame in 1977 . Czarobski was born on the South Side of Chicago in 1922 and attended Mount Carmel High School . He began his college football career playing at the tackle position for the University of Notre Dame from 1942 to 1943 , but he then missed the 1944 and 1945 seasons due to military service . He returned to Notre Dame for the 1946 to 1947 seasons . At the end of the 1947 season , Czarobski was selected as a first-team All-American by the Newspaper Enterprise Association ( NEA ) and the International News Service ( INS ) . He was selected as a second-team All-American by the Associated Press and a third-team All-American by the United Press . Czarobski also played professional football in the NFL for the Chicago Rockets in 1948 and Chicago Hornets in 1949 . He appeared in a total of 26 games in the NFL . Czaraobski was inducted into the College Football Hall of Fame in 1977 . He was also inducted into the National Polish-American Sports Hall of Fame in 1984 . William Anton Moose Fischer ( March 10 , 1927 - January 20 , 2017 ) was an American football lineman who played professionally in the National Football League ( NFL ) for the Chicago Cardinals , from 1949 to 1953 . He was a first-round pick by the Chicago Cardinals in the 1949 NFL Draft . With the Cardinals , he was invited to three Pro Bowls . He played college football at the University of Notre Dame , where he won two national championships , was twice named a consensus All-American in 1947 and 1948 , and was awarded the Outland Trophy as the nation 's top lineman in 1948 . Fischer returned to Notre Dame after his playing career , serving as an assistant coach under Terry Brennan , from 1954 to 1958 . He also served as president of the Notre Dame Monogram Club in 1982 . In 1983 , he was inducted into the National Football Foundation Hall of Fame . Fischer died on January 20 , 2017 , in Cape Coral , Florida ."}], "traversal_from": "passage:/wiki/Leon_Hart", "traversal_to": "Leon Hart", "direction": "reverse"}, {"edge_id": "record:29", "head": "Leon Hart", "relation": "has_record", "tail": "table:1946 Notre Dame Fighting Irish football team:row:3", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Leon Hart", "traversal_to": "table:1946 Notre Dame Fighting Irish football team:row:3", "direction": "forward"}, {"edge_id": "record:37", "head": "table:1946 Notre Dame Fighting Irish football team:row:3", "relation": "year_inducted", "tail": "1973", "source_type": "table", "source_id": "1946 Notre Dame Fighting Irish football team", "row_index": 3, "column_name": "Year Inducted", "header_path": ["Year Inducted"], "structural": true, "traversal_from": "table:1946 Notre Dame Fighting Irish football team:row:3", "traversal_to": "1973", "direction": "forward"}], "steps": [{"step": 1, "goal": "Leon Hart --linked_passage--> passage:/wiki/Leon_Hart [traverse reverse]", "depends_on": null}, {"step": 2, 