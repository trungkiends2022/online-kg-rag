header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/Coochbehar", "text": "Cooch Behar ( /ˌkuːtʃ bɪˈhɑːr/ ) or Koch Bihar is a city and a municipality in the Indian state of West Bengal . It is the headquarters of the Cooch Behar district . It is in the foothills of the Eastern Himalayas at 26°22′N 89°29′E / 26.367°N 89.483°E / 26.367 ; 89.483 . Cooch Behar is the only planned city in North Bengal region with remnants of royal heritage . Being one of the main tourist destinations of West Bengal , housing the Cooch Behar Palace and Madan Mohan Temple , it has been declared a heritage city . It is the maternal home of Maharani Gayatri Devi . During the British Raj , Cooch Behar was the seat of the princely state of Koch Bihar , ruled by the Koch dynasty of Assam . After 20 August 1949 , Cooch Behar District was transformed from a princely state to its present status , with the city of Cooch Behar as its headquarters .", "context_before": ""}], "traversal_from": "Coochbehar", "traversal_to": "passage:/wiki/Coochbehar", "direction": "forward"}], "steps": [{"step": 1, "goal": "Coochbehar Government Medical College and Hospital --has_record--> table:List of institutions of higher education in West Bengal:row:5", "depends_on": null}, {"step": 2, "goal": "table:List of institutions of higher education in West Bengal:row:5 --city--> Coochbehar", "depends_on": 1}, {"step": 3, "goal": "Coochbehar --linked_passage--> passage:/wiki/Coochbehar", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7273, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.9667}}, {"path_id": "answer_evidence_semantic_60_0", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Coochbehar", "/wiki/Coochbehar"], "edges": [{"edge_id": "semantic:60:0", "head": "Coochbehar", "relation": "linked_passage", "tail": "/wiki/Coochbehar", "source_type": "table", "source_id": "List of institutions of higher education in West Bengal", "source_group": null, "row_index": 5, "column_name": "City", "header_path": ["City"], "structural": false, "contexts": [{"source_id": "/wiki/Coochbehar", "text": "Cooch Behar ( /ˌkuːtʃ bɪˈhɑːr/ ) or Koch Bihar is a city and a municipality in the Indian state of West Bengal . It is the headquarters of the Cooch Behar district . It is in the foothills of the Eastern Himalayas at 26°22′N 89°29′E / 26.367°N 89.483°E / 26.367 ; 89.483 . Cooch Behar is the only planned city in North Bengal region with remnants of royal heritage . Being one of the main tourist destinations of West Bengal , housing the Cooch Behar Palace and Madan Mohan Temple , it has been declared a heritage city . It is the maternal home of Maharani Gayatri Devi . During the British Raj , Cooch Behar was the seat of the princely state of Koch Bihar , ruled by the Koch dynasty of Assam . After 20 August 1949 , Cooch Behar District was transformed from a princely state to its present status , with the city of Cooch Behar as its headquarters .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Coochbehar --linked_passage--> /wiki/Coochbehar", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_1631", "best_path_score": 16.2167, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12861, "llm_response_chars": 18, "llm_latency_ms": 54573.49, "wall_time_ms": 78641.4, "non_llm_time_ms": 24067.91, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.8, "execution_exact_