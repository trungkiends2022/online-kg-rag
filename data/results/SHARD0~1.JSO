hard_failures": [], "question_term_coverage": 0.7333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 16.406}}}, "reasoning_paths": [{"path_id": "grounded_1984", "score": 11.406, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.2727, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/San_Diego_State_University", "Gamma-Lambda / San Diego State University", "table:List of Tau Kappa Epsilon brothers:row:14", "Fred Dryer"], "edges": [{"edge_id": "record:506", "head": "Gamma-Lambda / San Diego State University", "relation": "linked_passage", "tail": "passage:/wiki/San_Diego_State_University", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Original chapter", "header_path": ["Original chapter"], "structural": true, "contexts": [{"source_id": "/wiki/San_Diego_State_University", "text": "San Diego State University ( SDSU ) is a public research university in San Diego , California . Founded in 1897 as San Diego Normal School , it is the third-oldest university in the 23-member California State University ( CSU ) system . SDSU has a Fall 2019 student body of 35,081 and an alumni base of more than 300,000 . It is classified among Doctoral Universities : High Research Activity . In the 2015-16 fiscal year , the university obtained $ 130 million in public and private funding - a total of 707 awards - up from $ 120.6 million the previous fiscal year . As reported by the Faculty Scholarly Productivity Index released by the Academic Analytics organization of Stony Brook , New York , SDSU is the number one small research university in the United States in 2006 and 2007 . SDSU sponsors the second-highest number of Fulbright Scholars in the State of California , just behind UC Berkeley . Since 2005 , the university has produced over 65 Fulbright student scholars . The university generates over $ 2.4 billion annually for the San Diego economy , while 60 percent of SDSU graduates remain in San Diego , making SDSU a primary educator of the region 's work force . Committed to serving the diverse San Diego region , SDSU ranks among the top ten universities nationwide in terms of ethnic and racial diversity among its student body , as well as the number of bachelor 's degrees conferred upon minority students . San Diego State University consistently ranks in the top 500 universities in the world , and according to Forbes , is among the top 93rd percentile of public colleges in the United States . San Diego State University is a member of the Western Association of Schools and Colleges , the American Association of State Colleges and Universities , and the Association of Public and Land-grant Universities .", "context_before": ""}], "traversal_from": "passage:/wiki/San_Diego_State_University", "traversal_to": "Gamma-Lambda / San Diego State University", "direction": "reverse"}, {"edge_id": "record:223", "head": "table:List of Tau Kappa Epsilon brothers:row:14", "relation": "original_chapter", "tail": "Gamma-Lambda / San Diego State University", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Original chapter", "header_path": ["Original chapter"], "structural": true, "traversal_from": "Gamma-Lambda / San Diego State University", "traversal_to": "table:List of Tau Kappa Epsilon brothers:row:14", "direction": "reverse"}, {"edge_id": "record:218", "head": "Fred Dryer", "relation": "has_record", "tail": "table:List of Tau Kappa Epsilon brothers:row:14", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of Tau Kappa Epsilon brothers:row:14", "traversal_to": "Fred Dryer", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Gamma-Lambda / San Diego State University --linked_passage--> passage:/wiki/San_Diego_State_University [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of Tau Kappa Epsilon brothers:row:14 --original_chapter--> Gamma-Lambda / San Diego State University [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Fred Dryer --has_record--> table:List of Tau Kappa Epsilon brothers:row:14 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 16.406}}, {"path_id": "grounded_2035", "score": 11.406, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.2727, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/San_Diego_State_University", "Gamma-Lambda", "table:List of Tau Kappa Epsilon brothers:row:14", "Fred Dryer"], "edges": [{"edge_id": "record:507", "head": "Gamma-Lambda", "relation": "linked_passage", "tail": "passage:/wiki/San_Diego_State_University", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Original chapter", "header_path": ["Original chapter"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/San_Diego_State_University", "text": "San Diego State University ( SDSU ) is a public research university in San Diego , California . Founded in 1897 as San Diego Normal School , it is the third-oldest university in the 23-member California State University ( CSU ) system . SDSU has a Fall 2019 student body of 35,081 and an alumni base of more than 300,000 . It is classified among Doctoral Universities : High Research Activity . In the 2015-16 fiscal year , the university obtained $ 130 million in public and private funding - a total of 707 awards - up from $ 120.6 million the previous fiscal year . As reported by the Faculty Scholarly Productivity Index released by the Academic Analytics organization of Stony Brook , New York , SDSU is the number one small research university in the United States in 2006 and 2007 . SDSU sponsors the second-highest number of Fulbright Scholars in the State of California , just behind UC Berkeley . Since 2005 , the university has produced over 65 Fulbright student scholars . The university generates over $ 2.4 billion annually for the San Diego economy , while 60 percent of SDSU graduates remain in San Diego , making SDSU a primary educator of the region 's work force . Committed to serving the diverse San Diego region , SDSU ranks among the top ten universities nationwide in terms of ethnic and racial diversity among its student body , as well as the number of bachelor 's degrees conferred upon minority students . San Diego State University consistently ranks in the top 500 universities in the world , and according to Forbes , is among the top 93rd percentile of public colleges in the United States . San Diego State University is a member of the Western Association of Schools and Colleges , the American Association of State Colleges and Universities , and the Association of Public and Land-grant Universities .", "context_before": ""}], "traversal_from": "passage:/wiki/San_Diego_State_University", "traversal_to": "Gamma-Lambda", "direction": "reverse"}, {"edge_id": "record:224", "head": "table:List of Tau Kappa Epsilon brothers:row:14", "relation": "original_chapter", "tail": "Gamma-Lambda", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Original chapter", "header_path": ["Original chapter"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Gamma-Lambda", "traversal_to": "table:List of Tau Kappa Epsilon brothers:row:14", "direction": "reverse"}, {"edge_id": "record:218", "head": "Fred Dryer", "relation": "has_record", "tail": "table:List of Tau Kappa Epsilon brothers:row:14", "source_type": "table", "source_id": "List of Tau Kappa Epsilon brothers", "row_index": 14, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of Tau Kappa Epsilon brothers:row:14", "traversal_to": "Fred Dryer", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Gamma-Lambda --linked_passage--> passage:/wiki/San_Diego_State_University [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of Tau Kappa Epsilon brothers:row:14 --original_chapter--> Gamma-Lambda [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Fred Dryer --has_record--> table:List of Tau Kappa Epsilon brothers:row:14 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 16.406}}, {"path_id": "grounded_2072", "score": 11.406, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 1.3333, "text_context_match": 1.0, "query_coverage": 1.2727, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.