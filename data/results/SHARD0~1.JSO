lures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.8513}}}, "reasoning_paths": [{"path_id": "grounded_56", "score": 8.8513, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3846, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Karamoke Kory Konte", "table:List of flag bearers for Mali at the Olympics:row:6", "1984", "/wiki/1984_Summer_Olympics"], "edges": [{"edge_id": "record:90", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "flag_bearer", "tail": "Karamoke Kory Konte", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "Karamoke Kory Konte", "traversal_to": "table:List of flag bearers for Mali at the Olympics:row:6", "direction": "reverse"}, {"edge_id": "record:83", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "event_year", "tail": "1984", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "traversal_from": "table:List of flag bearers for Mali at the Olympics:row:6", "traversal_to": "1984", "direction": "forward"}, {"edge_id": "semantic:32:0", "head": "1984", "relation": "linked_passage", "tail": "/wiki/1984_Summer_Olympics", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "source_group": null, "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": false, "contexts": [{"source_id": "/wiki/1984_Summer_Olympics", "text": "The 1984 Summer Olympics , officially known as the Games of the XXIII Olympiad , was an international multi-sport event that was held from July 28 to August 12 , 1984 , in Los Angeles , California , United States ( and other venues around the United States ) . This was the second time that Los Angeles had hosted the Games , the first being in 1932 . California was the home state of then-U.S. President Ronald Reagan , who officially opened the Games . The logo for the 1984 Games , branded Stars in Motion , featured red , white and blue stars arranged horizontally and struck through with alternating streaks . The official mascot of the Games was Sam the Olympic Eagle . These were the first Summer Olympic Games under the IOC presidency of Juan Antonio Samaranch . The 1984 Games were boycotted by a total of fourteen Eastern Bloc countries , including the Soviet Union and East Germany , in response to the American-led boycott of the previous 1980 Summer Olympics in Moscow in protest of the Soviet invasion of Afghanistan ; Romania was the only Eastern Bloc nation that opted to attend the Games . Iran and Libya also chose to boycott the Games for unrelated reasons . Despite the field being depleted in certain sports due to the boycott , 140 National Olympic Committees took part , which was a record at the time . The United States won the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million .", "context_before": ""}], "traversal_from": "1984", "traversal_to": "/wiki/1984_Summer_Olympics", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --flag_bearer--> Karamoke Kory Konte [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --event_year--> 1984", "depends_on": 1}, {"step": 3, "goal": "1984 --linked_passage--> /wiki/1984_Summer_Olympics", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 13.8513}}, {"path_id": "row_7_29", "score": 9.3898, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 0.9231, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1", "table:List of flag bearers for Mali at the Olympics:row:7", "Namakoro Niaré", "passage:/wiki/Namakoro_Niaré"], "edges": [{"edge_id": "record:91", "head": "1", "relation": "has_record", "tail": "table:List of flag bearers for Mali at the Olympics:row:7", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 7, "column_name": "#", "header_path": ["#"], "structural": true, "traversal_from": "1", "traversal_to": "table:List of flag bearers for Mali at the Olympics:row:7", "direction": "forward"}, {"edge_id": "record:103", "head": "table:List of flag bearers for Mali at the Olympics:row:7", "relation": "flag_bearer", "tail": "Namakoro Niaré", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 7, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "table:List of flag bearers for Mali at the Olympics:row:7", "traversal_to": "Namakoro Niaré", "direction": "forward"}, {"edge_id": "record:125", "head": "Namakoro Niaré", "relation": "linked_passage", "tail": "passage:/wiki/Namakoro_Niaré", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 7, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "contexts": [{"source_id": "/wiki/Namakoro_Niaré", "text": "Namakoro Niaré ( born 4 June 1943 in Bamako ) is a Malian former discus thrower who competed in the 1968 Summer Olympics , in the 1972 Summer Olympics , and in the 1980 Summer Olympics . He is the father of French shot putter Yves Niaré and French High Jumper Gaëlle Niaré .", "context_before": "The 1984 Summer Olympics , officially known as the Games of the XXIII Olympiad , was an international multi-sport event that was held from July 28 to August 12 , 1984 , in Los Angeles , California , United States ( and other venues around the United States ) . This was the second time that Los Angeles had hosted the Games , the first being in 1932 . California was the home state of then-U.S. President Ronald Reagan , who officially opened the Games . The logo for the 1984 Games , branded Stars in Motion , featured red , white and blue stars arranged horizontally and struck through with alternating streaks . The official mascot of the Games was Sam the Olympic Eagle . These were the first Summer Olympic Games under the IOC presidency of Juan Antonio Samaranch . The 1984 Games were boycotted by a total of fourteen Eastern Bloc countries , including the Soviet Union and East Germany , in response to the American-led boycott of the previous 1980 Summer Olympics in Moscow in protest of the Soviet invasion of Afghanistan ; Romania was the only Eastern Bloc nation that opted to attend the Games . Iran and Libya also chose to boycott the Games for unrelated reasons . Despite the field being depleted in certain sports due to the boycott , 140 National Olympic Committees took part , which was a record at the time . The United States won the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million . The 1972 Summer Olympics ( German : Olympische Sommerspiele 1972 ) , officially known as the Games of the XX Olympiad , was an international multi-sport event held in Munich , West Germany , from 26 August to 11 September 1972 . The sporting nature of the event was largely overshadowed by the Munich massacre in the second week , in which eleven Israeli athletes and coaches and a West German police officer at Olympic village were killed by Black September terrorists . The 1972 Summer Olympics were the second Summer Olympics to be held in Germany , after the 1936 Games in Berlin , which had taken place under the Nazi regime . The West German Government had been eager to have the Munich Olympics present a democratic and optimistic Germany to the world , as shown by the Games ' official motto , Die Heiteren Spiele , or the cheerful Games . The logo of the Games was a blue solar logo ( the Bright Sun ) by Otl Aicher , the designer and director of the visual conception commission . The Olympic mascot , the dachshund Waldi , was the first officially named Olympic mascot . The Olympic Fanfare was composed by Herbert Rehbein . The Soviet Union won the most gold and overall medals . The Olympic Park ( Olympiapark ) is based on Frei Otto 's plans and after the Games became a Munich landmark . The competition sites , designed by architect Günther Behnisch , included the Olympic swimming hall , the Olympics Hall ( Olympiahalle , a multipurpose facility ) and the Olympic Stadium ( Olympiastadion ) , and an Olympic village very close to the park . The design of the stadium was considered revolutionary , with sweeping canopies of acrylic glass stabilized by metal ropes , used on such a large scale for the first time ."}], "traversal_from": "Namakoro Niaré", "traversal_to": "passage:/wiki/Namakoro_Niaré", "direction": "forward"}], "steps": [{"step": 1, "goal": "1 --has_record--> table:List of flag bearers for Mali at the Olympics:row:7", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for Mali at the Olympics:row:7 --flag_bearer--> Namakoro Niaré", "depends_on": 1}, {"step": 3, "goal": "Namakoro Niaré --linked_passage--> passage:/wiki/Namakoro_Niaré", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6111, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.3898}}, {"path_id": "row_1_5", "score": 9.2359, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 0.7692, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["7", "table:List of flag bearers for Mali at the Olympics:row:1", "Rahamatou Drame", "passage:/wiki/Rahamatou_Drame"], "edges": [{"edge_id": "record:13", "head": "7", "relation": "has_record", "tail": "table:List of flag bearers for Mali at the Olympics:row:1", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 1, "column_name": "#", "header_path": ["#"], "structural": true, "traversal_from": "7", "traversal_to": "table:List of flag bearers for Mali at the Olympics:row:1", "direction": "forward"}, {"edge_id": "record:25", "head": "table:List of flag bearers for Mali at the Olympics:row:1", "relation": "flag_bearer", "tail": "Rahamatou Drame", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 1, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "table:List of flag bearers for Mali at the Olympics:row:1", "traversal_to": "Rahamatou Drame", "direction": "forward"}, {"edge_id": "record:109", "head": "Rahamatou Drame", "relation": "linked_passage", "tail": "passage:/wiki/Rahamatou_Drame", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 1, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "contexts": [{"source_id": "/wiki/Rahamatou_Drame", "text": "Rahamatou Dramé ( born 1 April 1985 ) is an athlete who competed for Mali at the 2012 Summer Olympics in Women 's 100m Hurdles .", "context_before": "Djénébou Danté ( born 7 August 1989 ) is a Malian athlete specialising in the sprinting events . She represented her country in the 100 metres at the 2011 World Championships . She competed in the Women 's 400 metres at the 2016 Summer Olympics in Rio de Janeiro . She placed 5th in her heat with a time of 52.85 seconds . She was the flagbearer for Mali during the Parade of Nations . She won the gold medal at the 2017 Francophony Games with the time of 52.23 seconds . The 2012 Summer Olympics , formally the Games of the XXX Olympiad and commonly known as London 2012 , was an international multi-sport event that was held from 27 July to 12 August 2012 in London , United Kingdom . The first event , the group stage in women 's football , began on 25 July at the Millennium Stadium in Cardiff , followed by the opening ceremony on 27 July . 10,768 athletes from 204 National Olympic Committees ( NOCs ) participated . Following a bid headed by former Olympic champion Sebastian Coe and then-Mayor of London Ken Livingstone , London was selected as the host city on 6 July 2005 during the 117th IOC Session in Singapore , defeating bids from Moscow , New York City , Madrid , and Paris . London became the first city to host the modern Olympics three times , having previously hosted the Summer Games in 1908 and in 1948 . Construction for the Games involved considerable redevelopment , with an emphasis on sustainability . The main focus was a new 200-hectare ( 490-acre ) Olympic Park , constructed on a former industrial site at Stratford , East London . The Games also made use of venues that already existed before the bid . The Games received general praise for their organisation , with the volunteers , the British military and public enthusiasm praised particularly highly . The opening ceremony , directed by Danny Boyle , received widespread acclaim throughout the world , particular praise from the British public and a minority of widely ranging criticisms from some social media sites . During the Games , Michael Phelps became the most decorated Olympic athlete of all time , winning his 22nd medal . Saudi Arabia , Qatar , and Brunei entered female athletes for the first time , so that every currently eligible country has sent a female competitor to at least one Olympic Games ."}], "traversal_from": "Rahamatou Drame", "traversal_to": "passage:/wiki/Rahamatou_Drame", "direction": "forward"}], "steps": [{"step": 1, "goal": "7 --has_record--> table:List of flag bearers for Mali at the Olympics:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for Mali at the Olympics:row:1 --flag_bearer--> Rahamatou Drame", "depends_on": 1}, {"step": 3, "goal": "Rahamatou Drame --linked_passage--> passage:/wiki/Rahamatou_Drame", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.2359}}, {"path_id": "grounded_55", "score": 8.8513, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3846, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Karamoke Kory Konte", "table:List of flag bearers for Mali at the Olympics:row:6", "1984", "passage:/wiki/1984_Summer_Olympics"], "edges": [{"edge_id": "record:90", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "flag_bearer", "tail": "Karamoke Kory Konte", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "Karamoke Kory Konte", "traversal_to": "table:List of flag bearers for Mali at the Olympics:row:6", "direction": "reverse"}, {"edge_id": "record:83", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "event_year", "tail": "1984", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "traversal_from": "table:List of flag bearers for Mali at the Olympics:row:6", "traversal_to": "1984", "direction": "forward"}, {"edge_id": "record:121", "head": "1984", "relation": "linked_passage", "tail": "passage:/wiki/1984_Summer_Olympics", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "contexts": [{"source_id": "/wiki/1984_Summer_Olympics", "text": "The 1984 Summer Olympics , officially known as the Games of the XXIII Olympiad , was an international multi-sport event that was held from July 28 to August 12 , 1984 , in Los Angeles , California , United States ( and other venues around the United States ) . This was the second time that Los Angeles had hosted the Games , the first being in 1932 . California was the home state of then-U.S. President Ronald Reagan , who officially opened the Games . The logo for the 1984 Games , branded Stars in Motion , featured red , white and blue stars arranged horizontally and struck through with alternating streaks . The official mascot of the Games was Sam the Olympic Eagle . These were the first Summer Olympic Games under the IOC presidency of Juan Antonio Samaranch . The 1984 Games were boycotted by a total of fourteen Eastern Bloc countries , including the Soviet Union and East Germany , in response to the American-led boycott of the previous 1980 Summer Olympics in Moscow in protest of the Soviet invasion of Afghanistan ; Romania was the only Eastern Bloc nation that opted to attend the Games . Iran and Libya also chose to boycott the Games for unrelated reasons . Despite the field being depleted in certain sports due to the boycott , 140 National Olympic Committees took part , which was a record at the time . The United States won the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million .", "context_before": ""}], "traversal_from": "1984", "traversal_to": "passage:/wiki/1984_Summer_Olympics", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --flag_bearer--> Karamoke Kory Konte [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --event_year--> 1984", "depends_on": 1}, {"step": 3, "goal": "1984 --linked_passage--> passage:/wiki/1984_Summer_Olympics", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.8513}}, {"path_id": "grounded_60", "score": 8.8513, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3846, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Karamoke Kory Konte", "table:List of flag bearers for Mali at the Olympics:row:6", "1984 Summer Olympics", "passage:/wiki/1984_Summer_Olympics"], "edges": [{"edge_id": "record:90", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "flag_bearer", "tail": "Karamoke Kory Konte", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "Karamoke Kory Konte", "traversal_to": "table:List of flag bearers for Mali at the Olympics:row:6", "direction": "reverse"}, {"edge_id": "record:84", "head": "table:List of flag bearers for Mali at the Olympics:row:6", "relation": "event_year", "tail": "1984 Summer Olympics", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:List of flag bearers for Mali at the Olympics:row:6", "traversal_to": "1984 Summer Olympics", "direction": "forward"}, {"edge_id": "record:122", "head": "1984 Summer Olympics", "relation": "linked_passage", "tail": "passage:/wiki/1984_Summer_Olympics", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "row_index": 6, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/1984_Summer_Olympics", "text": "The 1984 Summer Olympics , officially known as the Games of the XXIII Olympiad , was an international multi-sport event that was held from July 28 to August 12 , 1984 , in Los Angeles , California , United States ( and other venues around the United States ) . This was the second time that Los Angeles had hosted the Games , the first being in 1932 . California was the home state of then-U.S. President Ronald Reagan , who officially opened the Games . The logo for the 1984 Games , branded Stars in Motion , featured red , white and blue stars arranged horizontally and struck through with alternating streaks . The official mascot of the Games was Sam the Olympic Eagle . These were the first Summer Olympic Games under the IOC presidency of Juan Antonio Samaranch . The 1984 Games were boycotted by a total of fourteen Eastern Bloc countries , including the Soviet Union and East Germany , in response to the American-led boycott of the previous 1980 Summer Olympics in Moscow in protest of the Soviet invasion of Afghanistan ; Romania was the only Eastern Bloc nation that opted to attend the Games . Iran and Libya also chose to boycott the Games for unrelated reasons . Despite the field being depleted in certain sports due to the boycott , 140 National Olympic Committees took part , which was a record at the time . The United States won the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million .", "context_before": ""}], "traversal_from": "1984 Summer Olympics", "traversal_to": "passage:/wiki/1984_Summer_Olympics", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --flag_bearer--> Karamoke Kory Konte [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for Mali at the Olympics:row:6 --event_year--> 1984 Summer Olympics", "depends_on": 1}, {"step": 3, "goal": "1984 Summer Olympics --linked_passage--> passage:/wiki/1984_Summer_Olympics", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.8513}}, {"path_id": "answer_evidence_semantic_37_0", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["Namakoro Niaré", "/wiki/Namakoro_Niaré"], "edges": [{"edge_id": "semantic:37:0", "head": "Namakoro Niaré", "relation": "linked_passage", "tail": "/wiki/Namakoro_Niaré", "source_type": "table", "source_id": "List of flag bearers for Mali at the Olympics", "source_group": null, "row_index": 7, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": false, "contexts": [{"source_id": "/wiki/Namakoro_Niaré", "text": "Namakoro Niaré ( born 4 June 1943 in Bamako ) is a Malian former discus thrower who competed in the 1968 Summer Olympics , in the 1972 Summer Olympics , and in the 1980 Summer Olympics . He is the father of French shot putter Yves Niaré and French High Jumper Gaëlle Niaré .", "context_before": "The 1984 Summer Olympics , officially known as the Games of the XXIII Olympiad , was an international multi-sport event that was held from July 28 to August 12 , 1984 , in Los Angeles , California , United States ( and other venues around the United States ) . This was the second time that Los Angeles had hosted the Games , the first being in 1932 . California was the home state of then-U.S. President Ronald Reagan , who officially opened the Games . The logo for the 1984 Games , branded Stars in Motion , featured red , white and blue stars arranged horizontally and struck through with alternating streaks . The official mascot of the Games was Sam the Olympic Eagle . These were the first Summer Olympic Games under the IOC presidency of Juan Antonio Samaranch . The 1984 Games were boycotted by a total of fourteen Eastern Bloc countries , including the Soviet Union and East Germany , in response to the American-led boycott of the previous 1980 Summer Olympics in Moscow in protest of the Soviet invasion of Afghanistan ; Romania was the only Eastern Bloc nation that opted to attend the Games . Iran and Libya also chose to boycott the Games for unrelated reasons . Despite the field being depleted in certain sports due to the boycott , 140 National Olympic Committees took part , which was a record at the time . The United States won the most gold and overall medals , followed by Romania and West Germany . The 1984 Summer Olympics are widely considered to be the most financially successful modern Olympics and served as an example of how to run the model Olympic Games . As a result of low construction costs , coupled with a reliance on private corporate funding , the 1984 Olympic Games generated a profit of more than $ 250 million . The 1972 Summer Olympics ( German : Olympische Sommerspiele 1972 ) , officially known as the Games of the XX Olympiad , was an international multi-sport event held in Munich , West Germany , from 26 August to 11 September 1972 . The sporting nature of the event was largely overshadowed by the Munich massacre in the second week , in which eleven Israeli athletes and coaches and a West German police officer at Olympic village were killed by Black September terrorists . The 1972 Summer Olympics were the second Summer Olympics to be held in Germany , after the 1936 Games in Berlin , which had taken place under the Nazi regime . The West German Government had been eager to have the Munich Olympics present a democratic and optimistic Germany to the world , as shown by the Games ' official motto , Die Heiteren Spiele , or the cheerful Games . The logo of the Games was a blue solar logo ( the Bright Sun ) by Otl Aicher , the designer and director of the visual conception commission . The Olympic mascot , the dachshund Waldi , was the first officially named Olympic mascot . The Olympic Fanfare was composed by Herbert Rehbein . The Soviet Union won the most gold and overall medals . The Olympic Park ( Olympiapark ) is based on Frei Otto 's plans and after the Games became a Munich landmark . The competition sites , designed by architect Günther Behnisch , included the Olympic swimming hall , the Olympics Hall ( Olympiahalle , a multipurpose facility ) and the Olympic Stadium ( Olympiastadion ) , and an Olympic village very close to the park . The design of the stadium was considered revolutionary , with sweeping canopies of acrylic glass stabilized by metal ropes , used on such a large scale for the first time ."}]}], "steps": [{"step": 1, "goal": "Namakoro Niaré --linked_passage--> /wiki/Namakoro_Niaré", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_