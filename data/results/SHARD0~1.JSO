"source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 1, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "2", "traversal_to": "table:List of highest-grossing Indian films:row:1", "direction": "forward"}, {"edge_id": "record:23", "head": "table:List of highest-grossing Indian films:row:1", "relation": "film", "tail": "Carry on Jatta 2", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 1, "column_name": "Film", "header_path": ["Film"], "structural": true, "traversal_from": "table:List of highest-grossing Indian films:row:1", "traversal_to": "Carry on Jatta 2", "direction": "forward"}, {"edge_id": "record:184", "head": "Carry on Jatta 2", "relation": "linked_passage", "tail": "passage:/wiki/Carry_on_Jatta_2", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 1, "column_name": "Film", "header_path": ["Film"], "structural": true, "contexts": [{"source_id": "/wiki/Carry_on_Jatta_2", "text": "Carry On Jatta 2 is a 2018 Indian Punjabi comedy film directed by Smeep Kang . The film is a sequel to the Carry On Jatta ( 2012 ) . The film stars Gippy Grewal and Sonam Bajwa in lead roles with Gurpreet Ghuggi , Binnu Dhillon , Jaswinder Bhalla , B.N . Sharma , Karamjit Anmol and Upasana Singh and Jyotii Sethi in supporting roles . The film was theatrically released on June 1 , 2018 and turned out to be a commercial success accompanied by critical acclaim . It broke several records at the box office including the worldwide opening weekend record ( earning ₹20.71 million ) , opening day and opening weekend records in various countries except the overseas record of all time collection of Chaar Sahibzaade . Collecting ₹562.7 million ( US $ 7.9 million ) worldwide in its theatrical run makes it highest grossing Punjabi films of all time .", "context_before": "Harry Baweja ( born 1956 ) is an Indian film director based in Mumbai and hails from Ludhiana , Punjab , India . He is married to Indian film producer , Pammi Baweja . Their son , Harman Baweja , made his debut in the film Love Story 2050 . They have their production company Baweja Movies . Baweja Movies Pvt Ltd , is a company which was formed by Director Harry Baweja along with his wife producer Pammi Baweja ."}], "traversal_from": "Carry on Jatta 2", "traversal_to": "passage:/wiki/Carry_on_Jatta_2", "direction": "forward"}], "steps": [{"step": 1, "goal": "2 --has_record--> table:List of highest-grossing Indian films:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of highest-grossing Indian films:row:1 --film--> Carry on Jatta 2", "depends_on": 1}, {"step": 3, "goal": "Carry on Jatta 2 --linked_passage--> passage:/wiki/Carry_on_Jatta_2", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.4167}}, {"path_id": "row_4_22", "score": 8.2667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["5", "table:List of highest-grossing Indian films:row:4", "Angrej", "passage:/wiki/Angrej"], "edges": [{"edge_id": "record:73", "head": "5", "relation": "has_record", "tail": "table:List of highest-grossing Indian films:row:4", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 4, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "5", "traversal_to": "table:List of highest-grossing Indian films:row:4", "direction": "forward"}, {"edge_id": "record:78", "head": "table:List of highest-grossing Indian films:row:4", "relation": "film", "tail": "Angrej", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 4, "column_name": "Film", "header_path": ["Film"], "structural": true, "traversal_from": "table:List of highest-grossing Indian films:row:4", "traversal_to": "Angrej", "direction": "forward"}, {"edge_id": "record:193", "head": "Angrej", "relation": "linked_passage", "tail": "passage:/wiki/Angrej", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 4, "column_name": "Film", "header_path": ["Film"], "structural": true, "contexts": [{"source_id": "/wiki/Angrej", "text": "Angrej ( lit . Englishman ) is a 2015 Indian Punjabi-language historical romance film directed by Simerjit Singh . Co-produced by Aman Khatkar 's Arsara Films , Dara Productions , J Studios , and Rhythm Boyz Entertainment , it stars Amrinder Gill , Sargun Mehta , and Aditi Sharma in lead roles . Set against the backdrop of the waning British Raj , the film chronicles the love story of a young man and a woman belonging to different social strata . Angrej has Ammy Virk , Binnu Dhillon , Anita Devgan , Sardar Sohi , and Nirmal Rishi in supporting roles ; it marked the feature film debut for Mehta and Virk . Conceived as a romantic comedy set in the pre-partitioned Punjab , Angrej 's story was written by Amberdeep Singh , who had always wanted to work on a period film about Punjabi culture . The film was shot in the rural parts of Rajasthan and Punjab over 40 days , with Navneet Misser serving as the cinematographer . Production designer Raashid Rangrez paid particular attention to the film 's sets and costumes as he wanted them to represent the Punjab of the 1940s accurately . Jatinder Shah composed the film 's soundtrack , which features vocals from Gill , Virk and Sunidhi Chauhan . Angrej was released theatrically on 31 July 2015 ; it received a positive response from film critics and audience alike . The performances of the cast , the production design , and the humour were chiefly praised . Commercially , Angrej grossed a total of around ₹307 million in its theatrical run and became one of the highest-grossing Punjabi films of all time .", "context_before": ""}], "traversal_from": "Angrej", "traversal_to": "passage:/wiki/Angrej", "direction": "forward"}], "steps": [{"step": 1, "goal": "5 --has_record--> table:List of highest-grossing Indian films:row:4", "depends_on": null}, {"step": 2, "goal": "table:List of highest-grossing Indian films:row:4 --film--> Angrej", "depends_on": 1}, {"step": 3, "goal": "Angrej --linked_passage--> passage:/wiki/Angrej", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.2667}}, {"path_id": "row_5_27", "score": 7.7667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["6", "table:List of highest-grossing Indian films:row:5", "Qismat", "passage:/wiki/Qismat"], "edges": [{"edge_id": "record:91", "head": "6", "relation": "has_record", "tail": "table:List of highest-grossing Indian films:row:5", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 5, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "6", "traversal_to": "table:List of highest-grossing Indian films:row:5", "direction": "forward"}, {"edge_id": "record:96", "head": "table:List of highest-grossing Indian films:row:5", "relation": "film", "tail": "Qismat", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 5, "column_name": "Film", "header_path": ["Film"], "structural": true, "traversal_from": "table:List of highest-grossing Indian films:row:5", "traversal_to": "Qismat", "direction": "forward"}, {"edge_id": "record:195", "head": "Qismat", "relation": "linked_passage", "tail": "passage:/wiki/Qismat", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 5, "column_name": "Film", "header_path": ["Film"], "structural": true, "contexts": [{"source_id": "/wiki/Qismat", "text": "Qismat ( transl . Fate ) is a 2018 Indian Punjabi-language romantic drama film written and directed by Jagdeep Sidhu . Produced by Shri Narotam Ji Productions , the film stars Ammy Virk and Sargun Mehta with Guggu Gill , Tania and Harby Sangha in supporting roles . It was titled after a 2017 song of the same name , sung by Virk and starring Mehta in its music video . The film follows a man who falls in love whilst studying in Chandigarh , despite his marriage being arranged to another woman . It marked feature film debut for Tania . Principal photography took place within a single schedule that lasted 45 days in Chandigarh and other villages of Punjab , India , with Jalesh Oberoi serving as cinematographer . The background score was composed by Gurmeet Singh and Sandeep Saxena while the soundtrack was composed by B Praak and Sukh-E , with vocals from Ammy Virk , Gurnam Bhullar , Kamal Khan , Divya Bhatt , Neetu Bhalla and B Praak . Also , Khan won Best Playback Singer Award . Qismat was released worldwide on 21 September 2018 by White Hill Studios . The film attracted positive reviews from critics , with some highlighting it as Virk 's best performance at the time , while some criticized film 's length . Commercially , the film is blockbuster and had grossed ₹310.5 million ( US $ 4.4 million ) in its theatrical run , and it ran for more than 50 days .", "context_before": ""}], "traversal_from": "Qismat", "traversal_to": "passage:/wiki/Qismat", "direction": "forward"}], "steps": [{"step": 1, "goal": "6 --has_record--> table:List of highest-grossing Indian films:row:5", "depends_on": null}, {"step": 2, "goal": "table:List of highest-grossing Indian films:row:5 --film--> Qismat", "depends_on": 1}, {"step": 3, "goal": "Qismat --linked_passage--> passage:/wiki/Qismat", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 11.7667}}, {"path_id": "row_6_32", "score": 7.7667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["7", "table:List of highest-grossing Indian films:row:6", "Jatt & Juliet 2", "passage:/wiki/Jatt_&_Juliet_2"], "edges": [{"edge_id": "record:109", "head": "7", "relation": "has_record", "tail": "table:List of highest-grossing Indian films:row:6", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 6, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "7", "traversal_to": "table:List of highest-grossing Indian films:row:6", "direction": "forward"}, {"edge_id": "record:114", "head": "table:List of highest-grossing Indian films:row:6", "relation": "film", "tail": "Jatt & Juliet 2", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 6, "column_name": "Film", "header_path": ["Film"], "structural": true, "traversal_from": "table:List of highest-grossing Indian films:row:6", "traversal_to": "Jatt & Juliet 2", "direction": "forward"}, {"edge_id": "record:197", "head": "Jatt & Juliet 2", "relation": "linked_passage", "tail": "passage:/wiki/Jatt_&_Juliet_2", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 6, "column_name": "Film", "header_path": ["Film"], "structural": true, "contexts": [{"source_id": "/wiki/Jatt_&_Juliet_2", "text": "Jatt & Juliet 2 ( Punjabi : ਜੱਟ ਐੰਡ ਜੂਲੀਅਟ-੨ ) is a 2013 Indian Punjabi romance comedy film directed by Anurag Singh . The film is a sequel to the 2012 blockbuster Jatt & Juliet , however not directly or story-wise . Actors Diljit Dosanjh and Neeru Bajwa reprise their roles from the previous film in the sequel amongst other characters . The film released on 28 June 2013 , almost a year after the release of the prequel , and received a positive response at the box office . Jatt & Juliet 2 went on to become the highest-grossing Punjabi film ever , thus beating the record previously held by the first Jatt & Juliet film . Jatt and Juliet 2 will be the first ever Punjabi movie to be released on Blu-ray . The movie was remade in Bengali in 2018 as Inspector Notty K .", "context_before": "Qismat ( transl . Fate ) is a 2018 Indian Punjabi-language romantic drama film written and directed by Jagdeep Sidhu . Produced by Shri Narotam Ji Productions , the film stars Ammy Virk and Sargun Mehta with Guggu Gill , Tania and Harby Sangha in supporting roles . It was titled after a 2017 song of the same name , sung by Virk and starring Mehta in its music video . The film follows a man who falls in love whilst studying in Chandigarh , despite his marriage being arranged to another woman . It marked feature film debut for Tania . Principal photography took place within a single schedule that lasted 45 days in Chandigarh and other villages of Punjab , India , with Jalesh Oberoi serving as cinematographer . The background score was composed by Gurmeet Singh and Sandeep Saxena while the soundtrack was composed by B Praak and Sukh-E , with vocals from Ammy Virk , Gurnam Bhullar , Kamal Khan , Divya Bhatt , Neetu Bhalla and B Praak . Also , Khan won Best Playback Singer Award . Qismat was released worldwide on 21 September 2018 by White Hill Studios . The film attracted positive reviews from critics , with some highlighting it as Virk 's best performance at the time , while some criticized film 's length . Commercially , the film is blockbuster and had grossed ₹310.5 million ( US $ 4.4 million ) in its theatrical run , and it ran for more than 50 days . Jagdeep Sidhu is an Indian film director , writer , screenwriter and dialogue writer associated with Punjabi and Hindi cinema . He has been nominated for seven awards for categories Best Screenplay , Dialogue , and Direction PTC Punjabi Film Awards , winning one Best Debut Director for the film Qismat ( 2019 ) and has been nominated for five Filmfare Awards Punjabi ."}], "traversal_from": "Jatt & Juliet 2", "traversal_to": "passage:/wiki/Jatt_&_Juliet_2", "direction": "forward"}], "steps": [{"step": 1, "goal": "7 --has_record--> table:List of highest-grossing Indian films:row:6", "depends_on": null}, {"step": 2, "goal": "table:List of highest-grossing Indian films:row:6 --film--> Jatt & Juliet 2", "depends_on": 1}, {"step": 3, "goal": "Jatt & Juliet 2 --linked_passage--> passage:/wiki/Jatt_&_Juliet_2", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 11.7667}}, {"path_id": "row_8_42", "score": 7.1167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 0.25, "query_coverage": 0.4, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["9", "table:List of highest-grossing Indian films:row:8", "Sajjan Singh Rangroot", "passage:/wiki/Sajjan_Singh_Rangroot"], "edges": [{"edge_id": "record:145", "head": "9", "relation": "has_record", "tail": "table:List of highest-grossing Indian films:row:8", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 8, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "9", "traversal_to": "table:List of highest-grossing Indian films:row:8", "direction": "forward"}, {"edge_id": "record:150", "head": "table:List of highest-grossing Indian films:row:8", "relation": "film", "tail": "Sajjan Singh Rangroot", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 8, "column_name": "Film", "header_path": ["Film"], "structural": true, "traversal_from": "table:List of highest-grossing Indian films:row:8", "traversal_to": "Sajjan Singh Rangroot", "direction": "forward"}, {"edge_id": "record:203", "head": "Sajjan Singh Rangroot", "relation": "linked_passage", "tail": "passage:/wiki/Sajjan_Singh_Rangroot", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 8, "column_name": "Film", "header_path": ["Film"], "structural": true, "contexts": [{"source_id": "/wiki/Sajjan_Singh_Rangroot", "text": "Sajjan Singh Rangroot is a 2018 Indian Punjabi-language war drama film directed by Pankaj Batra . It stars Diljit Dosanjh , Yograj Singh and Sunanda Sharma . The movie is based on a true story about the experiences of Sikh soldiers of the British Indian Army fighting on the Western Front during World War I . The movie was released on 23 March 2018 . On release , film got positive reviews from both critics and audience . The movie is expected to be dubbed into Hindi by Cinekorn Entertainment and English . Sajjan Singh Rangroot is eighth highest Punjabi grossing film of all time and third highest-grossing film of 2018 . On 22 June 2018 , Sajjan Singh Rangroot 's exclusive internet rights was acquired by SHAREit", "context_before": ""}], "traversal_from": "Sajjan Singh Rangroot", "traversal_to": "passage:/wiki/Sajjan_Singh_Rangroot", "direction": "forward"}], "steps": [{"step": 1, "goal": "9 --has_record--> table:List of highest-grossing Indian films:row:8", "depends_on": null}, {"step": 2, "goal": "table:List of highest-grossing Indian films:row:8 --film--> Sajjan Singh Rangroot", "depends_on": 1}, {"step": 3, "goal": "Sajjan Singh Rangroot --linked_passage--> passage:/wiki/Sajjan_Singh_Rangroot", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 11.1167}}, {"path_id": "answer_evidence_record_186", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["White Hill Studio , A & A Advisors", "passage:/wiki/White_Hill_Studio"], "edges": [{"edge_id": "record:186", "head": "White Hill Studio , A & A Advisors", "relation": "linked_passage", "tail": "passage:/wiki/White_Hill_Studio", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 1, "column_name": "Studio ( s )", "header_path": ["Studio ( s )"], "structural": true, "contexts": [{"source_id": "/wiki/White_Hill_Studio", "text": "White Hill Studios is an Indian film studio in the Punjabi industry . The studio 's activities range over production , creative development , distribution and marketing of films in Punjab and worldwide .", "context_before": "Carry On Jatta 2 is a 2018 Indian Punjabi comedy film directed by Smeep Kang . The film is a sequel to the Carry On Jatta ( 2012 ) . The film stars Gippy Grewal and Sonam Bajwa in lead roles with Gurpreet Ghuggi , Binnu Dhillon , Jaswinder Bhalla , B.N . Sharma , Karamjit Anmol and Upasana Singh and Jyotii Sethi in supporting roles . The film was theatrically released on June 1 , 2018 and turned out to be a commercial success accompanied by critical acclaim . It broke several records at the box office including the worldwide opening weekend record ( earning ₹20.71 million ) , opening day and opening weekend records in various countries except the overseas record of all time collection of Chaar Sahibzaade . Collecting ₹562.7 million ( US $ 7.9 million ) worldwide in its theatrical run makes it highest grossing Punjabi films of all time . Smeep Kang is a Punjabi actor , film producer and director . He graduated from Punjab University with a degree in Chemical Engineering . He is well known for directing the Punjabi comedy films Chak De Phatte ( 2008 ) , Carry On Jatta ( 2012 ) , Lucky Di Unlucky Story ( 2013 ) ."}]}], "steps": [{"step": 1, "goal": "White Hill Studio , A & A Advisors --linked_passage--> passage:/wiki/White_Hill_Studio", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_187", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["White Hill Studio", "passage:/wiki/White_Hill_Studio"], "edges": [{"edge_id": "record:187", "head": "White Hill Studio", "relation": "linked_passage", "tail": "passage:/wiki/White_Hill_Studio", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 1, "column_name": "Studio ( s )", "header_path": ["Studio ( s )"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/White_Hill_Studio", "text": "White Hill Studios is an Indian film studio in the Punjabi industry . The studio 's activities range over production , creative development , distribution and marketing of films in Punjab and worldwide .", "context_before": "Carry On Jatta 2 is a 2018 Indian Punjabi comedy film directed by Smeep Kang . The film is a sequel to the Carry On Jatta ( 2012 ) . The film stars Gippy Grewal and Sonam Bajwa in lead roles with Gurpreet Ghuggi , Binnu Dhillon , Jaswinder Bhalla , B.N . Sharma , Karamjit Anmol and Upasana Singh and Jyotii Sethi in supporting roles . The film was theatrically released on June 1 , 2018 and turned out to be a commercial success accompanied by critical acclaim . It broke several records at the box office including the worldwide opening weekend record ( earning ₹20.71 million ) , opening day and opening weekend records in various countries except the overseas record of all time collection of Chaar Sahibzaade . Collecting ₹562.7 million ( US $ 7.9 million ) worldwide in its theatrical run makes it highest grossing Punjabi films of all time . Smeep Kang is a Punjabi actor , film producer and director . He graduated from Punjab University with a degree in Chemical Engineering . He is well known for directing the Punjabi comedy films Chak De Phatte ( 2008 ) , Carry On Jatta ( 2012 ) , Lucky Di Unlucky Story ( 2013 ) ."}]}], "steps": [{"step": 1, "goal": "White Hill Studio --linked_passage--> passage:/wiki/White_Hill_Studio", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_190", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["White Hill Studio", "passage:/wiki/White_Hill_Studio"], "edges": [{"edge_id": "record:190", "head": "White Hill Studio", "relation": "linked_passage", "tail": "passage:/wiki/White_Hill_Studio", "source_type": "table", "source_id": "List of highest-grossing Indian films", "row_index": 2, "column_name": "Studio ( s )", "header_path": ["Studio ( s )"], "structural": true, "contexts": [{"source_id": "/wiki/White_Hill_Studio", "text": "White Hill Studios is an Indian film studio in the Punjabi industry . The studio 's activities range over production , creative development , distribution and marketing of films in Punjab and worldwide .", "context_before": "Carry On Jatta 2 is a 2018 Indian Punjabi comedy film directed by Smeep Kang . The film is a sequel to the Carry On Jatta ( 2012 ) . The film stars Gippy Grewal and Sonam Bajwa in lead roles with Gurpreet Ghuggi , Binnu Dhillon , Jaswinder Bhalla , B.N . Sharma , Karamjit Anmol and Upasana Singh and Jyotii Sethi in supporting roles . The film was theatrically released on June 1 , 2018 and turned out to be a commercial success accompanied by critical acclaim . It broke several records at the box office including the worldwide opening weekend record ( earning ₹20.71 million ) , opening day and opening weekend records in various countries except the overseas record of all time collection of Chaar Sahibzaade . Collecting ₹562.7 million ( US $ 7.9 million ) worldwide in its theatrical run makes it highest grossing Punjabi films of all time . Smeep Kang is a Punjabi actor , film producer and director . He graduated from Punjab University with a degree in Chemical Engineering . He is well known for directing the Punjabi comedy films Chak De Phatte ( 2008 ) , Carry On Jatta ( 2012 ) , Lucky Di Unlucky Story ( 2013 ) ."}]}], "steps": [{"step": 1, "goal": "White Hill Studio --linked_passage--> passage:/wiki/White_Hill_Studio", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "r