ds": ["grounded_685", "grounded_687", "grounded_689", "grounded_686", "grounded_688"], "qualified_path_ids": ["grounded_685", "grounded_687", "grounded_689", "grounded_686", "grounded_688"], "rejected_path_ids": [], "abstained_for_missing_grounding": false, "pre_answer_path_selection": false, "verification_by_path": {"grounded_685": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8167}, "grounded_687": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 13.65}, "grounded_689": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 13.65}, "grounded_686": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.65}, "grounded_688": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 12.65}}}, "reasoning_paths": [{"path_id": "grounded_685", "score": 8.7167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.75, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Jarome_Iginla", "Jarome Iginla", "table:1996 World Junior Ice Hockey Championships:row:0", "table:1996 World Junior Ice Hockey Championships:row:0:cell:Player"], "edges": [{"edge_id": "record:180", "head": "Jarome Iginla", "relation": "linked_passage", "tail": "passage:/wiki/Jarome_Iginla", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Player", "header_path": ["Player"], "structural": true, "contexts": [{"source_id": "/wiki/Jarome_Iginla", "text": "Jarome Arthur-Leigh Adekunle Tig Junior Elvis Iginla ( /dʒəˈroʊm ɪˈɡɪnlə/ ; born July 1 , 1977 ) is a Canadian former professional ice hockey forward . He played over 1500 games in the National Hockey League ( NHL ) for the Calgary Flames , Pittsburgh Penguins , Boston Bruins , Colorado Avalanche and Los Angeles Kings . As a junior , Iginla was a member of two Memorial Cup winning teams with the Kamloops Blazers and was named the Western Hockey League ( WHL ) Player of the Year in 1996 . He was selected 11th overall by the Dallas Stars in the 1995 NHL Entry Draft , but was traded to Calgary prior to making his NHL debut . He led the NHL in goals and points in 2001-02 , and won the Lester B. Pearson Award as its most valuable player as voted by the players . In 2003-04 , Iginla led the league in goals for the second time and captained the Flames to the Stanley Cup Finals , leading the playoffs in goals . A six-time NHL All-Star , Iginla is the Flames ' all-time leader in goals , points , and games played , and is second in assists to Al MacInnis . Iginla scored 50 goals in a season on two occasions and is one of seven players in NHL history to score 30 goals in 11 consecutive seasons . He is one of 20 players in NHL history to score over 600 goals and is one of 34 players to record 1,300 points in his career . He is a past winner of the Mark Messier Leadership Award and has been recognized by both the Flames and the league for his community work ; while a member of the Flames , Iginla donated $ 2,000 to the children 's charity Kidsport for every goal he scored . His number 12 was retired by the Flames during a pre-game ceremony on March 2 , 2019 . Internationally , Iginla has represented Canada on numerous occasions .", "context_before": ""}], "traversal_from": "passage:/wiki/Jarome_Iginla", "traversal_to": "Jarome Iginla", "direction": "reverse"}, {"edge_id": "record:0", "head": "Jarome Iginla", "relation": "has_record", "tail": "table:1996 World Junior Ice Hockey Championships:row:0", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Player", "header_path": ["Player"], "structural": true, "traversal_from": "Jarome Iginla", "traversal_to": "table:1996 World Junior Ice Hockey Championships:row:0", "direction": "forward"}, {"edge_id": "record:1", "head": "table:1996 World Junior Ice Hockey Championships:row:0", "relation": "player", "tail": "table:1996 World Junior Ice Hockey Championships:row:0:cell:Player", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Player", "header_path": ["Player"], "structural": true, "cell_node": true, "cell_value": "Jarome Iginla", "traversal_from": "table:1996 World Junior Ice Hockey Championships:row:0", "traversal_to": "table:1996 World Junior Ice Hockey Championships:row:0:cell:Player", "direction": "forward"}], "steps": [{"step": 1, "goal": "Jarome Iginla --linked_passage--> passage:/wiki/Jarome_Iginla [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Jarome Iginla --has_record--> table:1996 World Junior Ice Hockey Championships:row:0", "depends_on": 1}, {"step": 3, "goal": "table:1996 World Junior Ice Hockey Championships:row:0 --player--> table:1996 World Junior Ice Hockey Championships:row:0:cell:Player", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5714, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8167}}, {"path_id": "grounded_687", "score": 7.55, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Jarome_Iginla", "Jarome Iginla", "table:1996 World Junior Ice Hockey Championships:row:0", "Canada"], "edges": [{"edge_id": "record:180", "head": "Jarome Iginla", "relation": "linked_passage", "tail": "passage:/wiki/Jarome_Iginla", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Player", "header_path": ["Player"], "structural": true, "contexts": [{"source_id": "/wiki/Jarome_Iginla", "text": "Jarome Arthur-Leigh Adekunle Tig Junior Elvis Iginla ( /dʒəˈroʊm ɪˈɡɪnlə/ ; born July 1 , 1977 ) is a Canadian former professional ice hockey forward . He played over 1500 games in the National Hockey League ( NHL ) for the Calgary Flames , Pittsburgh Penguins , Boston Bruins , Colorado Avalanche and Los Angeles Kings . As a junior , Iginla was a member of two Memorial Cup winning teams with the Kamloops Blazers and was named the Western Hockey League ( WHL ) Player of the Year in 1996 . He was selected 11th overall by the Dallas Stars in the 1995 NHL Entry Draft , but was traded to Calgary prior to making his NHL debut . He led the NHL in goals and points in 2001-02 , and won the Lester B. Pearson Award as its most valuable player as voted by the players . In 2003-04 , Iginla led the league in goals for the second time and captained the Flames to the Stanley Cup Finals , leading the playoffs in goals . A six-time NHL All-Star , Iginla is the Flames ' all-time leader in goals , points , and games played , and is second in assists to Al MacInnis . Iginla scored 50 goals in a season on two occasions and is one of seven players in NHL history to score 30 goals in 11 consecutive seasons . He is one of 20 players in NHL history to score over 600 goals and is one of 34 players to record 1,300 points in his career . He is a past winner of the Mark Messier Leadership Award and has been recognized by both the Flames and the league for his community work ; while a member of the Flames , Iginla donated $ 2,000 to the children 's charity Kidsport for every goal he scored . His number 12 was retired by the Flames during a pre-game ceremony on March 2 , 2019 . Internationally , Iginla has represented Canada on numerous occasions .", "context_before": ""}], "traversal_from": "passage:/wiki/Jarome_Iginla", "traversal_to": "Jarome Iginla", "direction": "reverse"}, {"edge_id": "record:0", "head": "Jarome Iginla", "relation": "has_record", "tail": "table:1996 World Junior Ice Hockey Championships:row:0", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Player", "header_path": ["Player"], "structural": true, "traversal_from": "Jarome Iginla", "traversal_to": "table:1996 World Junior Ice Hockey Championships:row:0", "direction": "forward"}, {"edge_id": "record:5", "head": "table:1996 World Junior Ice Hockey Championships:row:0", "relation": "country", "tail": "Canada", "source_type": "table", "source_id": "1996 World Junior Ice Hockey Championships", "row_index": 0, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "table:1996 World Junior Ice Hockey Championships:row:0", "traversal_to": "Canada", "direction": "forward"}], "ste