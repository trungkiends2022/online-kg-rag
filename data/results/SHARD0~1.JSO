 {"step": 2, "goal": "table:3rd New Zealand Parliament:row:9 --electorate--> City of Christchurch", "depends_on": 1}, {"step": 3, "goal": "City of Christchurch --linked_passage--> /wiki/Christchurch_(New_Zealand_electorate)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8462, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.5223}}, {"path_id": "grounded_483", "score": 13.3556, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.5556, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["First", "table:3rd New Zealand Parliament:row:10", "John Ormond", "passage:/wiki/John_Davies_Ormond"], "edges": [{"edge_id": "record:166", "head": "table:3rd New Zealand Parliament:row:10", "relation": "mp_s_term", "tail": "First", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 10, "column_name": "MP 's term", "header_path": ["MP 's term"], "structural": true, "traversal_from": "First", "traversal_to": "table:3rd New Zealand Parliament:row:10", "direction": "reverse"}, {"edge_id": "record:154", "head": "John Ormond", "relation": "has_record", "tail": "table:3rd New Zealand Parliament:row:10", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 10, "column_name": "Member", "header_path": ["Member"], "structural": true, "traversal_from": "table:3rd New Zealand Parliament:row:10", "traversal_to": "John Ormond", "direction": "reverse"}, {"edge_id": "record:335", "head": "John Ormond", "relation": "linked_passage", "tail": "passage:/wiki/John_Davies_Ormond", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 10, "column_name": "Member", "header_path": ["Member"], "structural": true, "contexts": [{"source_id": "/wiki/John_Davies_Ormond", "text": "John Davies Ormond ( 1831 - 6 October 1917 ) was a New Zealand politician whose positions included Superintendent of Hawke 's Bay Province , Minister of Public Works and member of the New Zealand Legislative Council .", "context_before": "Sir John Cracroft Wilson KCSI CB ( 21 May 1808 - 2 March 1881 ) , also known as Nabob Wilson , was a British-educated civil servant in India , farmer and politician in New Zealand . Christchurch was a parliamentary electorate in Christchurch , New Zealand . It existed three times . Originally it was the Town of Christchurch from 1853 to 1860 . From the 1860-1861 election to the 1871 election , it existed as City of Christchurch . It then existed from the 1875-1876 election until the 1881 election . The last period was from the 1890 election to the 1905 election . Since the 1946 election , a similarly named electorate called Christchurch Central has been in existence . The historic electorate was represented by 21 members of parliament . For some of the time , it was represented by one member at a time . During other periods , it was one of the few three-member electorates in New Zealand ."}], "traversal_from": "John Ormond", "traversal_to": "passage:/wiki/John_Davies_Ormond", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:3rd New Zealand Parliament:row:10 --mp_s_term--> First [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "John Ormond --has_record--> table:3rd New Zealand Parliament:row:10 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "John Ormond --linked_passage--> passage:/wiki/John_Davies_Ormond", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term