rue, "terminal_is_container": true, "selection_score": 13.9667}, "row_9_52": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8}, "row_1_7": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.7167}, "row_6_35": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.6333}}}, "reasoning_paths": [{"path_id": "grounded_84", "score": 8.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["A big hit for Atari , the player controls a tank from the point-of-view from inside the tank . Novel controls , game cabinet and graphics made this a standout", "table:List of Atari arcade games:row:2", "Battlezone", "passage:/wiki/Battlezone_(1980_video_game)"], "edges": [{"edge_id": "record:42", "head": "table:List of Atari arcade games:row:2", "relation": "description", "tail": "A big hit for Atari , the player controls a tank from the point-of-view from inside the tank . Novel controls , game cabinet and graphics made this a standout", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 2, "column_name": "Description", "header_path": ["Description"], "structural": true, "traversal_from": "A big hit for Atari , the player controls a tank from the point-of-view from inside the tank . Novel controls , game cabinet and graphics made this a standout", "traversal_to": "table:List of Atari arcade games:row:2", "direction": "reverse"}, {"edge_id": "record:30", "head": "Battlezone", "relation": "has_record", "tail": "table:List of Atari arcade games:row:2", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 2, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of Atari arcade games:row:2", "traversal_to": "Battlezone", "direction": "reverse"}, {"edge_id": "record:173", "head": "Battlezone", "relation": "linked_passage", "tail": "passage:/wiki/Battlezone_(1980_video_game)", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 2, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Battlezone_(1980_video_game)", "text": "Battlezone is a first-person shooter tank combat arcade game from Atari , Inc. released in November 1980 . The player controls a tank which is attacked by other tanks and missiles .", "context_before": "Batman is a 1989 American superhero film directed by Tim Burton and produced by Jon Peters and Peter Guber , based on the DC Comics character of the same name . It is the first installment of Warner Bros. ' initial Batman film series . The film stars Jack Nicholson as the Joker and Michael Keaton as Bruce Wayne / Batman , alongside Kim Basinger , Robert Wuhl , Pat Hingle , Billy Dee Williams , Michael Gough , and Jack Palance . The film takes place early in the title character 's war on crime , and depicts a battle with the Joker . After Burton was hired as director in 1986 , Steve Englehart and Julie Hickson wrote film treatments before Sam Hamm wrote the first screenplay . Batman was not greenlit until after the success of Burton 's Beetlejuice ( 1988 ) . Numerous A-list actors were considered for the role of Batman before Keaton was cast . Keaton 's casting caused a controversy since , by 1988 , he had become typecast as a comedic actor and many observers doubted he could portray a serious role . Nicholson accepted the role of the Joker under strict conditions that dictated top billing , a portion of the film 's earnings ( including associated merchandise ) , and his own shooting schedule . The tone and themes of the film were influenced in part by Alan Moore and Brian Bolland 's The Killing Joke and Frank Miller 's The Dark Knight Returns . The film primarily adapts the Red Hood origin story for the Joker , in which Batman inadvertently creates the Joker by causing him to fall into Axis Chemical acid , resulting in his transformation into a psychopath , but it adds a unique twist in presenting him specifically as a gangster named Jack Napier . Filming took place at Pinewood Studios from October 1988 to January 1989 . The Joker is a supervillain created by Bill Finger , Bob Kane , and Jerry Robinson who first appeared in the debut issue of the comic book Batman ( April 25 , 1940 ) , published by DC Comics . Credit for the Joker 's creation is disputed ; Kane and Robinson claimed responsibility for the Joker 's design while acknowledging Finger 's writing contribution . Although the Joker was planned to be killed off during his initial appearance , he was spared by editorial intervention , allowing the character to endure as the archenemy of the superhero Batman . In his comic book appearances , the Joker is portrayed as a criminal mastermind . Introduced as a psychopath with a warped , sadistic sense of humor ; the character became a goofy prankster in the late 1950s in response to regulation by the Comics Code Authority , before returning to his darker roots during the early 1970s . As Batman 's nemesis , the Joker has been part of the superhero 's defining stories , including the murder of Jason Todd - the second Robin and Batman 's ward - and the paralysis of one of Batman 's allies , Barbara Gordon . The Joker has had various possible origin stories during his decades of appearances . The most common story involves him falling into a tank of chemical waste that bleaches his skin white and turns his hair green and lips bright red ; the resulting disfigurement drives him insane . The antithesis of Batman in personality and appearance , the Joker is considered by critics to be his perfect adversary . The Joker possesses no superhuman abilities , instead using his expertise in chemical engineering to develop poisonous or lethal concoctions and thematic weaponry , including razor-tipped playing cards , deadly joy buzzers , and acid-spraying lapel flowers . The Joker sometimes works with other Gotham City supervillains , such as the Penguin and Two-Face , and groups like the Injustice Gang and Injustice League , but these relationships often collapse due to the Joker 's desire for unbridled chaos . The 1990s introduced a romantic interest for the Joker in his former psychiatrist , Harley Quinn , who becomes his villainous sidekick ."}], "traversal_from": "Battlezone", "traversal_to": "passage:/wiki/Battlezone_(1980_video_game)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of Atari arcade games:row:2 --description--> A big hit for Atari , the player controls a tank from the point-of-view from inside the tank . Novel controls , game cabinet and graphics made this a standout [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Battlezone --has_record--> table:List of Atari arcade games:row:2 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Battlezone --linked_passage--> passage:/wiki/Battlezone_(1980_video_game)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.3}}, {"path_id": "row_3_18", "score": 8.4667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 0.6667, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Beat Head", "table:List of Atari arcade games:row:3", "A competitive rhythm game . Never released into full production", "passage:/wiki/Rhythm_game"], "edges": [{"edge_id": "record:44", "head": "Beat Head", "relation": "has_record", "tail": "table:List of Atari arcade games:row:3", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Beat Head", "traversal_to": "table:List of Atari arcade games:row:3", "direction": "forward"}, {"edge_id": "record:56", "head": "table:List of Atari arcade games:row:3", "relation": "description", "tail": "A competitive rhythm game . Never released into full production", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 3, "column_name": "Description", "header_path": ["Description"], "structural": true, "traversal_from": "table:List of Atari arcade games:row:3", "traversal_to": "A competitive rhythm game . Never released into full production", "direction": "forward"}, {"edge_id": "record:180", "head": "A competitive rhythm game . Never released into full production", "relation": "linked_passage", "tail": "passage:/wiki/Rhythm_game", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 3, "column_name": "Description", "header_path": ["Description"], "structural": true, "contexts": [{"source_id": "/wiki/Rhythm_game", "text": "Rhythm game or rhythm action is a genre of music-themed action video game that challenges a player 's sense of rhythm . Games in the genre typically focus on dance or the simulated performance of musical instruments , and require players to press buttons in a sequence dictated on the screen . Many rhythm games include multiplayer modes in which players compete for the highest score or cooperate as a simulated musical ensemble . While conventional control pads may be used as input devices , rhythm games often feature novel game controllers that emulate musical instruments . Certain dance-based games require the player to physically dance on a mat , with pressure-sensitive pads acting as the input device . The 1996 title PaRappa the Rapper has been deemed the first influential rhythm game , whose basic template formed the core of subsequent games in the genre . In 1997 , Konami 's Beatmania sparked an emergent market for rhythm games in Japan . The company 's music division , Bemani , released a series of music-based games over the next several years . The most successful of these was the 1998 dance mat game Dance Dance Revolution , which was the only Bemani title to achieve large-scale success outside Japan , and would see numerous imitations of the game from other publishers . Other Japanese games , particularly Guitar Freaks , led to development of Guitar Hero and Rock Band series that used instrument-shaped controllers to mimic the playing of actual instruments . Spurred by the inclusion of popular rock music , the two series revitalized the rhythm genre in the Western Market , significantly expanded the console video game market and its demographics . The games provided a new source of revenue for the artists whose music appeared on the soundtracks .", "context_before": ""}], "traversal_from": "A competitive rhythm game . Never released into full production", "traversal_to": "passage:/wiki/Rhythm_game", "direction": "forward"}], "steps": [{"step": 1, "goal": "Beat Head --has_record--> table:List of Atari arcade games:row:3", "depends_on": null}, {"step": 2, "goal": "table:List of Atari arcade games:row:3 --description--> A competitive rhythm game . Never released into full production", "depends_on": 1}, {"step": 3, "goal": "A competitive rhythm game . Never released into full production --linked_passage--> passage:/wiki/Rhythm_game", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.9667}}, {"path_id": "row_9_52", "score": 8.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Bradley Trainer", "table:List of Atari arcade games:row:9", "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "passage:/wiki/Battlezone_(1980_video_game)"], "edges": [{"edge_id": "record:132", "head": "Bradley Trainer", "relation": "has_record", "tail": "table:List of Atari arcade games:row:9", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 9, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Bradley Trainer", "traversal_to": "table:List of Atari arcade games:row:9", "direction": "forward"}, {"edge_id": "record:144", "head": "table:List of Atari arcade games:row:9", "relation": "description", "tail": "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 9, "column_name": "Description", "header_path": ["Description"], "structural": true, "traversal_from": "table:List of Atari arcade games:row:9", "traversal_to": "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "direction": "forward"}, {"edge_id": "record:214", "head": "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "relation": "linked_passage", "tail": "passage:/wiki/Battlezone_(1980_video_game)", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 9, "column_name": "Description", "header_path": ["Description"], "structural": true, "contexts": [{"source_id": "/wiki/Battlezone_(1980_video_game)", "text": "Battlezone is a first-person shooter tank combat arcade game from Atari , Inc. released in November 1980 . The player controls a tank which is attacked by other tanks and missiles .", "context_before": "Batman is a 1989 American superhero film directed by Tim Burton and produced by Jon Peters and Peter Guber , based on the DC Comics character of the same name . It is the first installment of Warner Bros. ' initial Batman film series . The film stars Jack Nicholson as the Joker and Michael Keaton as Bruce Wayne / Batman , alongside Kim Basinger , Robert Wuhl , Pat Hingle , Billy Dee Williams , Michael Gough , and Jack Palance . The film takes place early in the title character 's war on crime , and depicts a battle with the Joker . After Burton was hired as director in 1986 , Steve Englehart and Julie Hickson wrote film treatments before Sam Hamm wrote the first screenplay . Batman was not greenlit until after the success of Burton 's Beetlejuice ( 1988 ) . Numerous A-list actors were considered for the role of Batman before Keaton was cast . Keaton 's casting caused a controversy since , by 1988 , he had become typecast as a comedic actor and many observers doubted he could portray a serious role . Nicholson accepted the role of the Joker under strict conditions that dictated top billing , a portion of the film 's earnings ( including associated merchandise ) , and his own shooting schedule . The tone and themes of the film were influenced in part by Alan Moore and Brian Bolland 's The Killing Joke and Frank Miller 's The Dark Knight Returns . The film primarily adapts the Red Hood origin story for the Joker , in which Batman inadvertently creates the Joker by causing him to fall into Axis Chemical acid , resulting in his transformation into a psychopath , but it adds a unique twist in presenting him specifically as a gangster named Jack Napier . Filming took place at Pinewood Studios from October 1988 to January 1989 . The Joker is a supervillain created by Bill Finger , Bob Kane , and Jerry Robinson who first appeared in the debut issue of the comic book Batman ( April 25 , 1940 ) , published by DC Comics . Credit for the Joker 's creation is disputed ; Kane and Robinson claimed responsibility for the Joker 's design while acknowledging Finger 's writing contribution . Although the Joker was planned to be killed off during his initial appearance , he was spared by editorial intervention , allowing the character to endure as the archenemy of the superhero Batman . In his comic book appearances , the Joker is portrayed as a criminal mastermind . Introduced as a psychopath with a warped , sadistic sense of humor ; the character became a goofy prankster in the late 1950s in response to regulation by the Comics Code Authority , before returning to his darker roots during the early 1970s . As Batman 's nemesis , the Joker has been part of the superhero 's defining stories , including the murder of Jason Todd - the second Robin and Batman 's ward - and the paralysis of one of Batman 's allies , Barbara Gordon . The Joker has had various possible origin stories during his decades of appearances . The most common story involves him falling into a tank of chemical waste that bleaches his skin white and turns his hair green and lips bright red ; the resulting disfigurement drives him insane . The antithesis of Batman in personality and appearance , the Joker is considered by critics to be his perfect adversary . The Joker possesses no superhuman abilities , instead using his expertise in chemical engineering to develop poisonous or lethal concoctions and thematic weaponry , including razor-tipped playing cards , deadly joy buzzers , and acid-spraying lapel flowers . The Joker sometimes works with other Gotham City supervillains , such as the Penguin and Two-Face , and groups like the Injustice Gang and Injustice League , but these relationships often collapse due to the Joker 's desire for unbridled chaos . The 1990s introduced a romantic interest for the Joker in his former psychiatrist , Harley Quinn , who becomes his villainous sidekick ."}], "traversal_from": "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "traversal_to": "passage:/wiki/Battlezone_(1980_video_game)", "direction": "forward"}], "steps": [{"step": 1, "goal": "Bradley Trainer --has_record--> table:List of Atari arcade games:row:9", "depends_on": null}, {"step": 2, "goal": "table:List of Atari arcade games:row:9 --description--> A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret", "depends_on": 1}, {"step": 3, "goal": "A special-purpose version of Battlezone for the U.S. military . Players do not control the tank as in the original game , only the tank turret --linked_passage--> passage:/wiki/Battlezone_(1980_video_game)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.8}}, {"path_id": "row_1_7", "score": 8.2167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 0.6667, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Batman", "table:List of Atari arcade games:row:1", "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "passage:/wiki/Joker_(character)"], "edges": [{"edge_id": "record:15", "head": "Batman", "relation": "has_record", "tail": "table:List of Atari arcade games:row:1", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Batman", "traversal_to": "table:List of Atari arcade games:row:1", "direction": "forward"}, {"edge_id": "record:27", "head": "table:List of Atari arcade games:row:1", "relation": "description", "tail": "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 1, "column_name": "Description", "header_path": ["Description"], "structural": true, "traversal_from": "table:List of Atari arcade games:row:1", "traversal_to": "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "direction": "forward"}, {"edge_id": "record:171", "head": "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "relation": "linked_passage", "tail": "passage:/wiki/Joker_(character)", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 1, "column_name": "Description", "header_path": ["Description"], "structural": true, "contexts": [{"source_id": "/wiki/Joker_(character)", "text": "The Joker is a supervillain created by Bill Finger , Bob Kane , and Jerry Robinson who first appeared in the debut issue of the comic book Batman ( April 25 , 1940 ) , published by DC Comics . Credit for the Joker 's creation is disputed ; Kane and Robinson claimed responsibility for the Joker 's design while acknowledging Finger 's writing contribution . Although the Joker was planned to be killed off during his initial appearance , he was spared by editorial intervention , allowing the character to endure as the archenemy of the superhero Batman . In his comic book appearances , the Joker is portrayed as a criminal mastermind . Introduced as a psychopath with a warped , sadistic sense of humor ; the character became a goofy prankster in the late 1950s in response to regulation by the Comics Code Authority , before returning to his darker roots during the early 1970s . As Batman 's nemesis , the Joker has been part of the superhero 's defining stories , including the murder of Jason Todd - the second Robin and Batman 's ward - and the paralysis of one of Batman 's allies , Barbara Gordon . The Joker has had various possible origin stories during his decades of appearances . The most common story involves him falling into a tank of chemical waste that bleaches his skin white and turns his hair green and lips bright red ; the resulting disfigurement drives him insane . The antithesis of Batman in personality and appearance , the Joker is considered by critics to be his perfect adversary . The Joker possesses no superhuman abilities , instead using his expertise in chemical engineering to develop poisonous or lethal concoctions and thematic weaponry , including razor-tipped playing cards , deadly joy buzzers , and acid-spraying lapel flowers . The Joker sometimes works with other Gotham City supervillains , such as the Penguin and Two-Face , and groups like the Injustice Gang and Injustice League , but these relationships often collapse due to the Joker 's desire for unbridled chaos . The 1990s introduced a romantic interest for the Joker in his former psychiatrist , Harley Quinn , who becomes his villainous sidekick .", "context_before": ""}], "traversal_from": "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "traversal_to": "passage:/wiki/Joker_(character)", "direction": "forward"}], "steps": [{"step": 1, "goal": "Batman --has_record--> table:List of Atari arcade games:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of Atari arcade games:row:1 --description--> The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker", "depends_on": 1}, {"step": 3, "goal": "The player takes on the role of the Caped Crusader participating in scenes taken from the 1989 film of the same name . Scenes are varied and include a final confrontation with The Joker --linked_passage--> passage:/wiki/Joker_(character)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.7167}}, {"path_id": "row_6_35", "score": 8.1333, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Blasteroids", "table:List of Atari arcade games:row:6", "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "passage:/wiki/Powerup"], "edges": [{"edge_id": "record:88", "head": "Blasteroids", "relation": "has_record", "tail": "table:List of Atari arcade games:row:6", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 6, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Blasteroids", "traversal_to": "table:List of Atari arcade games:row:6", "direction": "forward"}, {"edge_id": "record:100", "head": "table:List of Atari arcade games:row:6", "relation": "description", "tail": "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 6, "column_name": "Description", "header_path": ["Description"], "structural": true, "traversal_from": "table:List of Atari arcade games:row:6", "traversal_to": "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "direction": "forward"}, {"edge_id": "record:198", "head": "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "relation": "linked_passage", "tail": "passage:/wiki/Powerup", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 6, "column_name": "Description", "header_path": ["Description"], "structural": true, "contexts": [{"source_id": "/wiki/Powerup", "text": "In video games , a power-up is an object that adds temporary benefits or extra abilities to the player character as a game mechanic . This is in contrast to an item , which may or may not have a permanent benefit that can be used at any time chosen by the player . Although often collected directly through touch , power-ups can sometimes only be gained by collecting several related items , such as the floating letters of the word 'EXTEND ' in Bubble Bobble . Well known examples of power-ups that have entered popular culture include the power pellets from Pac-Man ( regarded as the first power-up ) and the Super Mushroom from Super Mario Bros. , which ranked first in UGO Networks ' Top 11 Video Game Powerups . Items that confer power-ups are usually pre-placed in the game world , spawned randomly , dropped by beaten enemies or picked up from opened or smashed containers . They can be differentiated from items in other games , such as role-playing video games , by the fact that they take effect immediately , feature designs that do not necessarily fit into the game world ( often used letters or symbols emblazoned on a design ) , and are found in specific genres of games . Power-ups are mostly found in action-oriented games such as maze games , run and guns , shoot 'em ups , first-person shooters , and platform games .", "context_before": ""}], "traversal_from": "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "traversal_to": "passage:/wiki/Powerup", "direction": "forward"}], "steps": [{"step": 1, "goal": "Blasteroids --has_record--> table:List of Atari arcade games:row:6", "depends_on": null}, {"step": 2, "goal": "table:List of Atari arcade games:row:6 --description--> Players blast asteroids and other targets and try to catch powerups to upgrade their weapons", "depends_on": 1}, {"step": 3, "goal": "Players blast asteroids and other targets and try to catch powerups to upgrade their weapons --linked_passage--> passage:/wiki/Powerup", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 13.6333}}, {"path_id": "answer_evidence_record_196", "score": 200.0, "score_components": {"reverse_answer_match": 200.0}, "nodes": ["1987", "passage:/wiki/1987_in_video_gaming"], "edges": [{"edge_id": "record:196", "head": "1987", "relation": "linked_passage", "tail": "passage:/wiki/1987_in_video_gaming", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 6, "column_name": "Year", "header_path": ["Year"], "structural": true}], "steps": [{"step": 1, "goal": "1987 --linked_passage--> passage:/wiki/1987_in_video_gaming", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 200.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_197", "score": 200.0, "score_components": {"reverse_answer_match": 200.0}, "nodes": ["1987 in video gaming", "passage:/wiki/1987_in_video_gaming"], "edges": [{"edge_id": "record:197", "head": "1987 in video gaming", "relation": "linked_passage", "tail": "passage:/wiki/1987_in_video_gaming", "source_type": "table", "source_id": "List of Atari arcade games", "row_index": 6, "column_name": "Year", "header_path": ["Year"], "structural": true, "derived_from_cell_split": true}], "steps": [{"step": 1, "goal": "1987 in video gaming --linked_passage--> passage:/wiki/1987_in_video_gaming", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 200.0, "hard_failures": []}, "created_after