ny_station_(SEPTA_Regional_Rail)", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "source_group": null, "row_index": 7, "column_name": "Station", "header_path": ["Station"], "structural": false, "contexts": [{"source_id": "/wiki/Allegheny_station_(SEPTA_Regional_Rail)", "text": "Allegheny station is a SEPTA Regional Rail station located along the Manayunk/Norristown Line located at 22nd Street and Allegheny Avenue in the Swampoodle neighborhood of North Philadelphia . It has also been known in Reading and early SEPTA timetables as 22nd Street or Twenty-Second Street , a name also shared by a former Pennsylvania Railroad station on the Trenton and Chestnut Hill lines . Allegheny station is the first station along SEPTA 's Manayunk/Norristown Line not to be shared with any other line . In FY 2013 , Allegheny station had a weekday average of 76 boardings and 102 alightings .", "context_before": ""}], "traversal_from": "Allegheny", "traversal_to": "/wiki/Allegheny_station_(SEPTA_Regional_Rail)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of SEPTA Regional Rail stations:row:7 --rail_connections--> N/A [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Allegheny --has_record--> table:List of SEPTA Regional Rail stations:row:7 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Allegheny --linked_passage--> /wiki/Allegheny_station_(SEPTA_Regional_Rail)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 20.5692}}, {"path_id": "grounded_1338", "score": 9.0692, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 0.7692, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 1.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["N/A", "table:List of SEPTA Regional Rail stations:row:12", "Ardsley", "passage:/wiki/Ardsley_station"], "edges": [{"edge_id": "record:270", "head": "table:List of SEPTA Regional Rail stations:row:12", "relation": "rail_connections", "tail": "N/A", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 12, "column_name": "Rail connections", "header_path": ["Rail connections"], "structural": true, "traversal_from": "N/A", "traversal_to": "table:List of SEPTA Regional Rail stations:row:12", "direction": "reverse"}, {"edge_id": "record:262", "head": "Ardsley", "relation": "has_record", "tail": "table:List of SEPTA Regional Rail stations:row:12", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 12, "column_name": "Station", "header_path": ["Station"], "structural": true, "traversal_from": "table:List of SEPTA Regional Rail stations:row:12", "traversal_to": "Ardsley", "direction": "reverse"}, {"edge_id": "record:633", "head": "Ardsley", "relation": "linked_passage", "tail": "passage:/wiki/Ardsley_station", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 12, "column_name": "Station", "header_path": ["Station"], "structural": true, "contexts": [{"source_id": "/wiki/Ardsley_station", "text": "Ardsley station is a SEPTA Regional Rail station in Ardsley , Pennsylvania . It serves the Warminster Line and is located at the intersection of Jenkintown Road and Edge Hill Road . In FY 2013 , Ardsley station had a weekday average of 175 boardings and 175 alightings . The station has a parking lot with 45 spaces . Ardsley station is the last stop inbound before Glenside station in Glenside , Pennsylvania , where it merges with the Lansdale/Doylestown Line which runs between Philadelphia and Doylestown . This station is wheelchair/ADA accessible .", "context_before": ""}], "traversal_from": "Ardsley", "traversal_to": "passage:/wiki/Ardsley_station", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of SEPTA Regional Rail stations:row:12 --rail_connections--> N/A [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Ardsley --has_record--> table:List of SEPTA Regional Rail stations:row:12 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Ardsley --linked_passage--> passage:/wiki/Ardsley_station", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.5692}}, {"path_id": "row_10_113", "score": 8.7231, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 0.9231, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 1.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Angora", "table:List of SEPTA Regional Rail stations:row:10", "Philadelphia ( Angora )", "passage:/wiki/Philadelphia"], "edges": [{"edge_id": "record:222", "head": "Angora", "relation": "has_record", "tail": "table:List of SEPTA Regional Rail stations:row:10", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 10, "column_name": "Station", "header_path": ["Station"], "structural": true, "traversal_from": "Angora", "traversal_to": "table:List of SEPTA Regional Rail stations:row:10", "direction": "forward"}, {"edge_id": "record:239", "head": "table:List of SEPTA Regional Rail stations:row:10", "relation": "location", "tail": "Philadelphia ( Angora )", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 10, "column_name": "Location", "header_path": ["Location"], "structural": true, "traversal_from": "table:List of SEPTA Regional Rail stations:row:10", "traversal_to": "Philadelphia ( Angora )", "direction": "forward"}, {"edge_id": "record:618", "head": "Philadelphia ( Angora )", "relation": "linked_passage", "tail": "passage:/wiki/Philadelphia", "source_type": "table", "source_id": "List of SEPTA Regional Rail stations", "row_index": 10, "column_name": "Location", "header_path": ["Location"], "structural": true, "contexts": [{"source_id": "/wiki/Philadelphia", "text": "Philadelphia , known colloquially as Philly , is the largest city in the U.S. state and Commonwealth of Pennsylvania , and the sixth-most populous U.S. city with a 2018 census-estimated population of 1,584,138 . Since 1854 , the city has had the same geographic boundaries as Philadelphia County , the most populous county in Pennsylvania and the urban core of the eighth-largest U.S. metropolitan statistical area , with over 6 million residents as of 2017 [ update ] . Philadelphia is also the economic and cultural anchor of the greater Delaware Valley , located along the lower Delaware and Schuylkill Rivers , within the Northeast megalopolis . The Delaware Valley 's population of 7.2 million ranks it as the eighth-largest combined statistical area in the United States . Philadelphia is one of the oldest municipalities in the United States . William Penn , an English Quaker , founded the city in 1682 to serve as capital of the Pennsylvania Colony . Philadelphia played an instrumental role in the American Revolution as a meeting place for the Founding Fathers of the United States , who signed the Declaration of Independence in 1776 at the Second Continental Congress , and the Constitution at the Philadelphia Convention of 1787 . Several other key events occurred in Philadelphia during the Revolutionary War including the First Continental Congress , the preservation of the Liberty Bell , the Battle of Germantown , and the Siege of Fort Mifflin . Philadelphia remained the nation 's largest city until being overtaken by New York City in 1790 ; the city was also one of the nation 's capitals during the revolution , serving as temporary U.S. capital while Washington , D.C. was under construction . In the 19th century , Philadelphia became a major industrial center and a railroad hub . The city grew from an influx of European immigrants , most of whom came from Ireland , Italy and Germany - the three largest reported ancestry groups in the city as of 2015 [ update ] . In the early 20th century , Philadelphia became a prime destination for African Americans during the Great Migration after the Civil War , as well as Puerto Ricans .", "context_before": ""}], "traversal_from": "Philadelphia ( Angora )", "traversal_to": "passage:/wiki/Philadelphia", "direction": "forward"}], "steps": [{"step": 1, "goal": "Angora --has_record--> table:List of SEPTA Regional Rail stations:row:10", "depends_on": null}, {"step": 2, "goal": "table:List of SEPTA Regional Rail stations:row:10 --location--> Philadelphia ( Angora )", "depends_on": 1}, {"step": 3, "goal": "Philadelphia ( Angora ) --linked_passage--> passage:/wiki/Philadelphia", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.2231}}, {"path_id": "grounded_1339", "score": 7.0692, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 0.7692, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1