 "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 19.0727}, "row_bridge_3_20": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 19.0727}}}, "reasoning_paths": [{"path_id": "row_3_17", "score": 16.0727, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.2727, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["4", "table:Decathlon:row:3", "Irina Karpova ( KAZ )", "passage:/wiki/Irina_Karpova"], "edges": [{"edge_id": "record:49", "head": "4", "relation": "has_record", "tail": "table:Decathlon:row:3", "source_type": "table", "source_id": "Decathlon", "row_index": 3, "column_name": "Rank", "header_path": ["Rank"], "structural": true, "traversal_from": "4", "traversal_to": "table:Decathlon:row:3", "direction": "forward"}, {"edge_id": "record:57", "head": "table:Decathlon:row:3", "relation": "athlete", "tail": "Irina Karpova ( KAZ )", "source_type": "table", "source_id": "Decathlon", "row_index": 3, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "traversal_from": "table:Decathlon:row:3", "traversal_to": "Irina Karpova ( KAZ )", "direction": "forward"}, {"edge_id": "record:185", "head": "Irina Karpova ( KAZ )", "relation": "linked_passage", "tail": "passage:/wiki/Irina_Karpova", "source_type": "table", "source_id": "Decathlon", "row_index": 3, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "contexts": [{"source_id": "/wiki/Irina_Karpova", "text": "Irina Vladimirovna Karpova ( née Naumenko , Kazakh : Ирина Владимировна Науменко ; born 13 February 1980 in Kamenogorsk , East Kazakhstan Region ) is a Kazakhstani heptathlete . Naumenko was 2nd at the Hexham International Combined Events Meeting in 2005 ( 5438pts ) She married Dmitriy Karpov , a decathlete . The pair has two children ( born 2009 and 2010 ) .", "context_before": "Talence is a commune in the Gironde department in Nouvelle-Aquitaine in southwestern France . It is the third-largest suburb of the city of Bordeaux , and is adjacent to it on the south side . It is a member of the metropolitan Urban Community of Bordeaux . Talence is the home of Décastar , a prestigious yearly international decathlon event . In Talence , there are different universities : Bordeaux University , Architecture School of Bordeaux , KEDGE Business School . San Mateo ( /ˌsæn məˈteɪ.oʊ/ SAN mə-TAY-oh ; Spanish for Saint Matthew ) is a city in San Mateo County , California , approximately 20 miles ( 32 km ) south of San Francisco , and 31 miles ( 50 km ) northwest of San Jose . San Mateo had an estimated 2017 population of 104,748 ."}], "traversal_from": "Irina Karpova ( KAZ )", "traversal_to": "passage:/wiki/Irina_Karpova", "direction": "forward"}], "steps": [{"step": 1, "goal": "4 --has_record--> table:Decathlon:row:3", "depends_on": null}, {"step": 2, "goal": "table:Decathlon:row:3 --athlete--> Irina Karpova ( KAZ )", "depends_on": 1}, {"step": 3, "goal": "Irina Karpova ( KAZ ) --linked_passage--> passage:/wiki/Irina_Karpova", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.0727}}, {"path_id": "row_2_12", "score": 15.8909, "score_components": {"grou