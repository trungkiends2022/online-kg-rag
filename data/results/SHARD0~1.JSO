}}}, "reasoning_paths": [{"path_id": "grounded_142", "score": 9.2286, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.4286, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Black Donnellys", "table:List of Canadian writers:row:12", "Thomas P. Kelley", "passage:/wiki/Thomas_P._Kelley"], "edges": [{"edge_id": "record:129", "head": "table:List of Canadian writers:row:12", "relation": "notable_works", "tail": "Black Donnellys", "source_type": "table", "source_id": "List of Canadian writers", "row_index": 12, "column_name": "Notable works", "header_path": ["Notable works"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Black Donnellys", "traversal_to": "table:List of Canadian writers:row:12", "direction": "reverse"}, {"edge_id": "record:117", "head": "Thomas P. Kelley", "relation": "has_record", "tail": "table:List of Canadian writers:row:12", "source_type": "table", "source_id": "List of Canadian writers", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of Canadian writers:row:12", "traversal_to": "Thomas P. Kelley", "direction": "reverse"}, {"edge_id": "record:215", "head": "Thomas P. Kelley", "relation": "linked_passage", "tail": "passage:/wiki/Thomas_P._Kelley", "source_type": "table", "source_id": "List of Canadian writers", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Thomas_P._Kelley", "text": "Thomas Patrick Kelley Jr. ( 6 April 1905 - 14 February 1982 ) was a Canadian author notable for two books on the infamous Black Donnellys of Lucan , Ontario . Kelley was born in Hastings , Ontario , the son of Thomas Patrick Kelley Sr. ( John Lawrence Monahon ) and English-born Nellie Burgess . He journeyed with his father 's medicine show until 1931 , then boxed professionally . In 1937 he began his prolific pulp writing career , with a sale to Weird Tales . He wrote many stories for Uncanny Tales , a Canadian pulp magazine . He was the author of some two-dozen paperback books , largely of the true-crime variety . Kelley claimed to be king of the Canadian pulp writers and the fastest author in the East . He died in Toronto . Kelley claimed that when he began a novel he had no idea how it would end , and had used 30 pseudonyms . He is most noted for his account of the Donnelly tragedy in 'The Black Donnellys ' . He later followed with the sequel 'Vengeance of The Black Donnellys ' , a fictionalized account of the vengeful vendetta undertaken by Francis Donnelly , one of the surviving members of the family on those responsible for the massacre of his parents and siblings . .", "context_before": ""}], "traversal_from": "Thomas P. Kelley", "traversal_to": "passage:/wiki/Thomas_P._Kelley", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of Canadian writers:row:12 --notable_works--> Black Donnellys [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Thomas P. Kelley --has_record--> table:List of Canadian writers:row:12 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Thomas P. Kelley --linked_passage--> passage:/wiki/Thomas_P._Kelley", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.2286}}, {"path_id": "grounded_53", "score": 9.2286, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_con