e_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 4, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:Germany at the 2012 European Athletics Championships:row:4", "traversal_to": "Leena Günther Anne Cibis Tatjana Lofamakanda Pinto Verena Sailer", "direction": "forward"}, {"edge_id": "record:239", "head": "Leena Günther Anne Cibis Tatjana Lofamakanda Pinto Verena Sailer", "relation": "linked_passage", "tail": "passage:/wiki/Verena_Sailer", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 4, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Verena_Sailer", "text": "Verena Sailer ( born 16 October 1985 in Illertissen ) is a retired German sprinter , who specialised in the 100 metres . Her personal best time is 11.02 seconds , achieved in August 2013 . She won the gold medal at the 2010 European Athletics Championships in Barcelona . During her sporting career she was a member of MTG Mannheim . Sailer represented Germany at the 2008 Summer Olympics in Beijing . She competed in the 4 × 100 metres relay together with Anne Möllinger , Cathleen Tschirch and Marion Wagner . In their first round heat they placed third behind Jamaica and Russia and in front of China . Their time of 43.59 seconds was the eighth time overall out of sixteen participating nations . With this result they qualified for the final , in which they sprinted to a time of 43.28 seconds , which was the fifth place . At the 2009 IAAF World Championships in Berlin , she made it to the semifinal of the 100 m and ran 11.24 seconds . She was the fourth leg of the German 4 × 100 m squad , which secured the bronze medal in a season 's best time of 42.87 seconds . At the 2012 Summer Olympics , she competed in the individual 100 m as well as the 4 × 100 m. Although she did not reach the individual final , the German team ( Sailer , Leena Günther , Anne Cibis and Tatjana Pinto ) did , finishing in 5th place .", "context_before": ""}], "traversal_from": "Leena Günther Anne Cibis Tatjana Lofamakanda Pinto Verena Sailer", "traversal_to": "passage:/wiki/Verena_Sailer", "direction": "forward"}], "steps": [{"step": 1, "goal": "Gold --has_record--> table:Germany at the 2012 European Athletics Championships:row:4", "depends_on": null}, {"step": 2, "goal": "table:Germany at the 2012 European Athletics Championships:row:4 --name--> Leena Günther Anne Cibis Tatjana Lofamakanda Pinto Verena Sailer", "depends_on": 1}, {"step": 3, "goal": "Leena Günther Anne Cibis Tatjana Lofamakanda Pinto Verena Sailer --linked_passage--> passage:/wiki/Verena_Sailer", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7222, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.0308}}, {"path_id": "grounded_299", "score": 14.0308, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.2308, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Gold", "table:Germany at the 2012 European Athletics Championships:row:4", "Verena Sailer", "passage:/wiki/Verena_Sailer"], "edges": [{"edge_id": "record:52", "head": "Gold", "relation": "has_record", "tail": "table:Germany at the 2012 European Athletics Championships:row:4", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 4, "column_name": "Medal", "header_path": ["Medal"], "structural": true, "traversal_from": "Gold", "traversal_to": "table:Germany at the 2012 European Athletics Championships:row:4", "direction": "forward"}, {"edge_id": "record:61", "head": "table:Germany at the 2012 European Athletics Championships:row:4", "relation": "name", "tail": "Verena Sailer", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 4, "column_name": "Name", "header_path": ["Name"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:Germany at the 2012 European Athletics Championships:row:4", "traversal_to": "Verena Sailer", "direction": "forward"}, {"edge_id": "record:240", "head": "Verena Sailer", "relation": "linked_passage", "tail": "passage:/wiki/Verena_Sailer", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 4, "column_name": "Name", "header_path": ["Name"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Verena_Sailer", "text": "Verena Sailer ( born 16 October 1985 in Illertissen ) is a retired German sprinter , who specialised in the 100 metres . Her personal best time is 11.02 seconds , achieved in August 2013 . She won the gold medal at the 2010 European Athletics Championships in Barcelona . During her sporting career she was a member of MTG Mannheim . Sailer represented Germany at the 2008 Summer Olympics in Beijing . She competed in the 4 × 100 metres relay together with Anne Möllinger , Cathleen Tschirch and Marion Wagner . In their first round heat they placed third behind Jamaica and Russia and in front of China . Their time of 43.59 seconds was the eighth time overall out of sixteen participating nations . With this result they qualified for the final , in which they sprinted to a time of 43.28 seconds , which was the fifth place . At the 2009 IAAF World Championships in Berlin , she made it to the semifinal of the 100 m and ran 11.24 seconds . She was the fourth leg of the German 4 × 100 m squad , which secured the bronze medal in a season 's best time of 42.87 seconds . At the 2012 Summer Olympics , she competed in the individual 100 m as well as the 4 × 100 m. Although she did not reach the individual final , the German team ( Sailer , Leena Günther , Anne Cibis and Tatjana Pinto ) did , finishing in 5th place .", "context_before": ""}], "traversal_from": "Verena Sailer", "traversal_to": "passage:/wiki/Verena_Sailer", "direction": "forward"}], "steps": [{"step": 1, "goal": "Gold --has_record--> table:Germany at the 2012 European Athletics Championships:row:4", "depends_on": null}, {"step": 2, "goal": "table:Germany at the 2012 European Athletics Championships:row:4 --name--> Verena Sailer", "depends_on": 1}, {"step": 3, "goal": "Verena Sailer --linked_passage--> passage:/wiki/Verena_Sailer", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7222, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.0308}}, {"path_id": "answer_evidence_record_165", "score": 103.0, "score_components": {"reverse_answer_match": 103.0}, "nodes": ["Bronze", "table:Germany at the 2012 European Athletics Championships:row:12"], "edges": [{"edge_id": "record:165", "head": "Bronze", "relation": "has_record", "tail": "table:Germany at the 2012 European Athletics Championships:row:12", "source_type": "table", "source_id": "Germany at the 2012 European Athletics Championships", "row_index": 12, "column_name": "Medal", "header_path": ["Medal"], "structural": true}], "steps": [{"step": 1, "goal": "Bronze --has_record--> table:Germany at the 2012 European Athletics Championships:row:12", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 103.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_167", "score": 103.0, "score_components": {