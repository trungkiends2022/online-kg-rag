"header_path": ["Flag bearer"], "structural": true, "contexts": [{"source_id": "/wiki/Josh_Laban", "text": "Joshua Noel Laban ( born December 25 , 1982 ) is an Olympic swimmer from the U.S. Virgin Islands . He was the USVI 's flagbearer for the 2008 Olympics and the 2007 Pan American Games . He attended college and swam at the University of Miami in Coral Gables , Florida , and University of Georgia in Athens , Georgia .", "context_before": ""}], "traversal_from": "Josh Laban", "traversal_to": "passage:/wiki/Josh_Laban", "direction": "forward"}], "steps": [{"step": 1, "goal": "14 --has_record--> table:List of flag bearers for the Virgin Islands at the Olympics:row:3", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3 --flag_bearer--> Josh Laban", "depends_on": 1}, {"step": 3, "goal": "Josh Laban --linked_passage--> passage:/wiki/Josh_Laban", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 15.0667}}, {"path_id": "answer_evidence_record_331", "score": 262.5, "score_components": {"reverse_answer_match": 262.5}, "nodes": ["1994", "passage:/wiki/1994_Winter_Olympics"], "edges": [{"edge_id": "record:331", "head": "1994", "relation": "linked_passage", "tail": "passage:/wiki/1994_Winter_Olympics", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 9, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "contexts": [{"source_id": "/wiki/1994_Winter_Olympics", "text": "The 1994 Winter Olympics ( Norwegian : Olympiske vinterleker 1994 ) , officially known as the XVII Olympic Winter Games , was a winter multi-sport event celebrated from 12 to 27 February 1994 in and around Lillehammer , Norway . Lillehammer failed to win the bid for the 1992 event , losing to Albertville . Lillehammer was awarded the 1994 Winter Olympics in 1988 , after beating Anchorage , United States ; Östersund , Sweden ; and Sofia , Bulgaria . Lillehammer is the northernmost city to ever host the Winter Games and the Olympic Games overall . The Games were the first to be held in a different year from the Summer Olympics , the first and only one to be held two years after the previous winter games . The Games were the second Winter Olympics hosted in Norway , after the 1952 Winter Olympics in Oslo , and the fourth Olympics in the Nordic countries , after the 1912 Summer Olympics in Stockholm , Sweden , and the 1952 Summer Olympics in Helsinki , Finland . Although many events took place in Lillehammer , skating took place in Hamar , some ice hockey matches were placed in Gjøvik , while Alpine skiing was held in Øyer and Ringebu . Sixty-seven countries and 1,737 athletes participated in six sports and sixty-one events . Fourteen countries made their debut in the Winter Olympics , of which nine were former Soviet republics . The Games also saw the introduction of stricter qualifying rules , reducing the number of under-performing participants from warm-weather countries . New events were two new distances in short track speed skating and aerials , while speed skating was moved indoors . Nearly two million people spectated the games , which were the first to have the Olympic truce in effect .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "1994 --linked_passage--> passage:/wiki/1994_Winter_Olympics", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 262.5, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_332", "score": 262.5, "score_components": {"reverse_answer_match": 262.5}, "nodes": ["1994 Winter Olympics", "passage:/wiki/1994_Winter_Olympics"], "edges": [{"edge_id": "record:332", "head": "1994 Winter Olympics", "relation": "linked_passage", "tail": "passage:/wiki/1994_Winter_Olympics", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 9, "column_name": "Event year", "header_path": ["Event year"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/1994_Winter_Olympics", "text": "The 1994 Winter Olympics ( Norwegian : Olympiske vinterleker 1994 ) , officially known as the XVII Olympic Winter Games , was a winter multi-sport event celebrated from 12 to 27 February 1994 in and around Lillehammer , Norway . Lillehammer failed to win the bid for the 1992 event , losing to Albertville . Lillehammer was awarded the 1994 Winter Olympics in 1988 , after beating Anchorage , United States ; Östersund , Sweden ; and Sofia , Bulgaria . Lillehammer is the northernmost city to ever host the Winter Games and the Olympic Games overall . The Games were the first to be held in a different year from the Summer Olympics , the first and only one to be held two years after the previous winter games . The Games were the second Winter Olympics hosted in Norway , after the 1952 Winter Olympics in Oslo , and the fourth Olympics in the Nordic countries , after the 1912 Summer Olympics in Stockholm , Sweden , and the 1952 Summer Olympics in Helsinki , Finland . Although many events took place in Lillehammer , skating took place in Hamar , some ice hockey matches were placed in Gjøvik , while Alpine skiing was held in Øyer and Ringebu . Sixty-seven countries and 1,737 athletes participated in six sports and sixty-one events . Fourteen countries made their debut in the Winter Olympics , of which nine were former Soviet republics . The Games also saw the introduction of stricter qualifying rules , reducing the number of under-performing participants from warm-weather countries . New events were two new distances in short track speed skating and aerials , while speed skating was moved indoors . Nearly two million people spectated the games , which were the first to have the Olympic truce in effect .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "1994 Winter Olympics --linked_passage--> passage:/wiki/1994_Winter_Olympics", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 262.5, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_semantic_133_0", "score": 262.5, "score_components": {"reverse_answer_match": 262.5}, "nodes": ["1994 Winter Olympics", "/wiki/1994_Winter_Olympics"], "edges": [{"edge_id": "semantic:133:0", "head": "1994 Winter Olympics", "relation": "linked_passage", "tail": "/wiki/1994_Winter_Olympics", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "source_group": null, "row_index": 9, "column_name": "Event year", "header_path": ["Event year"], "structural": false, "contexts": [{"source_id": "/wiki/1994_Winter_Olympics", "text": "The 1994 Winter Olympics ( Norwegian : Olympiske vinterleker 1994 ) , officially known as the XVII Olympic Winter Games , was a winter multi-sport event celebrated from 12 to 27 February 1994 in and around Lillehammer , Norway . Lillehammer failed to win the bid for the 1992 event , losing to Albertville . Lillehammer was awarded the 1994 Winter Olympics in 1988 , after beating Anchorage , United States ; Östersund , Sweden ; and Sofia , Bulgaria . Lillehammer is the northernmost city to ever host the Winter Games and the Olympic Games overall . The Games were the first to be held in a different year from the Summer Olympics , the first and only one to be held two years after the previous winter games . The Games were the second Winter Olympics hosted in Norway , after the 1952 Winter Olympics in Oslo , and the fourth Olympics in the Nordic countries , after the 1912 Summer Olympics in Stockholm , Sweden , and the 1952 Summer Olympics in Helsinki , Finland . Although many events took place in Lillehammer , skating took place in Hamar , some ice hockey matches were placed in Gjøvik , while Alpine skiing was held in Øyer and Ringebu . Sixty-seven countries and 1,737 athletes participated in six sports and sixty-one events . Fourteen countries made their debut in the Winter Olympics , of which nine were former Soviet republics . The Games also saw the introduction of stricter qualifying rules , reducing the number of under-performing participants from warm-weather countries . New events were two new distances in short track speed skating and aerials , while speed skating was moved indoors . Nearly two million people spectated the games , which were the first to have the Olympic truce in effect .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "1994 Winter Olympics --linked_passage--> /wiki/1994_Winter_Olympics", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 262.5, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_259", "best_path_score": 9.8167, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 11215, "llm_response_chars": 1, "llm_latency_ms": 50446.92, "wall_time_ms": 72776.15, "non_llm_time_ms": 22329.23, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
