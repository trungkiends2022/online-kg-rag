of the Western Zhou dynasty of c. 1045 - 771 BCE ; a popular name for Hubei is 楚 ( Chǔ ) ( suggested by that of the powerful State of Chu , which existed in the area during the Eastern Zhou dynasty of 770 - 256 BCE ) . The province borders Henan to the north , Anhui to the east , Jiangxi to the southeast , Hunan to the south , Chongqing to the west , and Shaanxi to the northwest . The high-profile Three Gorges Dam is located at Yichang , in the west of the province .", "context_before": ""}], "traversal_from": "passage:/wiki/Hubei", "traversal_to": "Hubei", "direction": "reverse"}, {"edge_id": "semantic:79:0", "head": "Hubei", "relation": "of_china_s_tujia_population", "tail": "2.17%", "source_type": "table", "source_id": "Tujia people", "source_group": null, "row_index": 18, "column_name": "% of China 's Tujia Population", "header_path": ["% of China 's Tujia Population"], "structural": false, "contexts": [], "traversal_from": "Hubei", "traversal_to": "2.17%", "direction": "forward"}, {"edge_id": "record:301", "head": "table:Tujia people:row:18:cell:% of China 's Tujia Population", "relation": "cell_value", "tail": "2.17%", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "% of China 's Tujia Population", "header_path": ["% of China 's Tujia Population"], "structural": true, "cell_node": true, "traversal_from": "2.17%", "traversal_to": "table:Tujia people:row:18:cell:% of China 's Tujia Population", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Hubei --linked_passage--> passage:/wiki/Hubei [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Hubei --of_china_s_tujia_population--> 2.17%", "depends_on": 1}, {"step": 3, "goal": "table:Tujia people:row:18:cell:% of China 's Tujia Population --cell_value--> 2.17% [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.85, "table_witness_indices": [0], "linked_witness": true, "numeric_evi