r": true, "selection_score": 15.425}, "grounded_247": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6818, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.775}, "grounded_183": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6818, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 14.425}, "grounded_246": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6818, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.775}, "grounded_135": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.3636, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.55}}}, "reasoning_paths": [{"path_id": "grounded_182", "score": 11.425, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.125, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Music Editor", "table:Chris Innis:row:9", "Spider-Man", "passage:/wiki/Spider-Man_(2002_film)"], "edges": [{"edge_id": "record:91", "head": "table:Chris Innis:row:9", "relation": "position", "tail": "Music Editor", "source_type": "table", "source_id": "Chris Innis", "row_index": 9, "column_name": "Position", "header_path": ["Position"], "structural": true, "traversal_from": "Music Editor", "traversal_to": "table:Chris Innis:row:9", "direction": "reverse"}, {"edge_id": "record:86", "head": "Spider-Man", "relation": "has_record", "tail": "table:Chris Innis:row:9", "source_type": "table", "source_id": "Chris Innis", "row_index": 9, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "table:Chris Innis:row:9", "traversal_to": "Spider-Man", "direction": "reverse"}, {"edge_id": "record:183", "head": "Spider-Man", "relation": "linked_passage", "tail": "passage:/wiki/Spider-Man_(2002_film)", "source_type": "table", "source_id": "Chris Innis", "row_index": 9, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Spider-Man_(2002_film)", "text": "Spider-Man is a 2002 American superhero film based on the Marvel Comics character of the same name . Directed by Sam Raimi from a screenplay by David Koepp , it is the first installment in the Spider-Man trilogy , and stars Tobey Maguire as the title character , alongside Willem Dafoe , Kirsten Dunst , James Franco , Cliff Robertson , and Rosemary Harris . The film centers on an outcast teen genius named Peter Parker , who develops spider-like superhuman abilities after being bitten by a genetically-altered spider . After his foster father/uncle is murdered by an armed felon , something of which he felt partially responsible , a guilt-ridden Parker is later driven to use his new abilities for a nobler purpose , as the hero/vigilante Spider-Man , to atone for his uncle 's murder . The rest of the film focuses on Parker 's efforts to balance his personal life as he graduates from high school and becomes a freelance photographer , while also struggling with his studies , his friendship with his childhood best friend Harry Osborn , his growing feelings for his former high school crush Mary Jane Watson , and his dual life as Spider-Man . After progress on the film stalled for nearly 25 years , it was licensed for a worldwide release by Columbia Pictures in 1999 after it acquired options from Metro-Goldwyn-Mayer on all previous scripts developed by Cannon Films , Carolco , and New Cannon . Exercising its option on just two elements from the multi-script acquisition ( a different screenplay was written by James Cameron , Ted Newsom , John Brancato , Barney Cohen , and Joseph Goldman ) , Sony hired Koepp to create a working screenplay ( credited as Cameron 's ) , and Koepp received sole credit in final billing . Directors Roland Emmerich , Ang Lee , Chris Columbus , Jan de Bont , M. Night Shyamalan , Tony Scott , and David Fincher were considered to direct the project before Raimi was hired as director in 2000 . The Koepp script was rewritten by Scott Rosenberg during pre-production and received a dialogue polish from Alvin Sargent during production . Filming took place in Los Angeles and New York City from January 8 to June 30 , 2001 . Sony Pictures Imageworks handled the film 's visual effects . Spider-Man premiered at the Mann Village Theater on April 29 , 2002 , and was released in the United States four days later on May 3 .", "context_before": ""}], "traversal_from": "Spider-Man", "traversal_to": "passage:/wiki/Spider-Man_(2002_film)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:Chris Innis:row:9 --position--> Music Editor [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Spider-Man --has_record--> table:Chris Innis:row:9 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Spider-Man --linked_passage--> passage:/wiki/Spider-Man_(2002_film)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6818, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 15.425}}, {"path_id": "grounded_247", "score": 9.775, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.125, "single_venue_specificity": 