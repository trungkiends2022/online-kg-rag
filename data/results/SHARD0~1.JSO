l_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Bay Olympic", "table:List of association football clubs in New Zealand:row:0", "New Lynn", "passage:/wiki/New_Lynn,_New_Zealand"], "edges": [{"edge_id": "record:0", "head": "Bay Olympic", "relation": "has_record", "tail": "table:List of association football clubs in New Zealand:row:0", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Team", "header_path": ["Team"], "structural": true, "traversal_from": "Bay Olympic", "traversal_to": "table:List of association football clubs in New Zealand:row:0", "direction": "forward"}, {"edge_id": "record:5", "head": "table:List of association football clubs in New Zealand:row:0", "relation": "location", "tail": "New Lynn", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Location", "header_path": ["Location"], "structural": true, "traversal_from": "table:List of association football clubs in New Zealand:row:0", "traversal_to": "New Lynn", "direction": "forward"}, {"edge_id": "record:143", "head": "New Lynn", "relation": "linked_passage", "tail": "passage:/wiki/New_Lynn,_New_Zealand", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Location", "header_path": ["Location"], "structural": true, "contexts": [{"source_id": "/wiki/New_Lynn,_New_Zealand", "text": "New Lynn is a residential suburb in Auckland , New Zealand . It has 5859 occupied dwellings and a population of 16,461 ( 2013 census ) . The population has seen a 17 per cent ( 2,400 people ) increase since 2001 . New Lynn is located towards the west of the Auckland urban area , 10 kilometres to the southwest of the Auckland city centre . The former boundary between Waitakere City and Auckland City lay at the eastern edge of the suburb . Suburbs surrounding New Lynn include Blockhouse Bay , Avondale , Titirangi and Green Bay . New Lynn is located at a narrowing of the Auckland isthmus , and one of the two narrowest points joining the Northland Peninsula to the rest of the North Island ( the other is at Otahuhu , to the southeast ) . At this point , between the Whau River ( an estuarial arm of the Waitematā Harbour ) in the north and Blockhouse Bay in the south , the island is a mere 2800 metres wide . The town centre is undergoing a transformation as part of the Auckland City brownfield redevelopment programme , but currently remains dominated by a suburban mall , LynnMall . In the town centre one of Auckland 's main public transit interchanges links west Auckland with other parts of the city by rail and bus . At the southern end of the suburb is one of Auckland 's best known golf courses , Titirangi Golf Club . Although the early houses in New Lynn were made of locally produced brick , most older houses are of weatherboard and corrugated iron , and were originally on large sections .", "context_before": ""}], "traversal_from": "New Lynn", "traversal_to": "passage:/wiki/New_Lynn,_New_Zealand", "direction": "forward"}], "steps": [{"step": 1, "goal": "Bay Olympic --has_record--> table:List of association football clubs in New Zealand:row:0", "depends_on": null}, {"step": 2, "goal": "table:List of association football clubs in New Zealand:row:0 --location--> New Lynn", "depends_on": 1}, {"step": 3, "goal": "New Lynn --linked_passage--> passage:/wiki/New_Lynn,_New_Zealand", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.8}}, {"path_id": "grounded_86", "score": 12.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 2.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Bay Olympic", "table:List of association football clubs in New Zealand:row:0", "New Lynn, New Zealand", "passage:/wiki/New_Lynn,_New_Zealand"], "edges": [{"edge_id": "record:0", "head": "Bay Olympic", "relation": "has_record", "tail": "table:List of association football clubs in New Zealand:row:0", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Team", "header_path": ["Team"], "structural": true, "traversal_from": "Bay Olympic", "traversal_to": "table:List of association football clubs in New Zealand:row:0", "direction": "forward"}, {"edge_id": "record:6", "head": "table:List of association football clubs in New Zealand:row:0", "relation": "location", "tail": "New Lynn, New Zealand", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Location", "header_path": ["Location"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:List of association football clubs in New Zealand:row:0", "traversal_to": "New Lynn, New Zealand", "direction": "forward"}, {"edge_id": "record:144", "head": "New Lynn, New Zealand", "relation": "linked_passage", "tail": "passage:/wiki/New_Lynn,_New_Zealand", "source_type": "table", "source_id": "List of association football clubs in New Zealand", "row_index": 0, "column_name": "Location", "header_path": ["Location"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/New_Lynn,_New_Zealand", "text": "New Lynn is a residential suburb in Auckland , New Zealand . It has 5859 occupied dwellings and a population of 16,461 ( 2013 census ) . The population has seen a 17 per cent ( 2,400 people ) increase since 2001 . New Lynn is located towards the west of the Auckland urban area , 10 kilometres to the southwest of the Auckland city centre . The former boundary between Waitakere City and Auckland City lay at the eastern edge of the suburb . Suburbs surrounding New Lynn include Blockhouse Bay , Avondale , Titirangi and Green Bay . New Lynn is located at a narrowing of the Auckland isthmus , and one of the two narrowest points joining the Northland Peninsula to the rest of the North Island ( the other is at Otahuhu , to the southeast ) . At this point , between the Whau River ( an estuarial arm of the Waitematā Harbour ) in the north and Blockhouse Bay in the south , the island is a mere 2800 metres wide . The town centre is undergoing a transformation as part of the Auckland City brownfield redevelopment programme , but currently remains dominated by a suburban mall , LynnMall . In the town centre one of Auckland 's main public transit interchanges links west Auckland with other parts of the city by rail and bus . At the southern end of the suburb is one of Auckland 's best known golf courses , Titirangi Golf Club . Although the early houses in New Lynn were made of locally produced brick , most older houses are of weatherboard and corrugated iron , and were originally on large sections .", "context_before": ""}], "traversal_from": "New Lynn, New Zealand", "traversal_to": "passage:/wiki/New_Lynn,_New_Zealand", "direction": "forward"}], "steps": [{"step": 1, "goal": "Bay Olympic --has_record--> table:List of association football clubs in New Zealand:row:0", "depends_on": null}, {"step": 2, "goal": "table:List of association football clubs in New Zealand:row:0 --location--> New Lynn, New Zealand", "depends_on": 1}, {"step": 3, "goal": "New Lynn, New Zealand --linked_pass