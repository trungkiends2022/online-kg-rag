tity_match": 1.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/La_Violencia", "La Violencia", "table:List of wars and anthropogenic disasters by death toll:row:1", "Colombia"], "edges": [{"edge_id": "record:293", "head": "La Violencia", "relation": "linked_passage", "tail": "passage:/wiki/La_Violencia", "source_type": "table", "source_id": "List of wars and anthropogenic disasters by death toll", "row_index": 1, "column_name": "Event", "header_path": ["Event"], "structural": true, "contexts": [{"source_id": "/wiki/La_Violencia", "text": "La Violencia ( Spanish pronunciation : [ la βjoˈlensja ] , The Violence ) was a ten-year civil war in Colombia from 1948 to 1958 , between the Colombian Conservative Party and the Colombian Liberal Party , fought mainly in the countryside . La Violencia is considered to have begun with the 9 April 1948 assassination of the popular politician Jorge Eliécer Gaitán , a Liberal Party presidential candidate for the election in November 1949 . His murder provoked the Bogotazo rioting that lasted for ten hours and killed some 5,000 people . An alternative historiography proposes as the start the Conservatives ' return to power following the election of 1946 . Rural town police and political leaders encouraged Conservative-supporting peasants to seize the agricultural lands of Liberal-supporting peasants , which provoked peasant-to-peasant violence throughout Colombia . La Violencia is estimated to have cost the lives of at least 200,000 people .", "context_before": ""}], "traversal_from": "passage:/wiki/La_Violencia", "traversal_to": "La Violencia", "direction": "reverse"}, {"edge_id": "record:17", "head": "La Violencia", "relation": "has_record", "tail": "table:List of wars and anthropogenic disasters by death toll:row:1", "source_type": "table", "source_id": "List of wars and anthropogenic disasters by death toll", "row_index": 1, "column_name": "Event", "header_path": ["Event"], "structural": true, "traversal_from": "La Violencia", "traversal_to": "table:List of wars and anthropogenic disasters by death toll:row:1", "direction": "forward"}, {"edge_id": "record:25", "head": "table:List of wars and anthropogenic disasters by death toll:row:1", "relation": "country", "tail": "Colombia", "source_type": "table", "source_id": "List of wars and anthropogenic disasters by death toll", "row_index": 1, "column_name": "Country", "header_path": ["Country"], "structural": true, "traversal_from": "table:List of wars and anthropogenic disasters by death toll:row:1", "traversal_to": "Colombia", "direction": "forward"}], "steps": [{"step": 1, "goal": "La Violencia --linked_passage--> passage:/wiki/La_Violencia [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "La Violencia --has_record--> table:List of wars and anthropogenic disasters by death toll:row:1", "depends_on": 1}, {"step": 3, "goal": "table:List of wars and anthropogenic disasters by death toll:row:1 --country--> Colombia", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.75, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 16.4667}}, {"path_id": "grounded_235", "score": 11.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong