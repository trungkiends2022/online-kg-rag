l, "terminal_is_container": true, "selection_score": 17.3}}}, "reasoning_paths": [{"path_id": "grounded_284", "score": 14.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 5.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Bathurst,_New_South_Wales", "Bathurst", "table:1884 New Zealand rugby union tour of New South Wales:row:5", "6"], "edges": [{"edge_id": "record:170", "head": "Bathurst", "relation": "linked_passage", "tail": "passage:/wiki/Bathurst,_New_South_Wales", "source_type": "table", "source_id": "1884 New Zealand rugby union tour of New South Wales", "row_index": 5, "column_name": "City", "header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/Bathurst,_New_South_Wales", "text": "Bathurst /ˈbæθərst/ is a city in the Central Tablelands of New South Wales , Australia . It is about 200 kilometres ( 120 mi ) west-northwest of Sydney and is the seat of the Bathurst Regional Council . Bathurst is the oldest inland settlement in Australia and had a population of 36,801 at June 2018 . Bathurst is often referred to as the Gold Country as it was the site of the first gold discovery and where the first gold rush occurred in Australia . Bathurst is the second oldest inland city behind Goulburn as stated by historian Oscar Cunningham . Today education , tourism and manufacturing drive the economy . The internationally known racetrack Mount Panorama is a landmark of the city . Bathurst has a historic city centre with many ornate buildings remaining from the gold rush period of the mid to late 19th century . The median age of the city 's population is 35 years ; which is particularly young for a regional centre ( the state median is 38 ) , and is related to the large education sector in the community . Population growth has reached 1.6% per annum over the five years until 2010 , making Bathurst the seventh fastest growing regional city in New South Wales . This growth over recent years has resulted in increased urban development including retail precincts , sporting facilities , housing estates and expanding industrial areas .", "context_before": ""}], "traversal_from": "passage:/wiki/Bathurst,_New_South_Wales", "traversal_to": "Bathurst", "direction": "reverse"}, {"edge_id": "record:107", "head": "table:1884 New Zealand rugby union tour of New South Wales:row:5", "relation": "city", "tail": "Bathurst", "source_type": "table", "source_id": "1884 New Zealand rugby union tour of New South Wales", "row_index": 5, "column_name": "City", "header_path": ["City"], "structural": true, "traversal_from": "Bathurst", "traversal_to": "table:1884 New Zealand rugby union tour of New South Wales:row:5", "direction": "reverse"}, {"edge_id": "record:96", "head": "6", "relation": "has_record", "tail": "table:1884 New Zealand rugby union tour of New South Wales:row:5", "source_type": "table", "source_id": "1884 New Zealand rugby union tour of New South Wales", "row_index": 5, "column_name": "#", "header_path": ["#"], "structural": true, "traversal_from": "table:1884 New Zealand rugby union tour of New South Wales:row:5", "traversal_to": "6", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Bathurst --linked_passage--> passage:/wiki/Bathurst,_New_South_Wales [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:1884 New Zealand rugby union tour of New South Wales:row:5 --city--> Bathurst [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "6 --has_record--> table:1884 New Zealand rugby union tour of New South Wales:row:5 [traverse reverse]", "depends_on": 2}], "path_verificat