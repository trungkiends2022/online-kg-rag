ch 's mural representing Christ in Majesty , designed in 1954 , is above the chancel arch . The exterior is rendered --linked_passage--> passage:/wiki/Hans_Feibusch", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8462, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 14.05}}, {"path_id": "grounded_1659", "score": 9.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Hans Feibusch", "table:List of places of worship in Worthing:row:1", "St Mary 's Church", "passage:/wiki/St_Mary's_Church,_Goring-by-Sea"], "edges": [{"edge_id": "record:47", "head": "table:List of places of worship in Worthing:row:1", "relation": "notes", "tail": "Hans Feibusch", "source_type": "table", "source_id": "List of places of worship in Worthing", "row_index": 1, "column_name": "Notes", "header_path": ["Notes"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Hans Feibusch", "traversal_to": "table:List of places of worship in Worthing:row:1", "direction": "reverse"}, {"edge_id": "record:24", "head": "St Mary 's Church", "relation": "has_record", "tail": "table:List of places of worship in Worthing:row:1", "source_type": "table", "source_id": "List of places of worship in Worthing", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of places of worship in Worthing:row:1", "traversal_to": "St Mary 's Church", "direction": "reverse"}, {"edge_id": "record:451", "head": "St Mary 's Church", "relation": "linked_passage", "tail": "passage:/wiki/St_Mary's_Church,_Goring-by-Sea", "source_type": "table", "source_id": "List of places of worship in Worthing", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/St_Mary's_Church,_Goring-by-Sea", "text": "St Mary 's Church is an Anglican church in the Goring-by-Sea area of the Borough of Worthing , one of seven local government districts in the English county of West Sussex . The late Norman parish church of the ancient village of Goring retains some architectural elements from that period , but Decimus Burton 's comprehensive restoration of 1837 has given the church its present Gothic Revival exterior appearance . German artist Hans Feibusch , who worked extensively in the Diocese of Chichester , provided a mural in 1954 : it is considered impressive , but caused controversy at the time . English Heritage has listed the church at Grade II* for its architectural and historical importance .", "context_before": ""}], "traversal_from": "St Mary 's Church", "traversal_to": "passage:/wiki/St_Mary's_Church,_Goring-by-Sea", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of places of worship in Worthing:row:1 --notes--> Hans Feibusch [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "St Mary 's Church --has_record--> table:List of places of worship in Worthing:row:1 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "St Mary 's Church --linked_passage--> passage:/wiki/St_Mary's_Church,_Goring-by-Sea", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8462, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.8}}], "best_path_id": "grounded_1853", "best_path_score": 10.05, "execution_mode": "path_tex