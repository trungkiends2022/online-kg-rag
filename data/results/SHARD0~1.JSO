"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9412, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.65}, "grounded_1363": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9412, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.3}}}, "reasoning_paths": [{"path_id": "row_14_71", "score": 18.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.8333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Castalia 4769", "table:List of Solar System objects by size:row:14", "Apollo asteroid type S ; contact binary", "passage:/wiki/S-type_asteroid"], "edges": [{"edge_id": "record:196", "head": "Castalia 4769", "relation": "has_record", "tail": "table:List of Solar System objects by size:row:14", "source_type": "table", "source_id": "List of Solar System objects by size", "row_index": 14, "column_name": "Body", "header_path": ["Body"], "structural": true, "traversal_from": "Castalia 4769", "traversal_to": "table:List of Solar System objects by size:row:14", "direction": "forward"}, {"edge_id": "record:204", "head": "table:List of Solar System objects by size:row:14", "relation": "type_notes", "tail": "Apollo asteroid type S ; contact binary", "source_type": "table", "source_id": "List of Solar System objects by size", "row_index": 14, "column_name": "Type - notes", "header_path": ["Type - notes"], "structural": true, "traversal_from": "table:List of Solar System objects by size:row:14", "traversal_to": "Apollo asteroid type S ; contact binary", "direction": "forward"}, {"edge_id": "record:370", "head": "Apollo asteroid type S ; contact binary", "relation": "linked_passage", "tail": "passage:/wiki/S-type_asteroid", "source_type": "table", "source_id": "List of Solar System objects by size", "row_index": 14, "column_name": "Type - notes", "header_path": ["Type - notes"], "structural": true, "contexts": [{"source_id": "/wiki/S-type_asteroid", "text": "S-type asteroids are asteroids with a spectral type that is indicative of a siliceous ( i.e . stony ) mineralogical composition , hence the name . Approximately 17% of asteroids are of this type , making it the second most common after the carbonaceous C-type .", "context_before": "1620 Geographos ( /dʒiːoʊˈɡræfɒs/ ) , provisional designation 1951 RA , is a highly elongated , stony asteroid , near-Earth object and potentially hazardous asteroid of the Apollo group , with a mean-diameter of approximately 2.5 km ( 1.6 mi ) . It was discovered on 14 September 1951 , by astronomers Albert George Wilson and Rudolph Minkowski at the Palomar Observatory in California , United States . The asteroid was named in honor of the National Geographic Society . The Apollo asteroids are a group of near-Earth asteroids named after 1862 Apollo , discovered by German astronomer Karl Reinmuth in the 1930s . They are Earth-crossing asteroids that have an orbital semi-major axis greater than that of the Earth ( > 1 AU ) but perihelion distances less than the Earth 's aphelion distance ( q < 1.017 AU ) . As of December 2018 [ update ] the number of known Apollo asteroids is 10,485 , making the class the largest group of near-Earth objects ( cf . the Aten , Amor and Atira asteroids ) , of which 1,409 are numbered ( asteroids are not numbered until they have been observed at two or more oppositions ) , and 1,648 are identified as potentially hazardous asteroids . The closer their semi-major axis is to Earth 's , the less eccentricity is needed for the orbits to cross . The February 15 , 2013 Chelyabinsk meteor that exploded over the city of Chelyabinsk in the southern Urals region of Russia , injuring an estimated 1,500 people with flying glass from broken windows , was an Apollo-class asteroid ."}], "traversal_from": "Apollo asteroid type S ; contact binary", "traversal_to": "passage:/wiki/S-type_asteroid", "direction": "forward"}], "steps": [{"step": 1, "goal": "Castalia 4769 --has_record--> table:List of Solar System objects by size:row:14", "depends_on": null}, {"step": 2, "goal": "table:List of Solar System objects by size:row:14 --type_notes--> Apollo asteroid type S ; contact binary", "depends_on": 1}, {"step": 3, "goal": "Apollo asteroid type S ; contact binary --linked_passage--> passage:/wiki/S-type_asteroid", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9412, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 22.3}}, {"path_id": "row_17_86", "score": 17.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.8333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Moshup 66391", "table:List of Solar System objects by size:row:17", "Aten asteroid type S ; binary", "passage:/wiki/S-type_asteroid"], "edges": [{"edge_id": "record:238", "head": "Moshup 66391", "relation": "has_record", "tail": "table:List of Solar System objects by size:row:17", "source_type": "table", "source_id": "List of Solar System objects by siz