ela was not good , in fact it was selected as the worst one of 1982 . Daniela Romo and Gregorio Casal starred as protagonists , while the first actress Beatriz Aguirre and Elizabeth Dupeyrón starred as antagonists .", "context_before": ""}], "traversal_from": "Déjame vivir", "traversal_to": "/wiki/Déjame_vivir", "direction": "forward"}], "steps": [{"step": 1, "goal": "1982 --has_record--> table:Daniela Romo:row:3", "depends_on": null}, {"step": 2, "goal": "table:Daniela Romo:row:3 --title--> Déjame vivir", "depends_on": 1}, {"step": 3, "goal": "Déjame vivir --linked_passage--> /wiki/Déjame_vivir", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 18.7286}}, {"path_id": "grounded_102", "score": 13.5143, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.7143, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Estrella", "1982", "Déjame vivir", "/wiki/Déjame_vivir"], "edges": [{"edge_id": "semantic:9:0", "head": "1982", "relation": "role", "tail": "Estrella", "source_type": "table", "source_id": "Daniela Romo", "source_group": null, "row_index": 3, "column_name": "Role", "header_path": ["Role"], "structural": false, "contexts": [], "traversal_from": "Estrella", "traversal_to": "1982", "direction": "reverse"}, {"edge_id": "semantic:8:0", "head": "1982", "relation": "title", "tail": "Déjame vivir", "source_type": "table", "source_id": "Daniela Romo", "source_group": null, "row