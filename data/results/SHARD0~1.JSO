of the Western Han were descendants of Emperor Wu , while all emperors of the Eastern Han were descendants of his sixth son Liu Fa , Prince Ding of Changsha .", "context_before": ""}], "traversal_from": "Records of the Grand Historian ( 史記 , shiki , Chin . Shiji ) , vol . 11 of the Imperial Biographies ( 本紀 , Chin . Benji ) : Chronicle of the Emperor Jing of Han Dynasty", "traversal_to": "passage:/wiki/Emperor_Jing_of_Han", "direction": "forward"}], "steps": [{"step": 1, "goal": "Records of the Grand Historian ( 史記 , shiki , Chin . Shiji ) , vol . 11 of the Imperial Biographies ( 本紀 , Chin . Benji ) : Chronicle of the Emperor Jing of Han Dynasty --present_location--> Tokyo Tokyo Daitokyu Memorial Library Daitōkyū Memorial Library ( 大東急記念文庫 , daitōkyū kinen bunko ) , Tokyo [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Records of the Grand Historian ( 史記 , shiki , Chin . Shiji ) , vol . 11 of the Imperial Biographies ( 本紀 , Chin . Benji ) : Chronicle of the Emperor Jing of Han Dynasty --linked_passage--> passage:/wiki/Emperor_Jing_of_Han", "depends_on": 1}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7143, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.2333}}], "best_path_id": "grounded_356", "best_path_score": 9.8833, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 14506, "llm_response_chars": 6, "llm_latency_ms": 27105.63, "wall_time_ms": 71022.03, "non_llm_time_ms": 43916.4, "input_tokens": null, "output_tokens": null, "exact_match": 1.0, "semantic_exact_match": 1.0, "f1": 1.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold