 has been in existence . The historic electorate was represented by 21 members of parliament . For some of the time , it was represented by one member at a time . During other periods , it was one of the few three-member electorates in New Zealand .", "context_before": ""}], "traversal_from": "Christchurch", "traversal_to": "passage:/wiki/Christchurch_(New_Zealand_electorate)", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:3rd New Zealand Parliament:row:9 --mp_s_term--> First [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:3rd New Zealand Parliament:row:9 --electorate--> Christchurch", "depends_on": 1}, {"step": 3, "goal": "Christchurch --linked_passage--> passage:/wiki/Christchurch_(New_Zealand_electorate)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8462, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.5223}}], "best_path_id": "row_9_40", "best_path_score": 13.8, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 11069, "llm_response_chars": 4, "llm_latency_ms": 46464.37, "wall_time_ms": 69767.54, "non_llm_time_ms": 23303.17, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "judge_contract", "is_ambiguous": null, "ambiguity_status": null}
