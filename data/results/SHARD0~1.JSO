aban", "direction": "reverse"}, {"edge_id": "record:63", "head": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3", "relation": "flag_bearer", "tail": "Josh Laban", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 3, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "Josh Laban", "traversal_to": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3", "direction": "reverse"}, {"edge_id": "record:51", "head": "14", "relation": "has_record", "tail": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 3, "column_name": "#", "header_path": ["#"], "structural": true, "traversal_from": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3", "traversal_to": "14", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Josh Laban --linked_passage--> passage:/wiki/Josh_Laban [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of flag bearers for the Virgin Islands at the Olympics:row:3 --flag_bearer--> Josh Laban [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "14 --has_record--> table:List of flag bearers for the Virgin Islands at the Olympics:row:3 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 16.0667}}, {"path_id": "grounded_717", "score": 9.1667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 1.2, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Cy_Thompson", "Cy Thompson", "table:List of flag bearers for the Virgin Islands at the Olympics:row:0", "17"], "edges": [{"edge_id": "record:290", "head": "Cy Thompson", "relation": "linked_passage", "tail": "passage:/wiki/Cy_Thompson", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 0, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "contexts": [{"source_id": "/wiki/Cy_Thompson", "text": "Cy Thompson ( born 1 July 1988 in Saint Thomas ) is a Virgin Islands sailor . He competed at the 2012 Summer Olympics in the Men 's Laser class . Cy Thompson qualified for the 2016 Summer Olympics and was the Virgin Islands ' flag bearer . He finished 19th in the Men 's Laser class competition . His grandfather , Rudy Thompson , was also an Olympic sailor for the Virgin Islands .", "context_before": "The 2016 Summer Olympics ( Portuguese : Jogos Olímpicos de Verão de 2016 ) , [ a ] officially known as the Games of the XXXI Olympiad ( Portuguese : Jogos da XXXI Olimpíada ) and commonly known as Rio 2016 , was an international multi-sport event that was held from 5 to 21 August 2016 in Rio de Janeiro , Brazil , with preliminary events in some sports beginning on 3 August . These were the first Olympic Games ever to be held in South America and the fourth to be held in a developing country , after the 1968 Summer Olympics in Mexico , the 1980 Summer Olympics in the Soviet Union , and the 2008 Summer Olympics in China . More than 11,000 athletes from 205 National Olympic Committees took part , including first time entrants Kosovo , South Sudan , and the Refugee Olympic Team . With 306 sets of medals , the games featured 28 Olympic sports , including rugby sevens and golf , which were added to the Olympic program in 2009 . These sporting events took place at 33 venues in the host city and at five separate venues in the Brazilian cities of São Paulo , Belo Horizonte , Salvador , Brasília , and Manaus . These were the first Summer Olympic Games to take place under the International Olympic Committee ( IOC ) presidency of Thomas Bach . The host city Rio de Janeiro was announced at the 121st IOC Session in Copenhagen , Denmark , on 2 October 2009 . Rio became the first South American city ever to host the Olympic Games . These were the first games to be held in a Portuguese-speaking country , the first summer edition to be held entirely in the host country 's winter season , the first since 1968 to be held in Latin America , and the first since 2000 to be held in the Southern Hemisphere . The United States topped the medal table , winning the most gold and overall medals , 46 and 121 , as well as its 1,000th Summer Olympic gold medal overall . Great Britain finished second and became only the second country in modern Olympic history to increase its tally of medals in the Olympiad immediately after it had been host nation . China finished third ."}], "traversal_from": "passage:/wiki/Cy_Thompson", "traversal_to": "Cy Thompson", "direction": "reverse"}, {"edge_id": "record:12", "head": "table:List of flag bearers for the Virgin Islands at the Olympics:row:0", "relation": "flag_bearer", "tail": "Cy Thompson", "source_type": "table", "source_id": "List of flag bearers for the Virgin Islands at the Olympics", "row_index": 0, "column_name": "Flag bearer", "header_path": ["Flag bearer"], "structural": true, "traversal_from": "Cy Thompson", "traversal_to": "table:List of flag bearers for the Virgin Islands at the Olympics:row:0", "direction": "reverse"}, {"edge_id": "record:0", "head": "17", "relation": "has_record", "tail": "table:List of flag bearers for the Virgin Islands at the Olympics:row:0", "source_typ