age": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1984", "table:Triple jump:row:17", "Oleg Protsenko ( URS )", "passage:/wiki/Oleg_Protsenko"], "edges": [{"edge_id": "record:221", "head": "1984", "relation": "has_record", "tail": "table:Triple jump:row:17", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1984", "traversal_to": "table:Triple jump:row:17", "direction": "forward"}, {"edge_id": "record:229", "head": "table:Triple jump:row:17", "relation": "athlete", "tail": "Oleg Protsenko ( URS )", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "traversal_from": "table:Triple jump:row:17", "traversal_to": "Oleg Protsenko ( URS )", "direction": "forward"}, {"edge_id": "record:309", "head": "Oleg Protsenko ( URS )", "relation": "linked_passage", "tail": "passage:/wiki/Oleg_Protsenko", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "contexts": [{"source_id": "/wiki/Oleg_Protsenko", "text": "Oleg Valeryevich Protsenko ( Russian : Олег Валерьевич Проценко ; born 11 August 1963 in Soltsy , Novgorod , USSR ) is a former Soviet athlete . He was one of the world 's finest triple jumpers during the 1980s . However , his record at major championships was rather poor in comparison with his prowess at minor meets . Already a fine triple-jumper in 1983 , Protsenko rocketed to the top of the yearis lists in 1984 with 17.52m leap in 1984 . Bad for him was that he was denied of competing at the Olympic Games in L.A. due to Soviet boycott . His winning triple jump at the Olympic boycott meet in Moscow of 17.46m was 20 cm longer than that of the Olympic champion in Los Angeles . Oleg begun 1985 with unlucky 4th-place finish at the inaugural World Indoor Games in Paris , but improved upon that , setting European Record on 4 August in Leningrad with a triple jump of 17.69m . He lost his record only several days later to Christo Markov ( Bulgaria ) , but picked his first international medal later in the season when finished second to World Record holder Willie Banks ( USA ) at the World Cup in Canberra with fine 17.47m . Protsenko added bronze at the next years European Championships in Stuttgart and had dream start of 1987 season breaking the World Indoor Record on 15 January in Osaka , leaping 17.67m . He had memorable battle with Mike Conley ( USA ) on 27 February in New York , losing his freshly set record , but recording 17.57m for second place . Several days later he won silver at the World Indoor Championships in Indianapolis again finishing behind Conley . It seemed that Protsenko is destined for a medal at the World Outdoor Champs in Rome when winning at European Cup in Prague with 17.61m , but he finished only 8th in Rome with 17.23m .", "context_before": ""}], "traversal_from": "Oleg Protsenko ( URS )", "traversal_to": "passage:/wiki/Oleg_Protsenko", "direction": "forward"}], "steps": [{"step": 1, "goal": "1984 --has_record--> table:Triple jump:row:17", "depends_on": null}, {"step": 2, "goal": "table:Triple jump:row:17 --athlete--> Oleg Protsenko ( URS )", "depends_on": 1}, {"step": 3, "goal": "Oleg Protsenko ( URS ) --linked_passage--> passage:/wiki/Oleg_Protsenko", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.3}}, {"path_id": "grounded_244", "score": 19.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1984", "table:Triple jump:row:17", "Oleg Protsenko", "passage:/wiki/Oleg_Protsenko"], "edges": [{"edge_id": "record:221", "head": "1984", "relation": "has_record", "tail": "table:Triple jump:row:17", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1984", "traversal_to": "table:Triple jump:row:17", "direction": "forward"}, {"edge_id": "record:230", "head": "table:Triple jump:row:17", "relation": "athlete", "tail": "Oleg Protsenko", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:Triple jump:row:17", "traversal_to": "Oleg Protsenko", "direction": "forward"}, {"edge_id": "record:310", "head": "Oleg Protsenko", "relation": "linked_passage", "tail": "passage:/wiki/Oleg_Protsenko", "source_type": "table", "source_id": "Triple jump", "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Oleg_Protsenko", "text": "Oleg Valeryevich Protsenko ( Russian : Олег Валерьевич Проценко ; born 11 August 1963 in Soltsy , Novgorod , USSR ) is a former Soviet athlete . He was one of the world 's finest triple jumpers during the 1980s . However , his record at major championships was rather poor in comparison with his prowess at minor meets . Already a fine triple-jumper in 1983 , Protsenko rocketed to the top of the yearis lists in 1984 with 17.52m leap in 1984 . Bad for him was that he was denied of competing at the Olympic Games in L.A. due to Soviet boycott . His winning triple jump at the Olympic boycott meet in Moscow of 17.46m was 20 cm longer than that of the Olympic champion in Los Angeles . Oleg begun 1985 with unlucky 4th-place finish at the inaugural World Indoor Games in Paris , but improved upon that , setting European Record on 4 August in Leningrad with a triple jump of 17.69m . He lost his record only several days later to Christo Markov ( Bulgaria ) , but picked his first international medal later in the season when finished second to World Record holder Willie Banks ( USA ) at the World Cup in Canberra with fine 17.47m . Protsenko added bronze at the next years European Championships in Stuttgart and had dream start of 1987 season breaking the World Indoor Record on 15 January in Osaka , leaping 17.67m . He had memorable battle with Mike Conley ( USA ) on 27 February in New York , losing his freshly set record , but recording 17.57m for second place . Several days later he won silver at the World Indoor Championships in Indianapolis again finishing behind Conley . It seemed that Protsenko is destined for a medal at the World Outdoor Champs in Rome when winning at European Cup in Prague with 17.61m , but he finished only 8th in Rome with 17.23m .", "context_before": ""}], "traversal_from": "Oleg Protsenko", "traversal_to": "passage:/wiki/Oleg_Protsenko", "direction": "forward"}], "steps": [{"step": 1, "goal": "1984 --has_record--> table:Triple jump:row:17", "depends_on": null}, {"step": 2, "goal": "table:Triple jump:row:17 --athlete--> Oleg Protsenko", "depends_on": 1}, {"step": 3, "goal": "Oleg Protsenko --linked_passage--> passage:/wiki/Oleg_Protsenko", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.3}}, {"path_id": "grounded_224", "score": 17.65, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.35}, "nodes": ["1984", "Oleg Protsenko ( URS )", "/wiki/Oleg_Protsenko"], "edges": [{"edge_id": "semantic:88:0", "head": "1984", "relation": "athlete", "tail": "Oleg Protsenko ( URS )", "source_type": "table", "source_id": "Triple jump", "source_group": null, "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": false, "contexts": [], "traversal_from": "1984", "traversal_to": "Oleg Protsenko ( URS )", "direction": "forward"}, {"edge_id": "semantic:90:0", "head": "Oleg Protsenko ( URS )", "relation": "linked_passage", "tail": "/wiki/Oleg_Protsenko", "source_type": "table", "source_id": "Triple jump", "source_group": null, "row_index": 17, "column_name": "Athlete", "header_path": ["Athlete"], "structural": false, "contexts": [{"source_id": "/wiki/Oleg_Protsenko", "text": "Oleg Valeryevich Protsenko ( Russian : Олег Валерьевич Проценко ; born 11 August 1963 in Soltsy , Novgorod , USSR ) is a former Soviet athlete . He was one of the world 's finest triple jumpers during the 1980s . However , his record at major championships was rather poor in comparison with his prowess at minor meets . Already a fine triple-jumper in 1983 , Protsenko rocketed to the top of the yearis lists in 1984 with 17.52m leap in 1984 . Bad for him was that he was denied of competing at the Olympic Games in L.A. due to Soviet boycott . His winning triple jump at the Olympic boycott meet in Moscow of 17.46m was 20 cm longer than that of the Olympic champion in Los Angeles . Oleg begun 1985 with unlucky 4th-place finish at the inaugural World Indoor Games in Paris , but improved upon that , setting European Record on 4 August in Leningrad with a triple jump of 17.69m . He lost his record only several days later to Christo Markov ( Bulgaria ) , but picked his first international medal later in the season when finished second to World Record holder Willie Banks ( USA ) at the World Cup in Canberra with fine 17.47m . Protsenko added bronze at the next years European Championships in Stuttgart and had dream start of 1987 season breaking the World Indoor Record on 15 January in Osaka , leaping 17.67m . He had memorable battle with Mike Conley ( USA ) on 27 February in New York , losing his freshly set record , but recording 17.57m for second place . Several days later he won silver at the World Indoor Championships in Indianapolis again finishing behind Conley . It seemed that Protsenko is destined for a medal at the World Outdoor Champs in Rome when winning at European Cup in Prague with 17.61m , but he finished only 8th in Rome with 17.23m .", "context_before": ""}], "traversal_from": "Oleg Protsenko ( URS )", "traversal_to": "/wiki/Oleg_Protsenko", "direction": "forward"}], "steps": [{"step": 1, "goal": "1984 --athlete--> Oleg Protsenko ( URS )", "depends_on": null}, {"step": 2, "goal": "Oleg Protsenko ( URS ) --linked_passage--> /wiki/Oleg_Protsenko", "depends_on": 1}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 22.65}}, {"path_id": "grounded_221", "score": 17.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "r