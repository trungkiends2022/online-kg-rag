ted by spacecraft:row:19", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "( 5604 ) 1992 FE", "traversal_to": "table:List of minor planets and comets visited by spacecraft:row:19", "direction": "forward"}, {"edge_id": "record:366", "head": "table:List of minor planets and comets visited by spacecraft:row:19", "relation": "spacecraft", "tail": "OSIRIS-REx", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "traversal_from": "table:List of minor planets and comets visited by spacecraft:row:19", "traversal_to": "OSIRIS-REx", "direction": "forward"}, {"edge_id": "record:431", "head": "OSIRIS-REx", "relation": "linked_passage", "tail": "passage:/wiki/OSIRIS-REx", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "contexts": [{"source_id": "/wiki/OSIRIS-REx", "text": "The OSIRIS-REx ( Origins , Spectral Interpretation , Resource Identification , Security , Regolith Explorer ) is a NASA asteroid study and sample-return mission . The mission 's primary goal is to obtain a sample of at least 60 grams ( 2.1 oz ) from 101955 Bennu , a carbonaceous near-Earth asteroid , and return the sample to Earth for a detailed analysis . The material returned is expected to enable scientists to learn more about the formation and evolution of the Solar System , its initial stages of planet formation , and the source of organic compounds that led to the formation of life on Earth . If successful , OSIRIS-REx will be the first U.S. spacecraft to return samples from an asteroid . OSIRIS-REx was launched on 8 September 2016 , flew past Earth on 22 September 2017 , and reached the proximity of Bennu on 3 December 2018 , where it began analyzing its surface for a target sample area over the next several months . On 12 December 2019 , NASA announced the chosen landing spot , known as Nightingale . It is expected to return with its sample to Earth on 24 September 2023 . The cost of the mission is approximately US $ 800 million not including the Atlas V launch vehicle , which is about US $ 183.5 million . It is the third planetary science mission selected in the New Frontiers program , after Juno and New Horizons . The principal investigator is Dante Lauretta from the University of Arizona .", "context_before": ""}], "traversal_from": "OSIRIS-REx", "traversal_to": "passage:/wiki/OSIRIS-REx", "direction": "forward"}], "steps": [{"step": 1, "goal": "( 5604 ) 1992 FE --has_record--> table:List of minor planets and comets visited by spacecraft:row:19", "depends_on": null}, {"step": 2, "goal": "table:List of minor planets and comets visited by spacecraft:row:19 --spacecraft--> OSIRIS-REx", "depends_on": 1}, {"step": 3, "goal": "OSIRIS-REx --linked_passage--> passage:/wiki/OSIRIS-REx", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5294, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.6334}}, {"path_id": "row_17_98", "score": 8.2167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.75, "query_coverage": 0.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["4660 Nereus", "table:List of minor planets and comets visited by spacecraft:row:17", "Hayabusa", "passage:/wiki/Hayabusa"], "edges": [{"edge_id": "record:318", "head": "4660 Nereus", "relation": "has_record", "tail": "table:List of minor planets and comets visited by spacecraft:row:17", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 17, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "4660 Nereus", "traversal_to": "table:List of minor planets and comets visited by spacecraft:row:17", "direction": "forward"}, {"edge_id": "record:329", "head": "table:List of minor planets and comets visited by spacecraft:row:17", "relation": "spacecraft", "tail": "Hayabusa", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 17, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "traversal_from": "table:List of minor planets and comets visited by spacecraft:row:17", "traversal_to": "Hayabusa", "direction": "forward"}, {"edge_id": "record:426", "head": "Hayabusa", "relation": "linked_passage", "tail": "passage:/wiki/Hayabusa", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 17, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "contexts": [{"source_id": "/wiki/Hayabusa", "text": "Hayabusa ( Japanese : はやぶさ , Peregrine falcon ) was a robotic spacecraft developed by the Japan Aerospace Exploration Agency ( JAXA ) to return a sample of material from a small near-Earth asteroid named 25143 Itokawa to Earth for further analysis . Hayabusa , formerly known as MUSES-C for Mu Space Engineering Spacecraft C , was launched on 9 May 2003 and rendezvoused with Itokawa in mid-September 2005 . After arriving at Itokawa , Hayabusa studied the asteroid 's shape , spin , topography , colour , composition , density , and history . In November 2005 , it landed on the asteroid and collected samples in the form of tiny grains of asteroidal material , which were returned to Earth aboard the spacecraft on 13 June 2010 . The spacecraft also carried a detachable minilander , MINERVA , which failed to reach the surface .", "context_before": ""}], "traversal_from": "Hayabusa", "traversal_to": "passage:/wiki/Hayabusa", "direction": "forward"}], "steps": [{"step": 1, "goal": "4660 Nereus --has_record--> table:List of minor planets and comets visited by spacecraft:row:17", "depends_on": null}, {"step": 2, "goal": "table:List of minor planets and comets visited by spacecraft:row:17 --spacecraft--> Hayabusa", "depends_on": 1}, {"step": 3, "goal": "Hayabusa --linked_passage--> passage:/wiki/Hayabusa", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5294, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 12.2167}}, {"path_id": "row_0_1", "score": 7.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["2 P/Encke", "table:List of minor planets and comets visited by spacecraft:row:0", "CONTOUR", "passage:/wiki/CONTOUR"], "edges": [{"edge_id": "record:0", "head": "2 P/Encke", "relation": "has_record", "tail": "table:List of minor planets and comets visited by spacecraft:row:0", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 0, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "2 P/Encke", "traversal_to": "table:List of minor planets and comets visited by spacecraft:row:0", "direction": "forward"}, {"edge_id": "record:11", "head": "table:List of minor planets and comets visited by spacecraft:row:0", "relation": "spacecraft", "tail": "CONTOUR", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 0, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "traversal_from": "table:List of minor planets and comets visited by spacecraft:row:0", "traversal_to": "CONTOUR", "direction": "forward"}, {"edge_id": "record:380", "head": "CONTOUR", "relation": "linked_passage", "tail": "passage:/wiki/CONTOUR", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 0, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "contexts": [{"source_id": "/wiki/CONTOUR", "text": "The COmet Nucleus TOUR ( CONTOUR ) was a NASA Discovery-class space probe that failed shortly after its July 2002 launch . It had as its primary objective close flybys of two comet nuclei with the possibility of a flyby of a third known comet or an as-yet-undiscovered comet . The two comets scheduled to be visited were Encke and Schwassmann-Wachmann-3 , and the third target was d'Arrest . It was hoped that a new comet would have been discovered in the inner Solar System between 2006 and 2008 , in which case the spacecraft trajectory would have been changed if possible to rendezvous with the new comet . Scientific objectives included imaging the nuclei at resolutions of up to 4 meters ( 13 ft ) , performing spectral mapping of the nuclei at resolutions of up to 100 meters ( 330 ft ) , and obtaining detailed compositional data on gas and dust in the near-nucleus environment , with the goal of improving knowledge of the characteristics of comet nuclei . After the solid rocket motor intended to inject the spacecraft into solar orbit was ignited on August 15 , 2002 , contact with the probe could not be re-established . Ground-based telescopes later found three objects along the course of the satellite , leading to the speculation that it had disintegrated . Attempts to contact the probe were ended on December 20 , 2002 . The probe thus accomplished none of its primary scientific objectives , but did prove some spaceflight technologies , such as the APL-developed non-coherent spacecraft navigation technique , which was later used on the New Horizons spacecraft .", "context_before": "2 ( two ) is a number , numeral , and glyph . It is the natural number following 1 and preceding 3 . It is the smallest and only even prime number . Because it forms the basis of a duality , it has religious and spiritual significance in many cultures . Comet Encke or Encke 's Comet ( official designation : 2P/Encke ) is a periodic comet that completes an orbit of the Sun once every 3.3 years . ( This is the shortest period of a reasonably bright comet ; the faint main-belt comet 311P/PANSTARRS has a period of 3.2 years . ) Encke was first recorded by Pierre Méchain in 1786 , but it was not recognized as a periodic comet until 1819 when its orbit was computed by Johann Franz Encke ; like Halley 's Comet , it is unusual in being named after the calculator of its orbit rather than its discoverer . Like most comets , it has a very low albedo , reflecting only 4.6% of the light it receives when talking about the nucleus . However , comets generate a large coma and tail that can make them much more visible during their perihelion ( closest approach to the Sun ) . The diameter of the nucleus of Encke 's Comet is 4.8 km ."}], "traversal_from": "CONTOUR", "traversal_to": "passage:/wiki/CONTOUR", "direction": "forward"}], "steps": [{"step": 1, "goal": "2 P/Encke --has_record--> table:List of minor planets and comets visited by spacecraft:row:0", "depends_on": null}, {"step": 2, "goal": "table:List of minor planets and comets visited by spacecraft:row:0 --spacecraft--> CONTOUR", "depends_on": 1}, {"step": 3, "goal": "CONTOUR --linked_passage--> passage:/wiki/CONTOUR", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.3529, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 11.8}}, {"path_id": "row_3_16", "score": 7.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["140 Siwa", "table:List of minor planets and comets visited by spacecraft:row:3", "Rosetta", "passage:/wiki/Rosetta_space_probe"], "edges": [{"edge_id": "record:54", "head": "140 Siwa", "relation": "has_record", "tail": "table:List of minor planets and comets visited by spacecraft:row:3", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 3, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "140 Siwa", "traversal_to": "table:List of minor planets and comets visited by spacecraft:row:3", "direction": "forward"}, {"edge_id": "record:65", "head": "table:List of minor planets and comets visited by spacecraft:row:3", "relation": "spacecraft", "tail": "Rosetta", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 3, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "traversal_from": "table:List of minor planets and comets visited by spacecraft:row:3", "traversal_to": "Rosetta", "direction": "forward"}, {"edge_id": "record:391", "head": "Rosetta", "relation": "linked_passage", "tail": "passage:/wiki/Rosetta_space_probe", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 3, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "contexts": [{"source_id": "/wiki/Rosetta_space_probe", "text": "Rosetta was a space probe built by the European Space Agency launched on 2 March 2004 . Along with Philae , its lander module , Rosetta performed a detailed study of comet 67P/Churyumov-Gerasimenko ( 67P ) . During its journey to the comet , the spacecraft performed flybys of Earth , Mars , and the asteroids 21 Lutetia and 2867 Šteins . It was launched as the third cornerstone mission of the ESA 's Horizon 2000 programme , after SOHO / Cluster and XMM-Newton . On 6 August 2014 , the spacecraft reached the comet and performed a series of manoeuvres to eventually orbit the comet at distances of 30 to 10 kilometres ( 19 to 6 mi ) . On 12 November , its lander module Philae performed the first successful landing on a comet , though its battery power ran out two days later . Communications with Philae were briefly restored in June and July 2015 , but due to diminishing solar power , Rosetta 's communications module with the lander was turned off on 27 July 2016 . On 30 September 2016 , the Rosetta spacecraft ended its mission by hard-landing on the comet in its Ma'at region . The probe was named after the Rosetta Stone , a stele of Egyptian origin featuring a decree in three scripts . The lander was named after the Philae obelisk , which bears a bilingual Greek and Egyptian hieroglyphic inscription .", "context_before": ""}], "traversal_from": "Rosetta", "traversal_to": "passage:/wiki/Rosetta_space_probe", "direction": "forward"}], "steps": [{"step": 1, "goal": "140 Siwa --has_record--> table:List of minor planets and comets visited by spacecraft:row:3", "depends_on": null}, {"step": 2, "goal": "table:List of minor planets and comets visited by spacecraft:row:3 --spacecraft--> Rosetta", "depends_on": 1}, {"step": 3, "goal": "Rosetta --linked_passage--> passage:/wiki/Rosetta_space_probe", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4118, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 11.8}}, {"path_id": "row_bridge_19_110", "score": 6.6334, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 0.6667, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/OSIRIS-REx", "OSIRIS-REx", "table:List of minor planets and comets visited by spacecraft:row:19", "0.6"], "edges": [{"edge_id": "record:431", "head": "OSIRIS-REx", "relation": "linked_passage", "tail": "passage:/wiki/OSIRIS-REx", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "contexts": [{"source_id": "/wiki/OSIRIS-REx", "text": "The OSIRIS-REx ( Origins , Spectral Interpretation , Resource Identification , Security , Regolith Explorer ) is a NASA asteroid study and sample-return mission . The mission 's primary goal is to obtain a sample of at least 60 grams ( 2.1 oz ) from 101955 Bennu , a carbonaceous near-Earth asteroid , and return the sample to Earth for a detailed analysis . The material returned is expected to enable scientists to learn more about the formation and evolution of the Solar System , its initial stages of planet formation , and the source of organic compounds that led to the formation of life on Earth . If successful , OSIRIS-REx will be the first U.S. spacecraft to return samples from an asteroid . OSIRIS-REx was launched on 8 September 2016 , flew past Earth on 22 September 2017 , and reached the proximity of Bennu on 3 December 2018 , where it began analyzing its surface for a target sample area over the next several months . On 12 December 2019 , NASA announced the chosen landing spot , known as Nightingale . It is expected to return with its sample to Earth on 24 September 2023 . The cost of the mission is approximately US $ 800 million not including the Atlas V launch vehicle , which is about US $ 183.5 million . It is the third planetary science mission selected in the New Frontiers program , after Juno and New Horizons . The principal investigator is Dante Lauretta from the University of Arizona .", "context_before": ""}], "traversal_from": "passage:/wiki/OSIRIS-REx", "traversal_to": "OSIRIS-REx", "direction": "reverse"}, {"edge_id": "record:366", "head": "table:List of minor planets and comets visited by spacecraft:row:19", "relation": "spacecraft", "tail": "OSIRIS-REx", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": true, "traversal_from": "OSIRIS-REx", "traversal_to": "table:List of minor planets and comets visited by spacecraft:row:19", "direction": "reverse"}, {"edge_id": "record:360", "head": "table:List of minor planets and comets visited by spacecraft:row:19", "relation": "diameter_km", "tail": "0.6", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "row_index": 19, "column_name": "Diameter ( km )", "header_path": ["Diameter ( km )"], "structural": true, "traversal_from": "table:List of minor planets and comets visited by spacecraft:row:19", "traversal_to": "0.6", "direction": "forward"}], "steps": [{"step": 1, "goal": "OSIRIS-REx --linked_passage--> passage:/wiki/OSIRIS-REx [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of minor planets and comets visited by spacecraft:row:19 --spacecraft--> OSIRIS-REx [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:List of minor planets and comets visited by spacecraft:row:19 --diameter_km--> 0.6", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5294, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 11.6334}}, {"path_id": "answer_evidence_semantic_127_0", "score": 83.0, "score_components": {"reverse_answer_match": 83.0}, "nodes": ["OSIRIS-REx", "/wiki/OSIRIS-REx"], "edges": [{"edge_id": "semantic:127:0", "head": "OSIRIS-REx", "relation": "linked_passage", "tail": "/wiki/OSIRIS-REx", "source_type": "table", "source_id": "List of minor planets and comets visited by spacecraft", "source_group": null, "row_index": 19, "column_name": "Spacecraft", "header_path": ["Spacecraft"], "structural": false, "contexts": [{"source_id": "/wiki/OSIRIS-REx", "text": "The OSIRIS-REx ( Origins , Spectral Interpretation , Resource Identification , Security , Regolith Explorer ) is a NASA asteroid study and sample-return mission . The mission 's primary goal is to obtain a sample of at least 60 grams ( 2.1 oz ) from 101955 Bennu , a carbonaceous near-Earth asteroid , and return the sample to Earth for a detailed analysis . The material returned is expected to enable scientists to learn more about the formation and evolution of the Solar System , its initial stages of planet formation , and the source of organic compounds that led to the formation of life on Earth . If successful , OSIRIS-REx will be the first U.S. spacecraft to return samples from an asteroid . OSIRIS-REx was launched on 8 September 2016 , flew past Earth on 22 September 2017 , and reached the proximity of Bennu on 3 December 2018 , where it began analyzing its surface for a target sample area over the next several months . On 12 December 2019 , NASA announced the chosen landing spot , known as Nightingale . It is expected to return with its sample to Earth on 24 September 2023 . The cost of the mission is approximately US $ 800 million not including the Atlas V launch vehicle , which is about US $ 183.5 million . It is the third planetary science mission selected in the New Frontiers program , after Juno and New Horizons . The principal investigator is Dante Lauretta from the University of Arizona .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "OSIRIS-REx --linked_passage--> /wiki/OSIRIS-REx", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 83.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "row_19_109", "best_path_score": 8.6334, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 12928, "llm_response_chars": 12, "llm_latency_ms": 5616.8, "wall_time_ms": 13222.12, "non_llm_time_ms": 7605.32, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "retrieval_miss", "is_ambiguous": null, "ambiguity_status": null}
