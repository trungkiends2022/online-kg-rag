witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 24.7667}, "grounded_678": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9375, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 24.7667}, "grounded_793": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9375, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 24.7667}, "grounded_296": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.1333}, "grounded_305": {"status": "qualified", "hard_failures": [], "question_term_coverage": 1.0, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.1333}}}, "reasoning_paths": [{"path_id": "grounded_616", "score": 19.7667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.8, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Rosario_Central", "Rosario Central", "table:Nacional championship:row:4", "1971"], "edges": [{"edge_id": "record:220", "head": "Rosario Central", "relation": "linked_passage", "tail": "passage:/wiki/Rosario_Central", "source_type": "table", "source_id": "Nacional championship", "row_index": 4, "column_name": "Champion", "header_path": ["Champion"], "structural": true, "contexts": [{"source_id": "/wiki/Rosario_Central", "text": "Club Atlético Rosario Central ( Spanish pronunciation : [ roˈsaɾjo senˈtɾal ] ) is a sports club based in Rosario , Argentina , that plays in the Argentine Primera División . The club was officially founded December 24 , 1889 by a group of railway workers , taking its name from the English-owned Central Argentine Railway company . One of the oldest Argentine teams , it is considered a pioneer in its hometown and the only one of current Rosarian teams to have won an international title organised by CONMEBOL , the Copa Conmebol , won by the club in 1995 . Originally member of the Rosario 's Football Association , the club affiliated to the Argentine Football Association ( AFA ) in 1939 . Since then , Rosario Central has won the Argentine 's First Division four times , with the last domestic title won in 1986-87 . In addition , Rosario Central won six National cups , being the 2018 Copa Argentina its most recent achievement . In addition , Rosario Central won the Conmebol Cup ( the precursor of the current Copa Sudamericana ) once , in 1995 , being the only team in Santa Fe province which has won an official international title recognised by FIFA . In 2012 , the club was considered by FIFA as one of the 11 most classical clubs in Argentine football . Rosario Central has a strong rivalry with Newell 's Old Boys . The matches played between them are named El Clasico Rosarino , and is amongst the most heated rivalries in Argentina due to both teams and due to Rosario 's local popularity . Rosario Central 's home stadium is Estadio Dr. Lisandro de la Torre , known simply as El Gigante de Arroyito ( The Giant of Arroyito ) .", "context_before": ""}], "traversal_from": "passage:/wiki/Rosario_Central", "traversal_to": "Rosario Central", "direction": "reverse"}, {"edge_id": "record:46", "head": "table:Nacional championship:row:4", "relation": "champion", "tail": "Rosario Central", "source_type": "table", "sourc