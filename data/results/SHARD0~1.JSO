e:/wiki/Déjame_vivir", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9167, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 17.5143}}, {"path_id": "row_4_8", "score": 13.2286, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.4286, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1986", "table:Daniela Romo:row:4", "El Camino Secreto", "passage:/wiki/El_camino_secreto"], "edges": [{"edge_id": "record:33", "head": "1986", "relation": "has_record", "tail": "table:Daniela Romo:row:4", "source_type": "table", "source_id": "Daniela Romo", "row_index": 4, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1986", "traversal_to": "table:Daniela Romo:row:4", "direction": "forward"}, {"edge_id": "record:38", "head": "table:Daniela Romo:row:4", "relation": "title", "tail": "El Camino Secreto", "source_type": "table", "source_id": "Daniela Romo", "row_index": 4, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "table:Daniela Romo:row:4", "traversal_to": "El Camino Secreto", "direction": "forward"}, {"edge_id": "record:163", "head": "El Camino Secreto", "relation": "linked_passage", "tail": "passage:/wiki/El_camino_secreto", "source_type": "table", "source_id": "Daniela Romo", "row_index": 4, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/El_camino_secreto", "text": "El Camino Secreto ( English title : The Secret Path ) is a Mexican telenovela produced by Emilio Larrosa for Televisa in 1986 . Daniela Romo and Salvador Pineda starred as protagonists , while first actor Claudio Brook , Patsy Pepping and Mar Castro starred as main antagonists . Leticia Calderón , Gabriela Rivero and Carlos Ancira starred as stellar performances . He is the last acting role of Carlos Ancira , eight months before his death by brain tumor in October 10 , 1987 .", "context_before": "No temas al amor ( English title : Do n't be afraid of love ) is a telenovela made by Mexican TV network Televisa . This telenovela was broadcast in 1980 . This soap opera was televised on weekends only . Déjame vivir ( English title : Let me live ) is a Mexican telenovela produced by Valentín Pimstein for Televisa in 1982 . This is a remake of the 1970 Venezuelan telenovela Cristina . The reception for this telenovela was not good , in fact it was selected as the worst one of 1982 . Daniela Romo and Gregorio Casal starred as protagonists , while the first actress Beatriz Aguirre and Elizabeth Dupeyrón starred as antagonists ."}], "traversal_from": "El Camino Secreto", "traversal_to": "passage:/wiki/El_camino_secreto", "direction": "forward"}], "steps": [{"step": 1, "goal": "1986 --has_record--> table:Daniela Romo:row:4", "depends_on": null}, {"step": 2, "goal": "table:Daniela Romo:row:4 --title--> El Camino Secreto", "depends_on": 1}, {"step": 3, "goal": "El Camino Secreto --linked_passage--> passage:/wiki/El_camino_secreto", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 17.2286}}], "best_path_id": "grounded_45", "best_path_score": 15.7286, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_pat