d States . As of the 2010 census , its population was 19,936 . The community took its name in the 18th century from a local tavern named the King of Prussia Inn , which was named after King Frederick the Great of Prussia . Like the rest of Montgomery County , King of Prussia continues to experience rapid development . One of the largest shopping malls in the United States , King of Prussia , is located here . Also located here is the headquarters of the Nuclear Regulatory Commission Region I . King of Prussia is considered to be an edge city of Philadelphia , consisting of large amounts of retail and office space situated at the convergence of four highways .", "context_before": ""}], "traversal_from": "King of Prussia , PA", "traversal_to": "passage:/wiki/King_of_Prussia,_PA", "direction": "forward"}], "steps": [{"step": 1, "goal": "AmeriGas --has_record--> table:List of companies based in the Philadelphia area:row:7", "depends_on": null}, {"step": 2, "goal": "table:List of companies based in the Philadelphia area:row:7 --city--> King of Prussia , PA", "depends_on": 1}, {"step": 3, "goal": "King of Prussia , PA --linked_passage--> passage:/wiki/King_of_Prussia,_PA", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9286, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 21.2167}}, {"path_id": "row_bridge_7_15", "score": 15.2167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.75, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/King_of_Prussia,_PA", "King of Prussia , PA", "table:List of companies based in the Philadelphia area:row:7", "gas"], "edges": [{"edge_id": "record:194", "head": "King of Prussia , PA", "relation": "linked_passage", "tail": "passage:/wiki/King_of_Prussia,_PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 7, "column_name": "City", "header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/King_of_Prussia,_PA", "text": "King of Prussia ( also referred to as KOP ) is a census-designated place in Upper Merion Township , Montgomery County , Pennsylvania , United States . As of the 2010 census , its population was 19,936 . The community took its name in the 18th century from a local tavern named the King of Prussia Inn , which was named after King Frederick the Great of Prussia . Like the rest of Montgomery County , King of Prussia continues to experience rapid development . One of the largest shopping malls in the United States , King of Prussia , is located here . Also located here is the headquarters of the Nuclear Regulatory Commission Region I . King of Prussia is considered to be an edge city of Philadelphia , consisting of large amounts of retail and office space situated at the convergence of four highways .", "context_before": ""}], "traversal_from": "passage:/wiki/King_of_Prussia,_PA", "traversal_to": "King of Prussia , PA", "direction": "reverse"}, {"edge_id": "record:68", "head": "table:List of companies based in the Philadelphia area:row:7", "relation": "city", "tail": "King of Prussia , PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 7, "column_name": "City", "header_path": ["City"], "structural": true, "traversal_from": "King of Prussia , PA", "traversal_to": "table:List of companies based in the Philadelphia area:row:7", "direction": "reverse"}, {"edge_id": "record:71", "head": "table:List of companies based in the Philadelphia area:row:7", "relation": "industry", "tail": "gas", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 7, "column_name": "Industry", "header_path": ["Industry"], "structural": true, "traversal_from": "table:List of companies based in the Philadelphia area:row:7", "traversal_to": "gas", "direction": "forward"}], "steps": [{"step": 1, "goal": "King of Prussia , PA --linked_passage--> passage:/wiki/King_of_Prussia,_PA [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of companies based in the Philadelphia area:row:7 --city--> King of Prussia , PA [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:List of companies based in the Philadelphia area:row:7 --industry--> gas", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9286, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 20.2167}}, {"path_id": "row_19_31", "score": 10.4667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 1.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Boscov 's", "table:List of companies based in the Philadelphia area:row:19", "Reading , PA", "passage:/wiki/Reading,_PA"], "edges": [{"edge_id": "record:171", "head": "Boscov 's", "relation": "has_record", "tail": "table:List of companies based in the Philadelphia area:row:19", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 19, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Boscov 's", "traversal_to": "table:List of companies based in the Philadelphia area:row:19", "direction": "forward"}, {"edge_id": "record:176", "head": "table:List of companies based in the Philadelphia area:row:19", "relation": "city", "tail": "Reading , PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 19, "column_name": "City", "header_path": ["City"], "structural": true, "traversal_from": "table:List of companies based in the Philadelphia area:row:19", "traversal_to": "Reading , PA", "direction": "forward"}, {"edge_id": "record:212", "head": "Reading , PA", "relation": "linked_passage", "tail": "passage:/wiki/Reading,_PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 19, "column_name": "City", "header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/Reading,_PA", "text": "Reading ( /ˈrɛdɪŋ/ RED-ing ; Pennsylvania German : Reddin ) is a city in and the county seat of Berks County , Pennsylvania , United States . With a population of 88,495 as of the 2018 U.S. Census Estimates , it is the fifth-largest city in Pennsylvania . Located in the southeastern part of the state , it is the principal city of the Greater Reading Area , home to 420,152 residents , and is furthermore included in the greater Delaware Valley . According to the 2010 census , Reading had the highest share of citizens living in poverty in the nation for cities with populations of more than 65,000 . Reading 's poverty rate fell over the next decade . Reading 's poverty rate in the 2018 five-year American Community survey showed that 35.4% of the city 's residents were below the poverty line , or less than the infamous 41.3% from 2011 , when Reading was declared the poorest small city in the nation . The city , which is approximately halfway between the state 's most populous city , Philadelphia , and the state capital , Harrisburg , is strategically situated along a major transportation route from Central to Eastern Pennsylvania , and lent its name to the now-defunct Reading Railroad , which transported anthracite coal from the Pennsylvania Coal Region to the eastern United States via the Port of Philadelphia . Reading Railroad is one of the four railroad properties in the classic United States version of the Monopoly board game . Reading was one of the first localities where outlet shopping became a tourist industry . It has been known as The Pretzel City , because of numerous local pretzel bakeries . Currently , Bachman , Dieffenbach , Tom Sturgis , and Unique Pretzel bakeries call the Reading area home . In recent years , the Reading area has become a destination for cyclists .", "context_before": ""}], "traversal_from": "Reading , PA", "traversal_to": "passage:/wiki/Reading,_PA", "direction": "forward"}], "steps": [{"step": 1, "goal": "Boscov 's --has_record--> table:List of companies based in the Philadelphia area:row:19", "depends_on": null}, {"step": 2, "goal": "table:List of companies based in the Philadelphia area:row:19 --city--> Reading , PA", "depends_on": 1}, {"step": 3, "goal": "Reading , PA --linked_passage--> passage:/wiki/Reading,_PA", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8571, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 14.4667}}, {"path_id": "row_1_3", "score": 9.9667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 1.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["AlliedBarton", "table:List of companies based in the Philadelphia area:row:1", "Conshohocken , PA", "passage:/wiki/Conshohocken,_PA"], "edges": [{"edge_id": "record:9", "head": "AlliedBarton", "relation": "has_record", "tail": "table:List of companies based in the Philadelphia area:row:1", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 1, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "AlliedBarton", "traversal_to": "table:List of companies based in the Philadelphia area:row:1", "direction": "forward"}, {"edge_id": "record:14", "head": "table:List of companies based in the Philadelphia area:row:1", "relation": "city", "tail": "Conshohocken , PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 1, "column_name": "City", "header_path": ["City"], "structural": true, "traversal_from": "table:List of companies based in the Philadelphia area:row:1", "traversal_to": "Conshohocken , PA", "direction": "forward"}, {"edge_id": "record:183", "head": "Conshohocken , PA", "relation": "linked_passage", "tail": "passage:/wiki/Conshohocken,_PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 1, "column_name": "City", "header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/Conshohocken,_PA", "text": "Conshohocken ( /ˌkɒnʃəˈhɒkən/ kon-shə-HOK-ən ; Lenape : Kanshihakink ) is a borough on the Schuylkill River in Montgomery County , Pennsylvania , in suburban Philadelphia . Historically a large mill town and industrial and manufacturing center , after the decline of industry in recent years Conshohocken has developed into a center of riverfront commercial and residential development . In the regional slang , it is sometimes referred to by the colloquial nickname Conshy ( /ˈkɒnʃi/ KON-shee ) . The name Conshohocken comes from the Unami language , from either Kanshi'hak'ing , meaning Elegant-ground- place , or , more likely , Chottschinschu'hak'ing , which means Big-trough-ground-place or Large-bowl-ground-place , referring to the big bend in the Tulpe'hanna ( Turtle River , or modern Schuylkill River ) . The sister community of West Conshohocken is located on the opposite side of the Schuylkill River .", "context_before": "Berlin is a borough in Camden County , New Jersey , United States . As of the 2010 United States Census , the borough 's population was 7,588 , reflecting an increase of 1,439 ( +23.4% ) from the 6,149 counted in the 2000 Census , which had in turn increased by 477 ( +8.4% ) from the 5,672 counted in the 1990 Census . Berlin was incorporated as a borough on March 29 , 1927 , from portions of Berlin Township , based on the results of a referendum held on April 26 , 1927 . Allied Universal is a privately owned facility services company based in the United States . It also offers security systems , janitorial services and staffing . It is a combination of earlier companies - Barton Protective Services , Spectaguard , Initial and Allied Security . In 2016 , Allied Barton merged with Universal Services of America and was named Allied Universal ."}], "traversal_from": "Conshohocken , PA", "traversal_to": "passage:/wiki/Conshohocken,_PA", "direction": "forward"}], "steps": [{"step": 1, "goal": "AlliedBarton --has_record--> table:List of companies based in the Philadelphia area:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of companies based in the Philadelphia area:row:1 --city--> Conshohocken , PA", "depends_on": 1}, {"step": 3, "goal": "Conshohocken , PA --linked_passage--> passage:/wiki/Conshohocken,_PA", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8571, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.9667}}, {"path_id": "row_11_21", "score": 9.7167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.25, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 1.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Aqua America", "table:List of companies based in the Philadelphia area:row:11", "Bryn Mawr , PA", "passage:/wiki/Bryn_Mawr,_PA"], "edges": [{"edge_id": "record:99", "head": "Aqua America", "relation": "has_record", "tail": "table:List of companies based in the Philadelphia area:row:11", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 11, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "Aqua America", "traversal_to": "table:List of companies based in the Philadelphia area:row:11", "direction": "forward"}, {"edge_id": "record:104", "head": "table:List of companies based in the Philadelphia area:row:11", "relation": "city", "tail": "Bryn Mawr , PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 11, "column_name": "City", "header_path": ["City"], "structural": true, "traversal_from": "table:List of companies based in the Philadelphia area:row:11", "traversal_to": "Bryn Mawr , PA", "direction": "forward"}, {"edge_id": "record:201", "head": "Bryn Mawr , PA", "relation": "linked_passage", "tail": "passage:/wiki/Bryn_Mawr,_PA", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 11, "column_name": "City", "header_path": ["City"], "structural": true, "contexts": [{"source_id": "/wiki/Bryn_Mawr,_PA", "text": "Bryn Mawr ( pronounced /ˌbrɪnˈmɑːr/ ; from Welsh for big hill ) is a census-designated place ( CDP ) , located entirely in Lower Merion Township , Montgomery County , Pennsylvania , just west of Philadelphia along Lancaster Avenue ( US-30 ) and the border with Delaware County . There are also areas not in the census-designated place but which have Bryn Mawr , Pennsylvania postal addresses located in Radnor and Haverford Townships in Delaware County . Bryn Mawr is located toward the center of what is known as the Main Line , a group of affluent Philadelphia suburban villages stretching from the city limits to Malvern . As of the 2010 census , it had a population of 3,779 . Bryn Mawr is home to Bryn Mawr College .", "context_before": ""}], "traversal_from": "Bryn Mawr , PA", "traversal_to": "passage:/wiki/Bryn_Mawr,_PA", "direction": "forward"}], "steps": [{"step": 1, "goal": "Aqua America --has_record--> table:List of companies based in the Philadelphia area:row:11", "depends_on": null}, {"step": 2, "goal": "table:List of companies based in the Philadelphia area:row:11 --city--> Bryn Mawr , PA", "depends_on": 1}, {"step": 3, "goal": "Bryn Mawr , PA --linked_passage--> passage:/wiki/Bryn_Mawr,_PA", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7143, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 13.7167}}, {"path_id": "answer_evidence_record_65", "score": 101.5, "score_components": {"reverse_answer_match": 101.5}, "nodes": ["table:List of companies based in the Philadelphia area:row:7:cell:Name", "AmeriGas"], "edges": [{"edge_id": "record:65", "head": "table:List of companies based in the Philadelphia area:row:7:cell:Name", "relation": "cell_value", "tail": "AmeriGas", "source_type": "table", "source_id": "List of companies based in the Philadelphia area", "row_index": 7, "colu