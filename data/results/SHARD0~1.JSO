ail": "/wiki/Olga_Teslenko", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "source_group": null, "row_index": 6, "column_name": "Gymnast", "header_path": ["Gymnast"], "structural": false, "contexts": [{"source_id": "/wiki/Olga_Teslenko", "text": "Olha Teslenko ( born May 23 , 1981 ) is a Ukrainian former artistic gymnast . She competed at the 1996 and 2000 Summer Olympics .", "context_before": "Claudia Maria Presăcan ( born 28 December 1979 in Sibiu ) is a world-class Romanian artistic gymnast who competed at the senior international level between 1994 and 2000 . She was a three-time team gold medalist at the World Championships with the Romanian team and was also a member of the gold medal-winning Romanian squad at the 2000 Olympics in Sydney . Alexandra Marinescu ( born 19 March 1982 ) is a retired Romanian Olympic artistic gymnast . She is an Olympic bronze medalist with the team and a two-time world champion with the team . Individually , she is a world silver medalist on beam and a seven-time Junior European medalist . She currently works as a minimal electro DJ based in Bucharest ."}], "traversal_from": "/wiki/Olga_Teslenko", "traversal_to": "Olga Teslenko ( UKR )", "direction": "reverse"}, {"edge_id": "record:58", "head": "table:1997 World Artistic Gymnastics Championships:row:6:cell:Gymnast", "relation": "cell_value", "tail": "Olga Teslenko ( UKR )", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "row_index": 6, "column_name": "Gymnast", "header_path": ["Gymnast"], "structural": true, "cell_node": true, "traversal_from": "Olga Teslenko ( UKR )", "traversal_to": "table:1997 World Artistic Gymnastics Championships:row:6:cell:Gymnast", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Olga Teslenko ( UKR ) --linked_passage--> /wiki/Olga_Teslenko [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:1997 World Artistic Gymnastics Championships:row:6:cell:Gymnast --cell_value--> Olga Teslenko ( UKR ) [traverse reverse]", "depends_on": 1}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4091, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.4882}}, {"path_id": "answer_evidence_record_74", "score": 163.0, "score_components": {"reverse_answer_match": 163.0}, "nodes": ["Svetlana Khorkina ( RUS )", "passage:/wiki/Svetlana_Khorkina"], "edges": [{"edge_id": "record:74", "head": "Svetlana Khorkina ( RUS )", "relation": "linked_passage", "tail": "passage:/wiki/Svetlana_Khorkina", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "row_index": 0, "column_name": "Gymnast", "header_path": ["Gymnast"], "structural": true, "contexts": [{"source_id": "/wiki/Svetlana_Khorkina", "text": "Svetlana Vasilyevna Khorkina ( Russian : Светлана Васильевна Хоркина ; born 19 January 1979 ) is a retired Russian artistic gymnast . She competed at the 1996 Summer Olympics , the 2000 Summer Olympics , and the 2004 Summer Olympics . During her career , Khorkina won seven Olympic medals and twenty World Championship medals . Over time , she medaled in every event at the World Artistic Gymnastics Championships . She was also the first gymnast to win three all-around titles at the World Championships and only the second female artistic gymnast ever , after Nadia Comăneci , to win three European All-Around titles . Svetlana Khorkina is often regarded as one of the most successful female gymnasts of all time . At the Opening Ceremony of the 2019 Winter Universiade she lit the fire , together with bandy player Sergey Lomanov .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Svetlana Khorkina ( RUS ) --linked_passage--> passage:/wiki/Svetlana_Khorkina", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 163.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_75", "score": 163.0, "score_components": {"reverse_answer_match": 163.0}, "nodes": ["Svetlana Khorkina", "passage:/wiki/Svetlana_Khorkina"], "edges": [{"edge_id": "record:75", "head": "Svetlana Khorkina", "relation": "linked_passage", "tail": "passage:/wiki/Svetlana_Khorkina", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "row_index": 0, "column_name": "Gymnast", "header_path": ["Gymnast"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Svetlana_Khorkina", "text": "Svetlana Vasilyevna Khorkina ( Russian : Светлана Васильевна Хоркина ; born 19 January 1979 ) is a retired Russian artistic gymnast . She competed at the 1996 Summer Olympics , the 2000 Summer Olympics , and the 2004 Summer Olympics . During her career , Khorkina won seven Olympic medals and twenty World Championship medals . Over time , she medaled in every event at the World Artistic Gymnastics Championships . She was also the first gymnast to win three all-around titles at the World Championships and only the second female artistic gymnast ever , after Nadia Comăneci , to win three European All-Around titles . Svetlana Khorkina is often regarded as one of the most successful female gymnasts of all time . At the Opening Ceremony of the 2019 Winter Universiade she lit the fire , together with bandy player Sergey Lomanov .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Svetlana Khorkina --linked_passage--> passage:/wiki/Svetlana_Khorkina", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 163.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_80", "score": 163.0, "score_components": {"reverse_answer_match": 163.0}, "nodes": ["Liubov Sheremeta ( UKR )", "passage:/wiki/Liubov_Sheremeta"], "edges": [{"edge_id": "record:80", "head": "Liubov Sheremeta ( UKR )", "relation": "linked_passage", "tail": "passage:/wiki/Liubov_Sheremeta", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "row_index": 3, "column_name": "Gymnast", "header_path": ["Gymnast"], "structural": true, "contexts": [{"source_id": "/wiki/Liubov_Sheremeta", "text": "Liubov Sheremeta ( born January 17 , 1980 ) is a Ukrainian former artistic gymnast . She competed at the 1996 Summer Olympics .", "context_before": "Meng Fei ( born March 22 , 1981 ) is a Chinese artistic gymnast . She won the silver medal in the uneven bars and the bronze medal in the team event at the 1997 World Artistic Gymnastics Championships . She was also a part of the silver-medal-winning team at the 1995 World Artistic Gymnastics Championships . Currently Meng Fei is an optional team coach at Woodlands Gymnastics Academy in Spring , Texas USA . Bi Wenjing ( Chinese : 毕文静 ; born 1981 ) is a Chinese gymnast . She competed at the 1996 Summer Olympics in Atlanta , winning a silver medal in uneven bars , and placing fourth in the team competition with the Chinese team ."}]}], "steps": [{"step": 1, "goal": "Liubov Sheremeta ( UKR ) --linked_passage--> passage:/wiki/Liubov_Sheremeta", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 163.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_74", "best_path_score": 19.1382, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 9832, "llm_response_chars": 4, "llm_latency_ms": 53851.44, "wall_time_ms": 57632.72, "non_llm_time_ms": 3781.28, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.5, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hy