 USA:row:8 --miss_teen_usa--> Janel Bishop", "depends_on": 1}, {"step": 3, "goal": "Janel Bishop --linked_passage--> passage:/wiki/Janel_Bishop", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7692, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 15.7}}, {"path_id": "row_0_1", "score": 11.5, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 2.0, "text_context_match": 1.0, "query_coverage": 1.2, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1983", "table:Miss Teen USA:row:0", "Ruth Zakarian", "passage:/wiki/Ruth_Zakarian"], "edges": [{"edge_id": "record:0", "head": "1983", "relation": "has_record", "tail": "table:Miss Teen USA:row:0", "source_type": "table", "source_id": "Miss Teen USA", "row_index": 0, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1983", "traversal_to": "table:Miss Teen USA:row:0", "direction": "forward"}, {"edge_id": "record:5", "head": "table:Miss Teen USA:row:0", "relation": "miss_teen_usa", "tail": "Ruth Zakarian", "source_type": "table", "source_id": "Miss Teen USA", "row_index": 0, "column_name": "Miss Teen USA", "header_path": ["Miss Teen USA"], "structural": true, "traversal_from": "table:Miss Teen USA:row:0", "traversal_to": "Ruth Zakarian", "direction": "forward"}, {"edge_id": "record:419", "head": "Ruth Zakarian", "relation": "linked_passage", "tail": "passage:/wiki/Ruth_Zakarian", "source_type": "table", "source_id": "Miss Teen USA", "row_index": 0, "column_name": "Miss Teen USA", "header_path": ["Miss Teen USA"], "structural": true, "contexts": [{"source_id": "/wiki/Ruth_Zakarian", "text": "Ruth Zakarian ( born February 6 , 1966 ) is an American actress and beauty queen who was the winner of the first ever Miss Teen USA pageant , held in 1983 in Lakeland , Florida . She went on to compete in Miss USA 1984 as Miss Teen USA 1983 .", "context_before": ""}], "traversal_from": "Ruth Zakarian", "traversal_to": "passage:/wiki/Ruth_Zakarian", "direction": "forward"}], "steps": [{"step": 1, "goal": "1983 --has_record--> table:Miss Teen USA:row:0", "depends_on": null}, {"step": 2, "goal": "table:Miss Teen USA:row:0 --miss_teen_usa--> Ruth Zakarian", "depends_on": 1}, {"step": 3, "goal": "Ruth Zakarian --linked_passage--> passage:/wiki/Ruth_Zakarian", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6923, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 15.5}}, {"path_id": "grounded_2367", "score": 10.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 2.0, "text_context_match": 1.0, "query_coverage": 1.4, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.35}, "nodes": ["/wiki/Miss_Teen_USA_1991", "1991", "Janel Bishop"], "edges": [{"edge_id": "semantic:85:0", "head": "1991", "relation": "linked_passage", "tail": "/wiki/Miss_Teen_USA_1991", "source_type": "table", "source_id": "Miss Teen USA", "source_group": null, "row_index": 8, "column_name": "Year", "header_path": ["Year"], "structural": false, "contexts": [{"source_id": "/wiki/Miss_Teen_USA_1991", "text": "Miss Teen USA 1991 , the 9th Miss Teen USA pageant , was televised live from the Mississippi Gulf Coast Coliseum in Biloxi , Mississippi on 19 August 1991 . At the conclusion of the final competition , Janel Bishop of New Hampshire was crowned by outgoing titleholder Bridgette Wilson of Oregon . Bishop is the first African American winner ever and the first titleholder from New Hampshire . The pageant was hosted by Dick Clark ( who last hosted it in 1988 and was already also hosting Miss USA & Miss Universe Pageants on CBS ) , with color commentary by Leeza Gibbons and Miss Teen USA 1985 Kelly Hu for the second time . Music was provided by the Gulf Coast Teen Orchestra . This was the second of five years that the pageant was held in Biloxi . After the city hosted Miss Teen USA 1990 , it entered negotiations with the Miss Universe company in October 1990 to host the pageant for a further four years , and an announcement to that effect was made in early November .", "context_before": ""}], "traversal_from": "/wiki/Miss_Teen_USA_1991", "traversal_to": "1991", "direction": "reverse"}, {"edge_id": "semantic:81:0", "head": "1991", "relation": "miss_teen_usa", "tail": "Janel Bishop", "source_type": "table", "source_id": "Miss Teen USA", "source_group": null, "row_index": 8, "column_name": "Miss Teen USA", "header_path": ["Miss Teen USA"], "structural": false, "contexts": [], "traversal_from": "1991", "traversal_to": "Janel Bishop", "direction": "forward"}], "steps": [{"step": 1, "goal": "1991 --linked_passage--> /wiki/Miss_Teen_USA_1991 [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "1991 --miss_teen_usa--> Janel Bishop", "depends_on": 1}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7692, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 15.05}}], "best_path_id": "row_11_99", "best_path_score": 11.7, "execution_mode": "path_text", "code_generated": false, "pro