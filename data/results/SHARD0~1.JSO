, 10, 11, 12, 13, 14], "constraint_policy": {"allowed_output_values": [], "require_table_evidence": false}}, "path_selection_audit": {"candidate_path_ids": ["grounded_362", "grounded_227", "row_8_108", "row_5_68", "grounded_321"], "qualified_path_ids": ["grounded_362", "grounded_227", "row_8_108", "row_5_68", "grounded_321"], "rejected_path_ids": [], "abstained_for_missing_grounding": false, "pre_answer_path_selection": false, "verification_by_path": {"grounded_362": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.4}, "grounded_227": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.8}, "row_8_108": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.4}, "row_5_68": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 15.15}, "grounded_321": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 14.75}}}, "reasoning_paths": [{"path_id": "grounded_362", "score": 12.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 0.75, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Richard_Benner", "Richard Benner", "table:List of LGBT-related films of 1977:row:8", "Outrageous !"], "edges": [{"edge_id": "record:503", "head": "Richard Benner", "relation": "linked_passage", "tail": "passage:/wiki/Richard_Benner", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Director", "header_path": ["Director"], "structural": true, "contexts": [{"source_id": "/wiki/Richard_Benner", "text": "Richard Benner ( 1943 - December 2 , 1990 ) was an American film director and screenwriter who worked predominantly in Canada . His 1977 film Outrageous ! was entered into the 28th Berlin International Film Festival , where Craig Russell won the Silver Bear for Best Actor . Benner , who grew up in Kentucky and studied drama in California and England , landed in Toronto in the early 1970s . Writing for the Canadian Broadcasting Corporation , he pitched an idea for a film about a gay hairdresser with dreams of New York City success to the Canadian Film Development Corporation ( now Telefilm Canada ) . Approved , he was able to secure financing with the help of Toronto producers , and Outrageous ! , the first film to feature Craig Russell , an openly gay cabaret performer , went on to critical success at the 1977 Cannes Film Festival . Funny and sympathetic , Outrageous ! is considered a landmark film in Canadian Queer cinema . Ten years later Benner talked Russell into doing a sequel ( 1987 ) , which fared not nearly as well . Benner died from complications due to AIDS in 1990 . In addition to his films , he directed several episodes of the Canadian television series 9B , Monsters , Street Legal and Road to Avonlea .", "context_before": ""}], "traversal_from": "passage:/wiki/Richard_Benner", "traversal_to": "Richard Benner", "direction": "reverse"}, {"edge_id": "record:200", "head": "table:List of LGBT-related films of 1977:row:8", "relation": "director", "tail": "Richard Benner", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Director", "header_path": ["Director"], "structural": true, "traversal_from": "Richard Benner", "traversal_to": "table:List of LGBT-related films of 1977:row:8", "direction": "reverse"}, {"edge_id": "record:195", "head": "Outrageous !", "relation": "has_record", "tail": "table:List of LGBT-related films of 1977:row:8", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "table:List of LGBT-related films of 1977:row:8", "traversal_to": "Outrageous !", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Richard Benner --linked_passage--> passage:/wiki/Richard_Benner [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of LGBT-related films of 1977:row:8 --director--> Richard Benner [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Outrageous ! --has_record--> table:List of LGBT-related films of 1977:row:8 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 17.4}}, {"path_id": "grounded_227", "score": 12.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 0.75, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Richard Benner", "table:List of LGBT-related films of 1977:row:8", "Outrageous !", "passage:/wiki/Outrageous!"], "edges": [{"edge_id": "record:200", "head": "table:List of LGBT-related films of 1977:row:8", "relation": "director", "tail": "Richard Benner", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Director", "header_path": ["Director"], "structural": true, "traversal_from": "Richard Benner", "traversal_to": "table:List of LGBT-related films of 1977:row:8", "direction": "reverse"}, {"edge_id": "record:195", "head": "Outrageous !", "relation": "has_record", "tail": "table:List of LGBT-related films of 1977:row:8", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "table:List of LGBT-related films of 1977:row:8", "traversal_to": "Outrageous !", "direction": "reverse"}, {"edge_id": "record:502", "head": "Outrageous !", "relation": "linked_passage", "tail": "passage:/wiki/Outrageous!", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Title", "header_path": ["Title"], "structural": true, "contexts": [{"source_id": "/wiki/Outrageous!", "text": "Outrageous ! is a 1977 Canadian comedy film . Directed and written by Richard Benner , the film stars Craig Russell as Robin Turner , a female impersonator , and Hollis McLaren as Liza Conners , Turner 's schizophrenic roommate . The film initially takes place in Toronto , Canada . The film is based on Making It , a short story by writer Margaret Gibson from her 1976 collection The Butterfly Ward ; Russell and Gibson were roommates in real life . Outrageous ! was one of the first gay-themed films ever to receive widespread theatrical release in North America . The film inspired the sequel Too Outrageous ! released in 1987 . A stage musical adaptation of the film was produced by Canadian Stage in 2000 .", "context_before": ""}], "traversal_from": "Outrageous !", "traversal_to": "passage:/wiki/Outrageous!", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of LGBT-related films of 1977:row:8 --director--> Richard Benner [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Outrageous ! --has_record--> table:List of LGBT-related films of 1977:row:8 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Outrageous ! --linked_passage--> passage:/wiki/Outrageous!", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.8}}, {"path_id": "row_8_108", "score": 12.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 0.75, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Outrageous !", "table:List of LGBT-related films of 1977:row:8", "Richard Benner", "passage:/wiki/Richard_Benner"], "edges": [{"edge_id": "record:195", "head": "Outrageous !", "relation": "has_record", "tail": "table:List of LGBT-related films of 1977:row:8", "source_type": "table", "source_id": "List of LGBT-related films of 1977", "row_index": 8, "column_name": "Title", "header_path": ["Title"], "structural": true, "traversal_from": "Outrageous !", "traversal_to": "table:List of LGBT-related films of 1977:row:8", "direction": "forward"}, {"edge_id": "record:200", "head": "table:List of LGBT-related f