_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1994", "table:List of films with associated hip hop songs:row:2", "Regulate", "passage:/wiki/Regulate_(song)"], "edges": [{"edge_id": "record:28", "head": "1994", "relation": "has_record", "tail": "table:List of films with associated hip hop songs:row:2", "source_type": "table", "source_id": "List of films with associated hip hop songs", "row_index": 2, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "1994", "traversal_to": "table:List of films with associated hip hop songs:row:2", "direction": "forward"}, {"edge_id": "record:36", "head": "table:List of films with associated hip hop songs:row:2", "relation": "song", "tail": "Regulate", "source_type": "table", "source_id": "List of films with associated hip hop songs", "row_index": 2, "column_name": "Song", "header_path": ["Song"], "structural": true, "traversal_from": "table:List of films with associated hip hop songs:row:2", "traversal_to": "Regulate", "direction": "forward"}, {"edge_id": "record:160", "head": "Regulate", "relation": "linked_passage", "tail": "passage:/wiki/Regulate_(song)", "source_type": "table", "source_id": "List of films with associated hip hop songs", "row_index": 2, "column_name": "Song", "header_path": ["Song"], "structural": true, "contexts": [{"source_id": "/wiki/Regulate_(song)", "text": "Regulate is a song performed by hip hop artists Warren G and Nate Dogg . It was released in the spring of 1994 as the first single on the soundtrack to the film Above the Rim and later Warren G. 's album Regulate.G Funk Era . It became an MTV staple and the song reached No . 2 on the Billboard Hot 100 and No . 8 on the R & B/Hip-Hop chart . It is considered the breakout single for both artists . [ citation needed ] The track makes heavy use of a four-bar sample of the rhythm of Michael McDonald 's song I Keep Forgettin ' ( Every Time You 're Near ) . It also samples Sign of the Times by Bob James and Let Me Ride by Dr. Dre . One mix of the song is referred to as I Keep Forgettin ' to Regulate , which often borrows heavily from the original track 's chorus . The song also starts with a read introduction referencing dialogue from the film Young Guns . The music video featured scenes from Above the Rim , including an appearance by Tupac Shakur . It was number 98 on VH1 's 100 Greatest Songs of Hip Hop and number 108 on Pitchfork Media 's Top 200 Tracks of the 90s .", "context_before": ""}], "traversal_from": "Regulate", "traversal_to": "passage:/wiki/Regulate_(song)", "direction": "forward"}], "steps": [{"step": 1, "goal": "1994 --has_record--> table:List of films with associated hip hop songs:row:2", "depends_on": null}, {"step": 2, "goal": "table:List of films with associated hip hop songs:row:2 --song--> Regulate", "depends_on": 1}, {"step": 3, "goal": "Regulate --linked_passage--> passage:/wiki/Regulate_(song)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5556, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 16.1334}}], "best_path_id": "grounded_65", "best_path_score": 12.3, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 10234, "llm_response_chars": 25, "llm_latency_ms": 52576.91, "wall_time_ms": 67432.69, "non_llm_time_ms": 14855.78, "input_tokens": null, "output_tokens": null, "exact_match": 0.0, "semantic_exact_match": 0.0, "f1": 0.13333333333333333, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": "judge_contract", "is_ambig