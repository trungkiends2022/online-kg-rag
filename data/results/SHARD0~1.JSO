dra Marinescu ( born 19 March 1982 ) is a retired Romanian Olympic artistic gymnast . She is an Olympic bronze medalist with the team and a two-time world champion with the team . Individually , she is a world silver medalist on beam and a seven-time Junior European medalist . She currently works as a minimal electro DJ based in Bucharest ."}], "traversal_from": "Olga Teslenko ( UKR )", "traversal_to": "passage:/wiki/Olga_Teslenko", "direction": "forward"}], "steps": [{"step": 1, "goal": "7 --has_record--> table:1997 World Artistic Gymnastics Championships:row:6", "depends_on": null}, {"step": 2, "goal": "table:1997 World Artistic Gymnastics Championships:row:6 --gymnast--> Olga Teslenko ( UKR )", "depends_on": 1}, {"step": 3, "goal": "Olga Teslenko ( UKR ) --linked_passage--> passage:/wiki/Olga_Teslenko", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.4091, "table_witness_indices": [0], "linked_witness": true, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 25.1382}}, {"path_id": "grounded_68", "score": 17.4882, "score_components": {"grounded_edges": 1.0, "query_entity_match": 2.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 0.5882, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 8.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.35}, "nodes": ["passage:/wiki/Olga_Teslenko", "Olga Teslenko ( UKR )", "table:1997 World Artistic Gymnastics Championships:row:6:cell:Gymnast"], "edges": [{"edge_id": "record:86", "head": "Olga Teslenko ( UKR )", "relation": "linked_passage", "tail": "passage:/wiki/Olga_Teslenko", "source_type": "table", "source_id": "1997 World Artistic Gymnastics Championships", "row_index"