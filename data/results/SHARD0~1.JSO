 Art Pepper .", "context_before": ""}], "traversal_from": "passage:/wiki/Lee_Konitz", "traversal_to": "Lee Konitz", "direction": "reverse"}, {"edge_id": "record:156", "head": "table:Allen Eager:row:9", "relation": "notes", "tail": "Lee Konitz", "source_type": "table", "source_id": "Allen Eager", "row_index": 9, "column_name": "Notes", "header_path": ["Notes"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Lee Konitz", "traversal_to": "table:Allen Eager:row:9", "direction": "reverse"}, {"edge_id": "record:141", "head": "1957", "relation": "has_record", "tail": "table:Allen Eager:row:9", "source_type": "table", "source_id": "Allen Eager", "row_index": 9, "column_name": "Year recorded", "header_path": ["Year recorded"], "structural": true, "traversal_from": "table:Allen Eager:row:9", "traversal_to": "1957", "direction": "reverse"}], "steps": [{"step": 1, "goal": "Lee Konitz --linked_passage--> passage:/wiki/Lee_Konitz [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:Allen Eager:row:9 --notes--> Lee Konitz [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "1957 --has_record--> table:Allen Eager:row:9 [traverse reverse]", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8182, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 13.8953}}, {"path_id": "row_9_47", "score": 9.3953, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.4286, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "no