ersal_from": "1952-53", "traversal_to": "table:List of Norwegian football champions:row:4", "direction": "forward"}, {"edge_id": "record:91", "head": "table:List of Norwegian football champions:row:4", "relation": "runners_up", "tail": "Skeid", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 4, "column_name": "Runners-up", "header_path": ["Runners-up"], "structural": true, "traversal_from": "table:List of Norwegian football champions:row:4", "traversal_to": "Skeid", "direction": "forward"}, {"edge_id": "record:326", "head": "Skeid", "relation": "linked_passage", "tail": "passage:/wiki/Skeid_Fotball", "source_type": "table", "source_id": "List of Norwegian football champions", "row_index": 4, "column_name": "Runners-up", "header_path": ["Runners-up"], "structural": true, "contexts": [{"source_id": "/wiki/Skeid_Fotball", "text": "Skeid is a Norwegian football club from Oslo that currently plays in 2. divisjon , the third tier of the Norwegian football league system . Its current home field is Nordre Åsen , after the club stopped playing at Bislett after the 2012 season . In past decades it has gained a reputation as a talent factory for the larger clubs in Norwegian football , and it has produced several players for the national team such as Daniel Braaten , Daniel Fredheim Holm , Omar Elabdellaoui and Mohammed Abdellaoue . Other notable players include Paul Miller . Skeid played in 1. divisjon in 2009 after a short stint in the 2. divisjon . They finished champions of the Second Group of 2. divisjon in 2008 . However , Skeid relegated again to 2. divisjon at end of 2009 season in 16th and last position despite a good start . In 2018 , Skeid won 2. divisjon group 1 and was promoted to the 1. divisjon . They played in the Norwegian top flight between 1938-1970 ( Norwegian League did n't play between 1940-1947 due to World War II ) , 1972-1975 ( 4 seasons ) , 1978-1980 ( 3 seasons ) , 1996-1997 ( 2 seasons ) . Their recent season in the top division was in the 1999 Tippeligaen .", "context_before": "SK Brann ( most often simply called Brann ) is a Norwegian professional football club , founded 26 September 1908 , from Bergen . Brann has been in the Eliteserien , Norway 's Premier Division of Football , since 1987 , bar one season spent in the 1. divisjon in 2015 . They play their home matches at Brann Stadion where they had a record-breaking 17,310 in average attendance in the 2007 season . In October 2007 , Brann won the Norwegian league title for the first time since 1963 . The 1952-1953 Hovedserien was the 8th completed season of top division football in Norway ."}], "traversal_from": "Skeid", "traversal_to": "passage:/wiki/Skeid_Fotball", "direction": "forward"}], "steps": [{"step": 1, "goal": "1952-53 --has_record--> table:List of Norwegian football champions:row:4", "depends_on": null}, {"step": 2, "goal": "table:List of Norwegian football champions:row:4 --runners_up--> Skeid", "depends_on": 1}, {"step": 3, "goal": "Skeid --linked_passage--> passage:/wiki/Skeid_Fotball", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.55}}, {"path_id": "grounded_378", "score": 16.55, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 0.75, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 8.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1952-53", "table:List of Norwegian football champions:row:4", "Skeid Fotball", "passage:/wiki/Skeid_Fotball"], "edges":