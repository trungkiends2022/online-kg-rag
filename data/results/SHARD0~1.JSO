: ["passage:/wiki/Chhattisgarh", "Chhattisgarh", "table:List of towns in India by population:row:0", "44,363"], "edges": [{"edge_id": "record:242", "head": "Chhattisgarh", "relation": "linked_passage", "tail": "passage:/wiki/Chhattisgarh", "source_type": "table", "source_id": "List of towns in India by population", "row_index": 0, "column_name": "State", "header_path": ["State"], "structural": true, "contexts": [{"source_id": "/wiki/Chhattisgarh", "text": "Chhattisgarh ( Chhattīsgaṛh , Hindi pronunciation : [ /ˈtʃʰət̪ːisgəɽʱ/ ] , translation : Thirty-Six Forts ) is one of the 28 states of India , located in the centre-east of the country . It is the ninth-largest state in India , with an area of 135,192 km2 ( 52,198 sq mi ) . With a 2011 population of 25.5 million , Chhattisgarh is the 16th-most populated state in the country . A resource-rich state , it is a source of electricity and steel for the country , accounting for 15% of the total steel produced as well as large contributor of coal . Chhattisgarh is one of the fastest-developing states in India . The state was formed on 1 November 2000 by partitioning ten Chhattisgarhi and six Gondi-speaking southeastern districts of Madhya Pradesh . The capital city is Raipur . Chhattisgarh borders the states of Madhya Pradesh in the northwest , Uttar Pradesh in the north , Jharkhand in northeast , Maharashtra in the southwest , Telangana and Andhra Pradesh in the south , and Odisha in the southeast . Currently the state comprises 30 districts . The Gross State Domestic Product ( GSDP ) of Chhattisgarh is ₹3.63 lakh crore ( US $ 51 billion ) and the per capita GSDP ₹102,762 ( US $ 1,400 )", "context_before": "Dalli-Rajhara is a town and a municipality in Balod district in the state of Chhattisgarh , India . Dalli Rajhara is home of iron ore captive mines for Bhilai Steel Plant , the largest integrated steel plant in India . Dalli mines deposit was discovered by Pramatha Nath Bose , the first Indian graded officer of the Geological Survey of India around 1900 ."}], "traversal_from": "passage:/wiki/Chhattisgarh", "traversal_to": "Chhattisgarh", "direction": "reverse"}, {"edge_id": "record:5", "head": "table:List of towns in India by population:row:0", "relation": "state", "tail": "Chhattisgarh", "source_type": "table", "source_id": "List of towns in India by population", "row_index": 0, "column_name": "State", "header_path": ["State"], "structural": true, "traversal_from": "Chhattisgarh", "traversal_to": "table:List of towns in India by population:row:0", "direction": "reverse"}, {"edge_id": "record:11", "head": "table:List of towns in India by population:row:0", "relation": "population_2011", "tail": "44,363", "source_type": "table", "source_id": "List of towns in India by population", "row_index": 0, "column_name": "Population ( 2011 )", "header_path": ["Population ( 2011 )"], "structural": true, "traversal_from": "table:List of towns in India by population:row:0", "traversal_to": "44,363", "direction": "forward"}], "steps": [{"step": 1, "goal": "Chhattisgarh --linked_passage--> passage:/wiki/Chhattisgarh [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of towns in India by population:row:0 --state--> Chhattisgarh [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:List of towns in India by population:row:0 --population_2011--> 44,363", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": false, "selection_score": 16.5667}}, {"path_id": "row_bridge_4_14", "score": 9.3667, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 0.5, "query_coverage": 0.4, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage"