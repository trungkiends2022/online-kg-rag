iki/Wolfgang_Petersen", "text": "Wolfgang Petersen ( born 14 March 1941 ) is a German film director , film producer and screenwriter . He was nominated for two Academy Awards for the World War II submarine warfare film Das Boot ( 1981 ) . His other films include The NeverEnding Story ( 1984 ) , Enemy Mine ( 1985 ) , In the Line of Fire ( 1993 ) , Outbreak ( 1995 ) , Air Force One ( 1997 ) , The Perfect Storm ( 2000 ) , Troy ( 2004 ) , and Poseidon ( 2006 ) .", "context_before": ""}], "traversal_from": "Wolfgang Petersen", "traversal_to": "passage:/wiki/Wolfgang_Petersen", "direction": "forward"}], "steps": [{"step": 1, "goal": "Air Force One --has_record--> table:List of American films of 1997:row:11", "depends_on": null}, {"step": 2, "goal": "table:List of American films of 1997:row:11 --director--> Wolfgang Petersen", "depends_on": 1}, {"step": 3, "goal": "Wolfgang Petersen --linked_passage--> passage:/wiki/Wolfgang_Petersen", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6364, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 14.1096}}, {"path_id": "grounded_438", "score": 9.4429, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.1429, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/Air_Force_One_(film)", "Air Force One", "table:List of American films of 1997:row:11", "table:List of American films of 1997:row:11:cell:Title"], "edges": [{"edge_id": "record:453", "head": "Air Force One", "relation": "linke