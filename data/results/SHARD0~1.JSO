ad": "18", "relation": "has_record", "tail": "table:List of National Historic Landmarks in Alabama:row:17", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 17, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "18", "traversal_to": "table:List of National Historic Landmarks in Alabama:row:17", "direction": "forward"}, {"edge_id": "record:485", "head": "table:List of National Historic Landmarks in Alabama:row:17", "relation": "location", "tail": "Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood )", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 17, "column_name": "Location", "header_path": ["Location"], "structural": true, "traversal_from": "table:List of National Historic Landmarks in Alabama:row:17", "traversal_to": "Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood )", "direction": "forward"}, {"edge_id": "record:854", "head": "Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood )", "relation": "linked_passage", "tail": "passage:/wiki/Demopolis,_Alabama", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 17, "column_name": "Location", "header_path": ["Location"], "structural": true, "contexts": [{"source_id": "/wiki/Demopolis,_Alabama", "text": "Demopolis is the largest city in Marengo County , Alabama , United States . Demopolis mayor is John Laney . The population was 7,483 at the time of the 2010 United States Census . The city lies at the confluence of the Black Warrior and Tombigbee rivers . It is situated atop a cliff composed of the Demopolis Chalk Formation , known locally as White Bluff , on the east bank of the Tombigbee River . It is at the center of Alabama 's Canebrake region and is also within the Black Belt . Demopolis was founded after the fall of Napoleon 's Empire and named by a group of French expatriates , a mix of exiled Bonapartists and other French migrants who had settled in the United States after the overthrow of the colonial government in Saint-Domingue following the failed Saint-Domingue expedition . The name , meaning in Greek the People 's City or City of the People ( from Ancient Greek δῆμος + πόλις ) , was chosen to honor the democratic ideals behind the endeavor . First settled in 1817 , it is one of the oldest continuous settlements in Alabama . It was incorporated on December 11 , 1821 .", "context_before": ""}], "traversal_from": "Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood )", "traversal_to": "passage:/wiki/Demopolis,_Alabama", "direction": "forward"}], "steps": [{"step": 1, "goal": "18 --has_record--> table:List of National Historic Landmarks in Alabama:row:17", "depends_on": null}, {"step": 2, "goal": "table:List of National Historic Landmarks in Alabama:row:17 --location--> Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood )", "depends_on": 1}, {"step": 3, "goal": "Demopolis 32°30′31″N 87°50′07″W / 32.508726°N 87.835239°W / 32.508726 ; -87.835239 ( Gaineswood ) --linked_passage--> passage:/wiki/Demopolis,_Alabama", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 10.9}}, {"path_id": "row_5_76", "score": 7.3, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.5, "query_coverage": 1.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["6", "table:List of National Historic Landmarks in Alabama:row:5", "Brown Chapel A.M.E. Church", "passage:/wiki/Brown_Chapel_A.M.E._Church_(Selma,_Alabama)"], "edges": [{"edge_id": "record:140", "head": "6", "relation": "has_record", "tail": "table:List of National Historic Landmarks in Alabama:row:5", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 5, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "6", "traversal_to": "table:List of National Historic Landmarks in Alabama:row:5", "direction": "forward"}, {"edge_id": "record:145", "head": "table:List of National Historic Landmarks in Alabama:row:5", "relation": "landmark_name", "tail": "Brown Chapel A.M.E. Church", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 5, "column_name": "Landmark name", "header_path": ["Landmark name"], "structural": true, "traversal_from": "table:List of National Historic Landmarks in Alabama:row:5", "traversal_to": "Brown Chapel A.M.E. Church", "direction": "forward"}, {"edge_id": "record:640", "head": "Brown Chapel A.M.E. Church", "relation": "linked_passage", "tail": "passage:/wiki/Brown_Chapel_A.M.E._Church_(Selma,_Alabama)", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 5, "column_name": "Landmark name", "header_path": ["Landmark name"], "structural": true, "contexts": [{"source_id": "/wiki/Brown_Chapel_A.M.E._Church_(Selma,_Alabama)", "text": "Brown Chapel A.M.E. Church is a church at 410 Martin Luther King Jr. Boulevard in Selma , Alabama , United States . This church was a starting point for the Selma to Montgomery marches in 1965 and , as the meeting place and offices of the Southern Christian Leadership Conference ( SCLC ) during the Selma Movement , played a major role in the events that led to the adoption of the Voting Rights Act of 1965 . The nation 's reaction to Selma 's Bloody Sunday march is widely credited with making the passage of the Voting Rights Act politically viable in the United States Congress . It was added to the Alabama Register of Landmarks and Heritage on June 16 , 1976 and later declared a National Historic Landmark on February 4 , 1982 .", "context_before": "The Tensaw River is a river in Baldwin County , Alabama . The name Tensaw is derived from the historic indigenous Taensa people . The Gulf Coast of the United States is the coastline along the Southern United States where they meet the Gulf of Mexico . The coastal states that have a shoreline on the Gulf of Mexico are Southeast Texas & South Texas , Louisiana , Mississippi , Alabama , and Florida , and these are known as the Gulf States . The economy of the Gulf Coast area is dominated by industries related to energy , petrochemicals , fishing , aerospace , agriculture , and tourism . The large cities of the region are ( from west to east ) McAllen , Brownsville , Corpus Christi , Houston , Galveston , Beaumont , Lafayette , Baton Rouge , New Orleans , Gulfport , Biloxi , Mobile , Pensacola , St. Petersburg , Tampa , and increasingly , Sarasota . All are the centers of their respective metropolitan areas and contain large ports . ( Baton Rouge is relatively far from the Gulf of Mexico ; its port is on the Mississippi River , as is the port of New Orleans . )"}], "traversal_from": "Brown Chapel A.M.E. Church", "traversal_to": "passage:/wiki/Brown_Chapel_A.M.E._Church_(Selma,_Alabama)", "direction": "forward"}], "steps": [{"step": 1, "goal": "6 --has_record--> table:List of National Historic Landmarks in Alabama:row:5", "depends_on": null}, {"step": 2, "goal": "table:List of National Historic Landmarks in Alabama:row:5 --landmark_name--> Brown Chapel A.M.E. Church", "depends_on": 1}, {"step": 3, "goal": "Brown Chapel A.M.E. Church --linked_passage--> passage:/wiki/Brown_Chapel_A.M.E._Church_(Selma,_Alabama)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.6667, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 10.9}}, {"path_id": "row_15_217", "score": 7.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 0.25, "query_coverage": 0.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["16", "table:List of National Historic Landmarks in Alabama:row:15", "Elmore", "passage:/wiki/Elmore_County,_Alabama"], "edges": [{"edge_id": "record:411", "head": "16", "relation": "has_record", "tail": "table:List of National Historic Landmarks in Alabama:row:15", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 15, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "16", "traversal_to": "table:List of National Historic Landmarks in Alabama:row:15", "direction": "forward"}, {"edge_id": "record:430", "head": "table:List of National Historic Landmarks in Alabama:row:15", "relation": "county", "tail": "Elmore", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 15, "column_name": "County", "header_path": ["County"], "structural": true, "traversal_from": "table:List of National Historic Landmarks in Alabama:row:15", "traversal_to": "Elmore", "direction": "forward"}, {"edge_id": "record:811", "head": "Elmore", "relation": "linked_passage", "tail": "passage:/wiki/Elmore_County,_Alabama", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 15, "column_name": "County", "header_path": ["County"], "structural": true, "contexts": [{"source_id": "/wiki/Elmore_County,_Alabama", "text": "Elmore County is a county of the State of Alabama . As of the 2010 census , the population was 79,303 . Its county seat is Wetumpka . Its name is in honor of General John A. Elmore . Elmore County is part of the Montgomery , AL Metropolitan Statistical Area .", "context_before": ""}], "traversal_from": "Elmore", "traversal_to": "passage:/wiki/Elmore_County,_Alabama", "direction": "forward"}], "steps": [{"step": 1, "goal": "16 --has_record--> table:List of National Historic Landmarks in Alabama:row:15", "depends_on": null}, {"step": 2, "goal": "table:List of National Historic Landmarks in Alabama:row:15 --county--> Elmore", "depends_on": 1}, {"step": 3, "goal": "Elmore --linked_passage--> passage:/wiki/Elmore_County,_Alabama", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 10.25}}, {"path_id": "row_1_16", "score": 7.05, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.0, "text_context_match": 0.25, "query_coverage": 0.5, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["2", "table:List of National Historic Landmarks in Alabama:row:1", "Creek people", "passage:/wiki/Creek_people"], "edges": [{"edge_id": "record:28", "head": "2", "relation": "has_record", "tail": "table:List of National Historic Landmarks in Alabama:row:1", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 1, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "2", "traversal_to": "table:List of National Historic Landmarks in Alabama:row:1", "direction": "forward"}, {"edge_id": "record:55", "head": "table:List of National Historic Landmarks in Alabama:row:1", "relation": "description", "tail": "Creek people", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 1, "column_name": "Description", "header_path": ["Description"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:List of National Historic Landmarks in Alabama:row:1", "traversal_to": "Creek people", "direction": "forward"}, {"edge_id": "record:587", "head": "Creek people", "relation": "linked_passage", "tail": "passage:/wiki/Creek_people", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 1, "column_name": "Description", "header_path": ["Description"], "structural": true, "derived_from_cell_split": true, "contexts": [{"source_id": "/wiki/Creek_people", "text": "The Muscogee , also known as the Muskogee , Muscogee Creek , Creek , Mvskokvlke , or the Muscogee Creek Confederacy ( pronounced [ məskógəlgi ] ) in the Muscogee language , are a related group of indigenous peoples of the Southeastern Woodlands . Their original homelands are in what now comprises southern Tennessee , all of Alabama , western Georgia and part of northern Florida . Like the Cherokees in northeastern Alabama , most of the Muscogee people were forcibly relocated from their original lands in the 1830s during the Trail of Tears to Indian Territory ( now Oklahoma ) . Some Muscogee fled European encroachment in 1797 and 1804 to establish two small tribal territories that continue to exist today in Louisiana and Texas . Another small branch of the Muscogee Creek Confederacy managed to remain in Alabama and is now known as the Poarch Band of Creek Indians . A large population of Muscogee people moved into Florida between roughly 1767 and 1821 and these people intermarried with local tribes to become the Seminole people , thereby establishing a separate identity from the Creek Confederacy . Muscogee people in these waves of migration into Florida were fleeing conflict and encroachment by European settlers . The great majority of Seminoles were also later forcibly relocated to Oklahoma , where they reside today , although the Seminole Tribe of Florida and Miccosukee Tribe of Indians of Florida remain in Florida . The respective languages of all of these modern day branches , bands and tribes , except one , are all closely related variants called Muscogee , Mvskoke and Hitchiti-Mikasuki , all of which belong to the Eastern Muskogean branch of the Muscogean language family . All of these languages are , for the most part , mutually intelligible . The Yuchi people today are part of the Muscogee ( Creek ) Nation but their Yuchi language is a linguistic isolate , unrelated to any other language . The ancestors of the Muscogee people were part of the Mississippian Ideological Interaction Sphere , who between AD 800 and AD 1600 built complex cities and surrounding networks of satellite towns ( suburbs ) centered around massive earthwork mounds , some of which had physical footprints larger than the Egyptian pyramids .", "context_before": ""}], "traversal_from": "Creek people", "traversal_to": "passage:/wiki/Creek_people", "direction": "forward"}], "steps": [{"step": 1, "goal": "2 --has_record--> table:List of National Historic Landmarks in Alabama:row:1", "depends_on": null}, {"step": 2, "goal": "table:List of National Historic Landmarks in Alabama:row:1 --description--> Creek people", "depends_on": 1}, {"step": 3, "goal": "Creek people --linked_passage--> passage:/wiki/Creek_people", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 10.25}}, {"path_id": "row_3_44", "score": 5.8, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.0, "text_context_match": 0.0, "query_coverage": 0.0, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["4", "table:List of National Historic Landmarks in Alabama:row:3", "Bethel Baptist Church , Parsonage , and Guard House", "passage:/wiki/Bethel_Baptist_Church_(Birmingham,_Alabama)"], "edges": [{"edge_id": "record:82", "head": "4", "relation": "has_record", "tail": "table:List of National Historic Landmarks in Alabama:row:3", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 3, "column_name": "column_0", "header_path": ["column_0"], "structural": true, "traversal_from": "4", "traversal_to": "table:List of National Historic Landmarks in Alabama:row:3", "direction": "forward"}, {"edge_id": "record:87", "head": "table:List of National Historic Landmarks in Alabama:row:3", "relation": "landmark_name", "tail": "Bethel Baptist Church , Parsonage , and Guard House", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 3, "column_name": "Landmark name", "header_path": ["Landmark name"], "structural": true, "traversal_from": "table:List of National Historic Landmarks in Alabama:row:3", "traversal_to": "Bethel Baptist Church , Parsonage , and Guard House", "direction": "forward"}, {"edge_id": "record:602", "head": "Bethel Baptist Church , Parsonage , and Guard House", "relation": "linked_passage", "tail": "passage:/wiki/Bethel_Baptist_Church_(Birmingham,_Alabama)", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 3, "column_name": "Landmark name", "header_path": ["Landmark name"], "structural": true, "contexts": [{"source_id": "/wiki/Bethel_Baptist_Church_(Birmingham,_Alabama)", "text": "Bethel Baptist Church is a historic church at 3200 28th Avenue North in the Collegeville neighborhood of Birmingham , Alabama . The church served as headquarters from 1956 to 1961 for the Alabama Christian Movement for Human Rights ( ACMHR ) , which was led by Fred Shuttlesworth and active in the Birmingham during the Civil Rights Movement . The ACMHR focused on legal and nonviolent direct action against segregated accommodations , transportation , schools and employment discrimination . It played a crucial role in the 1961 Freedom Ride that resulted in federal enforcement of U.S. Supreme Court and Interstate Commerce Commission rulings to desegregate public transportation . The church 's complex during the historic events of the 1950s and 1960s , located nearby on 29th Avenue North , was added to the Alabama Register of Landmarks and Heritage on November 13 , 1996 . It was then added to the National Register of Historic Places and declared a National Historic Landmark on April 5 , 2005 . On January 30 , 2008 , the US Government submitted it to UNESCO as part of an envisaged future World Heritage nomination ( along with the Dexter Avenue Baptist Church and the 16th Street Baptist Church ) and as such it is on the so-called UNESCO 'Tentative List of World Heritage Sites ' .", "context_before": "The Greek Revival was an architectural movement of the late 18th and early 19th centuries , predominantly in Northern Europe and the United States . It revived the style of ancient Greek architecture , in particular the Greek temple , with varying degrees of thoroughness and consistency . A product of Hellenism , it may be looked upon as the last phase in the development of Neoclassical architecture , which had for long mainly drawn from Roman architecture . The term was first used by Charles Robert Cockerell in a lecture he gave as Professor of Architecture to the Royal Academy of Arts , London in 1842 . With a newfound access to Greece , or initially the books produced by the few who had actually been able to visit the sites , archaeologist-architects of the period studied the Doric and Ionic orders . In each country it touched , the style was looked on as the expression of local nationalism and civic virtue , and freedom from the lax detail and frivolity that was thought to characterize the architecture of France and Italy , two countries where the style never really took hold . This was especially the case in Britain , Germany and the United States , where the idiom was regarded as being free from ecclesiastical and aristocratic associations . The taste for all things Greek in furniture and interior design , sometimes called Neo-Grec , was at its peak by the beginning of the 19th century , when the designs of Thomas Hope had influenced a number of decorative styles known variously as Neoclassical , Empire , Russian Empire , and Regency architecture in Britain . Greek Revival architecture took a different course in a number of countries , lasting until the Civil War in America ( 1860s ) and even later in Scotland . Plantation complexes in the Southern United States refers to the built environment ( or complex ) that was common on agricultural plantations in the American South from the 17th into the 20th century . The complex included everything from the main residence down to the pens for livestock . A plantation originally denoted a settlement in which settlers were planted to establish a colonial base . Southern plantations were generally self-sufficient settlements that relied on the forced labor of slaves , similar to the way that a medieval manorial estate relied upon the forced labor of serfs ."}], "traversal_from": "Bethel Baptist Church , Parsonage , and Guard House", "traversal_to": "passage:/wiki/Bethel_Baptist_Church_(Birmingham,_Alabama)", "direction": "forward"}], "steps": [{"step": 1, "goal": "4 --has_record--> table:List of National Historic Landmarks in Alabama:row:3", "depends_on": null}, {"step": 2, "goal": "table:List of National Historic Landmarks in Alabama:row:3 --landmark_name--> Bethel Baptist Church , Parsonage , and Guard House", "depends_on": 1}, {"step": 3, "goal": "Bethel Baptist Church , Parsonage , and Guard House --linked_passage--> passage:/wiki/Bethel_Baptist_Church_(Birmingham,_Alabama)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.3333, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 8.6}}, {"path_id": "answer_evidence_record_586", "score": 102.0, "score_components": {"reverse_answer_match": 102.0}, "nodes": ["Spain established this wattle and daub blockhouse on the Chattahoochee River in 1690 , attempting to maintain influence among the Lower Creek Indians . It was used for one year , and destroyed by the Spanish when they abandoned it", "passage:/wiki/Creek_people"], "edges": [{"edge_id": "record:586", "head": "Spain established this wattle and daub blockhouse on the Chattahoochee River in 1690 , attempting to maintain influence among the Lower Creek Indians . It was used for one year , and destroyed by the Spanish when they abandoned it", "relation": "linked_passage", "tail": "passage:/wiki/Creek_people", "source_type": "table", "source_id": "List of National Historic Landmarks in Alabama", "row_index": 1, "column_name": "Description", "header_path": ["Description"], "structural": true, "contexts": [{"source_id": "/wiki/Creek_people", "text": "The 