mn_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Coochbehar_Government_Medical_College_and_Hospital", "text": "Coochbehar Government Medical College and Hospital is a full-fledged tertiary referral Government Medical college . It was established in the year 2019 . The college imparts the degree Bachelor of Medicine and Surgery ( MBBS ) . Nursing and para-medical courses are also offered . The college is affiliated to West Bengal University of Health Sciences and is recognised by Medical Council of India . The hospital associated with the college is one of the largest hospitals in the Coochbehar . The selection to the college is done on the basis of merit through National Eligibility and Entrance Test . Yearly undergraduate student intake is 100 from the year 2019.The college has started its MBBS couse from 1st August 2019. .", "context_before": ""}], "traversal_from": "Coochbehar Government Medical College and Hospital", "traversal_to": "passage:/wiki/Coochbehar_Government_Medical_College_and_Hospital", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of institutions of higher education in West Bengal:row:5 --established--> 2019 [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Coochbehar Government Medical College and Hospital --has_record--> table:List of institutions of higher education in West Bengal:row:5 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Coochbehar Government Medical College and Hospital --linked_passage--> passage:/wiki/Coochbehar_Government_Medical_College_and_Hospital", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8182, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.2167}}, {"path_id": "grounded_1705", "score": 16.2167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_ma