s": [{"source_id": "/wiki/Fame_Gurukul", "text": "Fame Gurukul was an Indian reality show on Sony Entertainment Television ( India ) which premiered on 27 June 2005 . The program was produced by the same production house of Indian Idol . The concept of the show was to select a pair of India 's best singers/performers . It is based on the Spanish Operación Triunfo and international Star Academy format of Endemol , better known in English under the UK title Fame Academy ; in Indian terms , it was essentially a mixture of Indian Idol and Big Brother TV shows . Fame Gurukul started out with 16 contestants living in a musical performance academy ( Gurukul ) . Every week ( normally ) one contestant was voted out of the show , and so on until two will remained in the end .", "context_before": ""}], "traversal_from": "Fame Gurukul", "traversal_to": "passage:/wiki/Fame_Gurukul", "direction": "forward"}], "steps": [{"step": 1, "goal": "2005 --has_record--> table:Indian Television Academy Awards:row:0", "depends_on": null}, {"step": 2, "goal": "table:Indian Television Academy Awards:row:0 --show--> Fame Gurukul", "depends_on": 1}, {"step": 3, "goal": "Fame Gurukul --linked_passage--> passage:/wiki/Fame_Gurukul", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.5833, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 23.7167}}, {"path_id": "grounded_216", "score": 18.6056, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.6667, "text_context_match": 0.75, "query_coverage": 0.8889, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 5.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboratio