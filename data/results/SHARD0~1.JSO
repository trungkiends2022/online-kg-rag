.7647, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 19.6333}, "grounded_420": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 19.4833}, "grounded_416": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 18.4833}}}, "reasoning_paths": [{"path_id": "grounded_253", "score": 16.1333, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "table:List of United States Air Force Academy alumni:row:12", "Martha McSally", "passage:/wiki/Martha_McSally"], "edges": [{"edge_id": "record:181", "head": "table:List of United States Air Force Academy alumni:row:12", "relation": "notability", "tail": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "traversal_from": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot", "traversal_to": "table:List of United States Air Force Academy alumni:row:12", "direction": "reverse"}, {"edge_id": "record:173", "head": "Martha McSally", "relation": "has_record", "tail": "table:List of United States Air Force Academy alumni:row:12", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of United States Air Force Academy alumni:row:12", "traversal_to": "Martha McSally", "direction": "reverse"}, {"edge_id": "record:379", "head": "Martha McSally", "relation": "linked_passage", "tail": "passage:/wiki/Martha_McSally", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Martha_McSally", "text": "Martha Elizabeth McSally ( born March 22 , 1966 ) is a United States Air Force ( USAF ) combat veteran and politician serving as the junior United States Senator for Arizona . A Republican , she previously served as the U.S. Representative for Arizona 's 2nd congressional district . McSally served in the USAF from 1988 to 2010 and rose to the rank of colonel before retiring . One of the highest-ranking female pilots in the history of the Air Force , McSally was the first American woman to fly in combat following the 1991 lifting of the prohibition on female combat pilots . She was also the first female commander of a USAF fighter squadron ( the 354th Fighter Squadron ( 354 FS ) , based at Davis-Monthan Air Force Base ) . In 2001 , she sued the United States Department of Defense in McSally v. Rumsfeld , challenging the military policy that required United States and United Kingdom servicewomen stationed in Saudi Arabia to wear the body-covering abaya when traveling off base in the country . Following an unsuccessful congressional bid in 2012 , McSally was first elected to the U.S. House of Representatives in 2014 . She served two terms as the U.S. Representative for Arizona 's 2nd congressional district . McSally was the Republican nominee in Arizona 's 2018 U.S. Senate election , losing 50-48% to Democratic Congresswoman Kyrsten Sinema , while Democrat Ann Kirkpatrick won McSally 's seat in the House elections . Following that election , interim U.S . Senator Jon Kyl announced his resignation from the state 's other Senate seat , and Republican Governor Doug Ducey appointed McSally to succeed Kyl . There will be a special election coinciding with the 2020 general election to determine whether McSally will serve the remainder of the Class 3 senate term , likely pitting her against astronaut and political activist Mark Kelly .", "context_before": ""}], "traversal_from": "Martha McSally", "traversal_to": "passage:/wiki/Martha_McSally", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of United States Air Force Academy alumni:row:12 --notability--> Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate ; pilot ; Retired as a Colonel ( United States ) in May 2010 after serving 22 years as a Fairchild Republic A-10 Thunderbolt II pilot [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Martha McSally --has_record--> table:List of United States Air Force Academy alumni:row:12 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Martha McSally --linked_passage--> passage:/wiki/Martha_McSally", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.1333}}, {"path_id": "grounded_935", "score": 16.1333, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate", "table:List of United States Air Force Academy alumni:row:12", "Martha McSally", "passage:/wiki/Martha_McSally"], "edges": [{"edge_id": "record:182", "head": "table:List of United States Air Force Academy alumni:row:12", "relation": "notability", "tail": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate", "traversal_to": "table:List of United States Air Force Academy alumni:row:12", "direction": "reverse"}, {"edge_id": "record:173", "head": "Martha McSally", "relation": "has_record", "tail": "table:List of United States Air Force Academy alumni:row:12", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of United States Air Force Academy alumni:row:12", "traversal_to": "Martha McSally", "direction": "reverse"}, {"edge_id": "record:379", "head": "Martha McSally", "relation": "linked_passage", "tail": "passage:/wiki/Martha_McSally", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Martha_McSally", "text": "Martha Elizabeth McSally ( born March 22 , 1966 ) is a United States Air Force ( USAF ) combat veteran and politician serving as the junior United States Senator for Arizona . A Republican , she previously served as the U.S. Representative for Arizona 's 2nd congressional district . McSally served in the USAF from 1988 to 2010 and rose to the rank of colonel before retiring . One of the highest-ranking female pilots in the history of the Air Force , McSally was the first American woman to fly in combat following the 1991 lifting of the prohibition on female combat pilots . She was also the first female commander of a USAF fighter squadron ( the 354th Fighter Squadron ( 354 FS ) , based at Davis-Monthan Air Force Base ) . In 2001 , she sued the United States Department of Defense in McSally v. Rumsfeld , challenging the military policy that required United States and United Kingdom servicewomen stationed in Saudi Arabia to wear the body-covering abaya when traveling off base in the country . Following an unsuccessful congressional bid in 2012 , McSally was first elected to the U.S. House of Representatives in 2014 . She served two terms as the U.S. Representative for Arizona 's 2nd congressional district . McSally was the Republican nominee in Arizona 's 2018 U.S. Senate election , losing 50-48% to Democratic Congresswoman Kyrsten Sinema , while Democrat Ann Kirkpatrick won McSally 's seat in the House elections . Following that election , interim U.S . Senator Jon Kyl announced his resignation from the state 's other Senate seat , and Republican Governor Doug Ducey appointed McSally to succeed Kyl . There will be a special election coinciding with the 2020 general election to determine whether McSally will serve the remainder of the Class 3 senate term , likely pitting her against astronaut and political activist Mark Kelly .", "context_before": ""}], "traversal_from": "Martha McSally", "traversal_to": "passage:/wiki/Martha_McSally", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of United States Air Force Academy alumni:row:12 --notability--> Appointed to serve out remaining two years of late GOP Sen. John McCain 's term by Gov . Doug Ducey ( 2018- ) . Martha McSally is first U.S. Air Force Academy graduate to be appointed to U.S Senate [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "Martha McSally --has_record--> table:List of United States Air Force Academy alumni:row:12 [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "Martha McSally --linked_passage--> passage:/wiki/Martha_McSally", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8235, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 20.1333}}, {"path_id": "grounded_1339", "score": 15.6333, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.0, "relation_match": 0.0, "text_context_match": 1.0, "query_coverage": 1.3333, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 2.5, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["John McCain", "table:List of United States Air Force Academy alumni:row:12", "Martha McSally", "passage:/wiki/Martha_McSally"], "edges": [{"edge_id": "record:185", "head": "table:List of United States Air Force Academy alumni:row:12", "relation": "notability", "tail": "John McCain", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Notability", "header_path": ["Notability"], "structural": true, "derived_from_cell_split": true, "traversal_from": "John McCain", "traversal_to": "table:List of United States Air Force Academy alumni:row:12", "direction": "reverse"}, {"edge_id": "record:173", "head": "Martha McSally", "relation": "has_record", "tail": "table:List of United States Air Force Academy alumni:row:12", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "traversal_from": "table:List of United States Air Force Academy alumni:row:12", "traversal_to": "Martha McSally", "direction": "reverse"}, {"edge_id": "record:379", "head": "Martha McSally", "relation": "linked_passage", "tail": "passage:/wiki/Martha_McSally", "source_type": "table", "source_id": "List of United States Air Force Academy alumni", "row_index": 12, "column_name": "Name", "header_path": ["Name"], "structural": true, "contexts": [{"source_id": "/wiki/Martha_McSally", "text": "Martha Elizabeth McSally ( born March 22 , 1966 ) is a United States Air Force ( USAF ) combat veteran and politician serving as the junior United States Senator for Arizona . A Republican , she previously served as the U.S. Representative for Arizona 's 2nd congressional district . McSally served in the USAF from 1988 to 2010 and rose to the rank of colonel before retiring . One of the highest-ranking female pilots in the history of the Air Force , McSally was the first American woman to fly in combat following the 1991 lifting of the prohibition on female combat pilots . She was also the first female commander of a USAF fighter squadron ( the 354th Fighter Squadron ( 354 FS ) , based at Davis-Monthan Air Force Base ) . In 2001 , she sued the United States Department of Defense in McSally v. Rumsfeld , challenging the military policy that required United States and United Kingdom servicewomen stationed in Saudi Arabia to wear the body-covering abaya when traveling off base in the country . Following an unsuccessful congressional bid in 2012 , McSally was first elected to the U.S. House of Representatives in 2014 . She served two terms as the U.S. Representative for Arizona 's 2nd congressional district . McSally was the Republican nominee in Arizona 's 2018 U.S. Senate election , losing 50-48% to Democratic Congresswoman Kyrsten Sinema , while Democrat Ann Kirkpatrick won McSally 's seat in the House elections . Following that election , interim U.S . Senator Jon Kyl announced his resignation from the state 's other Senate seat , and Republican Governor Doug Ducey appointed McSally to succeed Kyl . There will be a special election coinciding with the 2020 general election to determine whether McSally will serve the remainder of the Class 3 senate term , likely pitting her against astronaut and political activist Mark Kelly .", "context_before": ""}], "traversal_from": "Martha McSally", "traversal_to": "passage:/wiki/Martha_McSally", "direction": "forward"}], "steps": [{"step": 1, "goal": "t