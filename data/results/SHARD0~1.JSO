], "steps": [{"step": 1, "goal": "Panchami --has_record--> table:Urvashi (actress):row:0", "depends_on": null}, {"step": 2, "goal": "table:Urvashi (actress):row:0 --channel--> Sun TV", "depends_on": 1}, {"step": 3, "goal": "Sun TV --linked_passage--> passage:/wiki/Sun_TV_(India)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.8571, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": true, "terminal_is_container": true, "selection_score": 14.1667}}, {"path_id": "row_14_59", "score": 8.4167, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.0, "relation_match": 0.6667, "text_context_match": 0.75, "query_coverage": 1.2, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 1.0, "row_entity_binding": 1.0, "numeric_literal_coverage": 0.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["2014", "table:Urvashi (actress):row:14", "Star Vijay", "passage:/wiki/Star_Vijay"], "edges": [{"edge_id": "record:206", "head": "2014", "relation": "has_record", "tail": "table:Urvashi (actress):row:14", "source_type": "table", "source_id": "Urvashi (actress)", "row_index": 14, "column_name": "Year", "header_path": ["Year"], "structural": true, "traversal_from": "2014", "traversal_to": "table:Urvashi (actress):row:14", "direction": "forward"}, {"edge_id": "record:214", "head": "table:Urvashi (actress):row:14", "relation": "channel", "tail": "Star Vijay", "source_type": "table", "source_id": "Urvashi (actress)", "row_index": 14, "column_name": "Channel", "header_path": ["Channel"], "structural": true, "traversal_from": "table:Urvashi (actress):row:14", "traversal_to": "Star Vijay", "direction": "forward"}, {"edge_id": "record:323", "head": "Star Vijay", "relation": "linked_passage", "tail":