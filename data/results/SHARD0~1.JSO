coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["John Cracroft Wilson", "table:3rd New Zealand Parliament:row:9", "City of Christchurch", "passage:/wiki/Christchurch_(New_Zealand_electorate)"], "edges": [{"edge_id": "record:138", "head": "John Cracroft Wilson", "relation": "has_record", "tail": "table:3rd New Zealand Parliament:row:9", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 9, "column_name": "Member", "header_path": ["Member"], "structural": true, "traversal_from": "John Cracroft Wilson", "traversal_to": "table:3rd New Zealand Parliament:row:9", "direction": "forward"}, {"edge_id": "record:143", "head": "table:3rd New Zealand Parliament:row:9", "relation": "electorate", "tail": "City of Christchurch", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 9, "column_name": "Electorate", "header_path": ["Electorate"], "structural": true, "traversal_from": "table:3rd New Zealand Parliament:row:9", "traversal_to": "City of Christchurch", "direction": "forward"}, {"edge_id": "record:333", "head": "City of Christchurch", "relation": "linked_passage", "tail": "passage:/wiki/Christchurch_(New_Zealand_electorate)", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 9, "column_name": "Electorate", "header_path": ["Electorate"], "structural": true, "contexts": [{"source_id": "/wiki/Christchurch_(New_Zealand_electorate)", "text": "Christchurch was a parliamentary electorate in Christchurch , New Zealand . It existed three times . Originally it was the Town of Christchurch from 1853 to 1860 . From the 1860-1861 election to the 1871 election , it existed as City of Christchurch . It then existed from the 1875-1876 election until the 1881 election . The last period was from the 1890 election to the 1905 election . Since the 1946 election , a similarly named electorate called Christchurch Central has been in existence . The historic electorate was represented by 21 members of parliament . For some of the time , it was represented by one member at a time . During other periods , it was one of the few three-member electorates in New Zealand .", "context_before": ""}], "traversal_from": "City of Christchurch", "traversal_to": "passage:/wiki/Christchurch_(New_Zealand_electorate)", "direction": "forward"}], "steps": [{"step": 1, "goal": "John Cracroft Wilson --has_record--> table:3rd New Zealand Parliament:row:9", "depends_on": null}, {"step": 2, "goal": "table:3rd New Zealand Parliament:row:9 --electorate--> City of Christchurch", "depends_on": 1}, {"step": 3, "goal": "City of Christchurch --linked_passage--> passage:/wiki/Christchurch_(New_Zealand_electorate)", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7692, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 17.8}}, {"path_id": "grounded_414", "score": 12.5223, "score_components": {"grounded_edges": 1.0, "query_entity_match": 1.5, "relation_match": 0.6667, "text_context_match": 1.0, "query_coverage": 1.5556, "single_venue_specificity": 0.0, "constraint_coverage": 0.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["First", "table:3rd New Zealand Parliament:row:9", "City of Christchurch", "/wiki/Christchurch_(New_Zealand_electorate)"], "edges": [{"edge_id": "record:150", "head": "table:3rd New Zealand Parliament:row:9", "relation": "mp_s_term", "tail": "First", "source_type": "table", "source_id": "3rd New Zealand Parliament", "row_index": 9, "column_name": "MP 's term", "header