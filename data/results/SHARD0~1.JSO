 "record:133", "head": "table:List of schools in the Perth metropolitan area:row:6", "relation": "opened", "tail": "1907", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "row_index": 6, "column_name": "Opened", "header_path": ["Opened"], "structural": true, "traversal_from": "1907", "traversal_to": "table:List of schools in the Perth metropolitan area:row:6", "direction": "reverse"}, {"edge_id": "record:122", "head": "table:List of schools in the Perth metropolitan area:row:6", "relation": "suburb", "tail": "Bickley", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "row_index": 6, "column_name": "Suburb", "header_path": ["Suburb"], "structural": true, "traversal_from": "table:List of schools in the Perth metropolitan area:row:6", "traversal_to": "Bickley", "direction": "forward"}, {"edge_id": "semantic:61:0", "head": "Bickley", "relation": "linked_passage", "tail": "/wiki/Bickley,_Western_Australia", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "source_group": null, "row_index": 6, "column_name": "Suburb", "header_path": ["Suburb"], "structural": false, "contexts": [{"source_id": "/wiki/Bickley,_Western_Australia", "text": "Bickley is a suburb located within the City of Kalamunda , in Perth , Western Australia . It is situated on the Darling Scarp and is known for the brook of the same name . Before 1949 it was a stopping place on the Upper Darling Range Railway . It was originally known as Heidelburg or Heidelberg , [ clarification needed ] but during World War I , Western Australian Government Railways and Tramways renamed it Bickley after a local pioneer Wallace Bickley . It has been the site of holiday and other sorts of camps . The Seven Network and Australian Broadcasting Corporation 's Perth Television transmission towers have been located there since the founding of television in Perth in 1959 . Perth Observatory , originally situated in West Perth is also currently located in Bickley . It is also one of the major meteorological stations within the Perth Metropolitan Area due to its length of time of operation and location on the Darling Scarp . It is also the location of water reservoirs", "context_before": "Byford is a suburb on the south-eastern edge of Perth , Australia , and has its origins in a township that was gazetted under the name Beenup in 1906 . Beenup , a corruption of the Aboriginal name associated with nearby Beenyup Brook , was the spelling that had been applied to a railway siding there . The uncorrupted form , Bienyup received mention in surveyor Robert Austin 's account of an expedition through the area in 1848 . In 1920 , the name of the township was changed to Byford . The Shire of Serpentine-Jarrahdale is a local government area in the outer southeastern metropolitan area of Perth , the capital of Western Australia , and has an area of 905 square kilometres ( 349 sq mi ) and a population of almost 27,000 as at the 2016 Census . The Shire 's seat of government is the town of Mundijong ."}], "traversal_from": "Bickley", "traversal_to": "/wiki/Bickley,_Western_Australia", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of schools in the Perth metropolitan area:row:6 --opened--> 1907 [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:List of schools in the Perth metropolitan area:row:6 --suburb--> Bickley", "depends_on": 1}, {"step": 3, "goal": "Bickley --linked_passage--> /wiki/Bickley,_Western_Australia", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.9, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": false, "selection_score": 18.3834}}, {"path_id": "grounded_589", "score": 13.3834, "score_components": {"grounded_edges": 1.0, "query_entity_match": 0.5, "relation_match": 0.6667, "text_context_match": 0.75, "query_coverage": 1.6667, "single_venue_specificity": 0.0, "constraint_coverage": 2.0, "cross_modal_completeness": 1.5, "row_context": 0.0, "row_entity_binding": 0.0, "numeric_literal_coverage": 4.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["1907", "table:List of schools in the Perth metropolitan area:row:6", "Bickley, Western Australia", "/wiki/Bickley,_Western_Australia"], "edges": [{"edge_id": "record:133", "head": "table:List of schools in the Perth metropolitan area:row:6", "relation": "opened", "tail": "1907", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "row_index": 6, "column_name": "Opened", "header_path": ["Opened"], "structural": true, "traversal_from": "1907", "traversal_to": "table:List of schools in the Perth metropolitan area:row:6", "direction": "reverse"}, {"edge_id": "record:123", "head": "table:List of schools in the Perth metropolitan area:row:6", "relation": "suburb", "tail": "Bickley, Western Australia", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "row_index": 6, "column_name": "Suburb", "header_path": ["Suburb"], "structural": true, "derived_from_cell_split": true, "traversal_from": "table:List of schools in the Perth metropolitan area:row:6", "traversal_to": "Bickley, Western Australia", "direction": "forward"}, {"edge_id": "semantic:200:0", "head": "Bickley, Western Australia", "relation": "linked_passage", "tail": "/wiki/Bickley,_Western_Australia", "source_type": "table", "source_id": "List of schools in the Perth metropolitan area", "source_group": null, "row_index": 6, "column_name": "Suburb", "header_path": ["Suburb"], "structural": false, "contexts": [{"source_id": "/wiki/Bickley,_Western_Australia", "text": "Bickley is a suburb located within the City of Kalamunda , in Perth , Western Australia . It is situated on the Darling Scarp and is known for the brook of the same name . Before 1949 it was a stopping place on the Upper Darling Range Railway . It was originally known as Heidelburg or Heidelberg , [ clarification needed ] but during World War I , Western Australian Government Railways and Tramways renamed it Bickley after a local pioneer Wallace Bickley . It has been the site of holiday and other sorts of camps . The Seven Network and Australian Broadcasting Corporation 's Perth Television transmission towers have been located there since the founding of television in Perth in 1959 . Perth Observatory , originally situated in West Perth is also currently located in Bickley . It is also one of the major meteorological stations within the Perth Metropolitan Area due to its length of time of operation and location on the Darling Scarp . It is also the location of water reservoirs", "context_before": "Byford is a suburb on the south-eastern edge of Perth , Australia , and has its origins in a township that was gazetted under the name Beenup in 1906 . Beenup , a corruption of the Aboriginal name associated with nearby Beenyup Brook , was the spelling that had been applied to a railway siding there . The uncorrupted form , Bienyup received mention in surveyor Robert Austin 's account of an expedition through the area in 1848 . In 1920 , the name of the township was changed to Byford . The Shire of Serpentine-Jarrahdale is a local government area in the outer southeastern metropolitan area of Perth , the capital of Western Australia , and has an area of 905 square kilometres ( 349 sq mi ) and a population of almost 27,000 as at the 2016 Census . The Shire 's seat of government is the town of Mundijong ."}], "traversal_from": "Bickley, Western Australia", "traversal_to": "/wiki/Bickley,_Western_Australia", "direction": "forward"}], "steps": [{"step": 1, "goal": "table:List of schools in the Perth metropolitan area:row:6 --opened--> 1907 [traverse reverse]", "depends_on": null}, {"step