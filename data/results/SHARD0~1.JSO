id Laurier Golden Hawks", "source_type": "table", "source_id": "U Sports women's ice hockey championship", "row_index": 8, "column_name": "Runner-up", "header_path": ["Runner-up"], "structural": true, "traversal_from": "table:U Sports women's ice hockey championship:row:8", "traversal_to": "Wilfrid Laurier Golden Hawks", "direction": "forward"}, {"edge_id": "record:393", "head": "Wilfrid Laurier Golden Hawks", "relation": "linked_passage", "tail": "passage:/wiki/Wilfrid_Laurier_Golden_Hawks_women's_ice_hockey", "source_type": "table", "source_id": "U Sports women's ice hockey championship", "row_index": 8, "column_name": "Runner-up", "header_path": ["Runner-up"], "structural": true, "contexts": [{"source_id": "/wiki/Wilfrid_Laurier_Golden_Hawks_women's_ice_hockey", "text": "The Wilfrid Laurier Golden Hawks women 's hockey team represents Wilfrid Laurier University in Canadian Interuniversity Sport . The Golden Hawks play their home games at Sunlife Financial Arena and are a member of the Ontario University Athletics conference .", "context_before": "The Regina Cougars are the athletic teams that represent the University of Regina in Regina , Saskatchewan , Canada . The Cougars compete in all sports except football ; the university 's football team is known as the Regina Rams . Recently a number of the Regina Cougar women 's ice hockey team were featured in the filming of the Canadian comedy television series , Road Hockey Rumble . The Calgary Dinos women 's ice hockey team represent the University of Calgary in the Canadian Interuniversity Sport ( CIS ) league . Former Olympic gold medallist Danielle Goyette was named head coach of the team in May 2007 , and continues in that role as of January 2017 ."}], "traversal_from": "Wilfrid Laurier Golden Hawks", "traversal_to": "passage:/wiki/Wilfrid_Laurier_Golden_Hawks_women's_ice_hockey", "direction": "forward"}], "steps": [{"step": 1, "goal": "2006 --has_record--> table:U Sports women's ice hockey championship:row:8", "