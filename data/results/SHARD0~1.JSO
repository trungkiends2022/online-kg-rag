ng": 0.0, "numeric_literal_coverage": 12.0, "strong_keyword_coverage": 0.0, "hyperlink_passage_bridge": 2.0, "table_witness_match": 0.0, "answer_type_path_filter": 0.0, "same_fact_corroboration": 0.0, "length_penalty": 0.7}, "nodes": ["passage:/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "USA Outdoor Track and Field Championships", "table:Will Claye:row:1", "table:Will Claye:row:1:cell:Event"], "edges": [{"edge_id": "record:415", "head": "USA Outdoor Track and Field Championships", "relation": "linked_passage", "tail": "passage:/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Competition", "header_path": ["Competition"], "structural": true, "contexts": [{"source_id": "/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "text": "The 2017 USA Track and Field Outdoor Championships were held at Hornet Stadium on the campus of California State University , Sacramento in Sacramento , California . Organized by USA Track & Field , the four-day competition took place June 22-25 and served as the national championships in track and field for the United States . The event was held in conjunction with the USA Track & Field Junior Outdoor Championships . The 50 kilometers race walk was held January 28 at Santee , California . While no men were able to make the 4:06 qualifying standard , two women were able to achieve their 4:30 qualifying time , with Katie Burnett walking faster than the second place man . The other qualifier was former world record holder Erin Taylor-Talcott . 2017 is the first year the women will be allowed to race that distance at the world championships .", "context_before": ""}], "traversal_from": "passage:/wiki/2017_USA_Outdoor_Track_and_Field_Championships", "traversal_to": "USA Outdoor Track and Field Championships", "direction": "reverse"}, {"edge_id": "record:26", "head": "table:Will Claye:row:1", "relation": "competition", "tail": "USA Outdoor Track and Field Championships", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Competition", "header_path": ["Competition"], "structural": true, "traversal_from": "USA Outdoor Track and Field Championships", "traversal_to": "table:Will Claye:row:1", "direction": "reverse"}, {"edge_id": "record:34", "head": "table:Will Claye:row:1", "relation": "event", "tail": "table:Will Claye:row:1:cell:Event", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Event", "header_path": ["Event"], "structural": true, "cell_node": true, "cell_value": "Triple jump", "traversal_from": "table:Will Claye:row:1", "traversal_to": "table:Will Claye:row:1:cell:Event", "direction": "forward"}], "steps": [{"step": 1, "goal": "USA Outdoor Track and Field Championships --linked_passage--> passage:/wiki/2017_USA_Outdoor_Track_and_Field_Championships [traverse reverse]", "depends_on": null}, {"step": 2, "goal": "table:Will Claye:row:1 --competition--> USA Outdoor Track and Field Championships [traverse reverse]", "depends_on": 1}, {"step": 3, "goal": "table:Will Claye:row:1 --event--> table:Will Claye:row:1:cell:Event", "depends_on": 2}], "path_verification": {"status": "qualified", "hard_failures": [], "question_term_coverage": 0.7778, "table_witness_indices": [], "linked_witness": false, "numeric_evidence": null, "terminal_is_container": true, "selection_score": 24.3}}, {"path_id": "answer_evidence_record_414", "score": 183.0, "score_components": {"reverse_answer_match": 183.0}, "nodes": ["Triple jump", "passage:/wiki/Triple_jump"], "edges": [{"edge_id": "record:414", "head": "Triple jump", "relation": "linked_passage", "tail": "passage:/wiki/Triple_jump", "source_type": "table", "source_id": "Will Claye", "row_index": 0, "column_name": "Event", "header_path": ["Event"], "structural": true, "contexts": [{"source_id": "/wiki/Triple_jump", "text": "The triple jump , sometimes referred to as the hop , step and jump or the hop , skip and jump , is a track and field event , similar to the long jump . As a group , the two events are referred to as the horizontal jumps . The competitor runs down the track and performs a hop , a bound and then a jump into the sand pit . The triple jump was inspired by the ancient Olympic Games and has been a modern Olympics event since the Games ' inception in 1896 . According to IAAF rules , the hop shall be made so that an athlete lands first on the same foot as that from which he has taken off ; in the step he shall land on the other foot , from which , subsequently , the jump is performed . The current male and female world record holders are Jonathan Edwards , with a jump of 18.29 m ( 60 ft 0.08 in ) , and Inessa Kravets of Ukraine , with a jump of 15.50 m ( 50 ft 10.24 in ) . Both records were set during 1995 World Championships in Gothenburg .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Triple jump --linked_passage--> passage:/wiki/Triple_jump", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 183.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_418", "score": 183.0, "score_components": {"reverse_answer_match": 183.0}, "nodes": ["Triple jump", "passage:/wiki/Triple_jump"], "edges": [{"edge_id": "record:418", "head": "Triple jump", "relation": "linked_passage", "tail": "passage:/wiki/Triple_jump", "source_type": "table", "source_id": "Will Claye", "row_index": 1, "column_name": "Event", "header_path": ["Event"], "structural": true, "contexts": [{"source_id": "/wiki/Triple_jump", "text": "The triple jump , sometimes referred to as the hop , step and jump or the hop , skip and jump , is a track and field event , similar to the long jump . As a group , the two events are referred to as the horizontal jumps . The competitor runs down the track and performs a hop , a bound and then a jump into the sand pit . The triple jump was inspired by the ancient Olympic Games and has been a modern Olympics event since the Games ' inception in 1896 . According to IAAF rules , the hop shall be made so that an athlete lands first on the same foot as that from which he has taken off ; in the step he shall land on the other foot , from which , subsequently , the jump is performed . The current male and female world record holders are Jonathan Edwards , with a jump of 18.29 m ( 60 ft 0.08 in ) , and Inessa Kravets of Ukraine , with a jump of 15.50 m ( 50 ft 10.24 in ) . Both records were set during 1995 World Championships in Gothenburg .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Triple jump --linked_passage--> passage:/wiki/Triple_jump", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 183.0, "hard_failures": []}, "created_after_answer": true}, {"path_id": "answer_evidence_record_426", "score": 183.0, "score_components": {"reverse_answer_match": 183.0}, "nodes": ["Triple jump", "passage:/wiki/Triple_jump"], "edges": [{"edge_id": "record:426", "head": "Triple jump", "relation": "linked_passage", "tail": "passage:/wiki/Triple_jump", "source_type": "table", "source_id": "Will Claye", "row_index": 3, "column_name": "Event", "header_path": ["Event"], "structural": true, "contexts": [{"source_id": "/wiki/Triple_jump", "text": "The triple jump , sometimes referred to as the hop , step and jump or the hop , skip and jump , is a track and field event , similar to the long jump . As a group , the two events are referred to as the horizontal jumps . The competitor runs down the track and performs a hop , a bound and then a jump into the sand pit . The triple jump was inspired by the ancient Olympic Games and has been a modern Olympics event since the Games ' inception in 1896 . According to IAAF rules , the hop shall be made so that an athlete lands first on the same foot as that from which he has taken off ; in the step he shall land on the other foot , from which , subsequently , the jump is performed . The current male and female world record holders are Jonathan Edwards , with a jump of 18.29 m ( 60 ft 0.08 in ) , and Inessa Kravets of Ukraine , with a jump of 15.50 m ( 50 ft 10.24 in ) . Both records were set during 1995 World Championships in Gothenburg .", "context_before": ""}]}], "steps": [{"step": 1, "goal": "Triple jump --linked_passage--> passage:/wiki/Triple_jump", "depends_on": null}], "path_verification": {"status": "answer_evidence", "selection_score": 183.0, "hard_failures": []}, "created_after_answer": true}], "best_path_id": "grounded_2509", "best_path_score": 21.1334, "execution_mode": "path_text", "code_generated": false, "program_executed": false, "text_extraction_mode": "direct_context_no_llm", "path_context_policy": "planner_top_n_paths_only", "top_n_paths": 5, "llm_calls": 1, "llm_api_attempts": 1, "llm_successful_calls": 1, "llm_failed_calls": 0, "llm_prompt_chars": 10682, "llm_response_chars": 11, "llm_latency_ms": 34053.37, "wall_time_ms": 68951.41, "non_llm_time_ms": 34898.04, "input_tokens": null, "output_tokens": null, "exact_match": 1.0, "semantic_exact_match": 1.0, "f1": 1.0, "execution_exact_match": null, "retrieval_audit": {"gold_row_recall": 1.0, "gold_hyperlink_recall": 1.0, "gold_passage_recall": 0.0}, "error_category": null, "is_ambiguous": null, "ambiguity_status": null}
