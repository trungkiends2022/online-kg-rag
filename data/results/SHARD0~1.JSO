s County", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "County", "header_path": ["County"], "structural": true, "derived_from_cell_split": true, "traversal_from": "Wufeng Tujia Autonomous County", "traversal_to": "table:Tujia people:row:18", "direction": "reverse"}, {"edge_id": "record:287", "head": "Hubei", "relation": "has_record", "tail": "table:Tujia people:row:18", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "Province", "header_path": ["Province"], "structural": true, "traversal_from": "table:Tujia people:row:18", "traversal_to": "Hubei", "direction": "reverse"}, {"edge_id": "record:387", "head": "Hubei", "relation": "linked_passage", "tail": "passage:/wiki/Hubei", "source_type": "table", "source_id": "Tujia people", "row_index": 18, "column_name": "Province", "header_path": ["Province"], "structural": true, "contexts": [{"source_id": "/wiki/Hubei", "text": "Hubei ( 湖北 ; formerly Hupeh ) is a landlocked province in Central China . The name of the province means north of the lake , referring to its position north of Dongting Lake . The provincial capital , Wuhan , serves as a major transportation hub and the political , cultural , and economic hub of Central China . Hubeis name is officially abbreviated to 鄂 ( È ) , an ancient name associated with the eastern part of the province since the State of E of the Western Zhou dynasty of c. 1045 - 771 BCE ; a popular name for Hubei is 楚 ( Chǔ ) ( suggested by that of the powerful State of Chu , which existed in the area during the Eastern Zhou dynasty of 770 - 256 BCE ) . The province borders Henan to the north , Anhui to the east , Jiangxi to the southeast , Hunan to the south , Chongqing to the west , and Shaanxi to the northwest . The high-profile Three Gorges Dam is located at Yichang , in the west of the province .", "context_before": ""}], "traversal_from": "Hubei", "traversal_to": "passage:/wiki/Hubei", "direction": "forward"}], "s