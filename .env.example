# Chọn provider: anthropic | openai | gemini | openai_compatible
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (GPT) ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-pro

# --- OpenAI-compatible (Ollama / vLLM / LM Studio / DeepSeek / Qwen / OpenRouter) ---
COMPAT_API_KEY=not-needed
COMPAT_BASE_URL=http://localhost:11434/v1
COMPAT_MODEL=llama3.1

# --- Nguồn khác (không đổi) ---
SERPAPI_KEY=your_key_here
