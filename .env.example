# Chọn provider: anthropic | openai | gemini | deepseek | openrouter | openai_compatible
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (GPT) ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-pro

# --- DeepSeek API chính thức ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY= value
DEEPSEEK_MODEL=deepseek-v4-flash

# --- OpenRouter ---
OPENROUTER_API_KEY=your_key_here
# Router miễn phí; có thể thay bằng model slug cụ thể dạng provider/model
OPENROUTER_MODEL=openrouter/free
# Hai trường attribution sau là tùy chọn
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Online KG RAG

# --- OpenAI-compatible (Ollama / vLLM / LM Studio / DeepSeek / Qwen / OpenRouter) ---
COMPAT_API_KEY=not-needed
COMPAT_BASE_URL=http://localhost:11434/v1
COMPAT_MODEL=llama3.1

# --- Log mỗi lần gọi LLM (JSON Lines, không ghi prompt/response mặc định) ---
LLM_LOG_ENABLED=false
LLM_LOG_PATH=logs/llm_calls.jsonl
# Chỉ bật nếu chấp nhận lưu nội dung có thể chứa dữ liệu nhạy cảm
LLM_LOG_CONTENT=false

# --- Nguồn khác (không đổi) ---
SERPAPI_KEY=your_key_here
