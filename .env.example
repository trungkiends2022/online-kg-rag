# Active provider: anthropic | openai | gemini | deepseek | groq |
#                  nvidia_nim | openrouter | openai_compatible
LLM_PROVIDER=gemini

# Shared reliability settings
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_SDK_MAX_RETRIES=2
LLM_RATE_LIMIT_RETRIES=3
LLM_MIN_REQUEST_INTERVAL_SECONDS=0
# Free-tier Gemini commonly needs pacing for multi-call pipelines.
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=12

# Anthropic
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=your_model_here

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=your_model_here

# Google Gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Official DeepSeek API
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=your_model_here

# Groq
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA hosted NIM
NVIDIA_API_KEY=your_key_here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenRouter
OPENROUTER_API_KEY=your_key_here
# Example: DeepSeek V4 Flash via OpenRouter.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Set true only for models that support OpenRouter reasoning.
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Online KG RAG

# Local/internal OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.)
COMPAT_API_KEY=not-needed
COMPAT_BASE_URL=http://localhost:11434/v1
COMPAT_MODEL=llama3.1

# LLM call logs. Prompt/response content is disabled by default.
LLM_LOG_ENABLED=false
LLM_LOG_PATH=logs/llm_calls.jsonl
LLM_LOG_CONTENT=false

# Optional web retrieval
SERPAPI_KEY=your_key_here
